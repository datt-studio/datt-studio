# Copy to .env and fill in values from your Sanity project
SANITY_PROJECT_ID=xxxxxx
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
SANITY_TOKEN=

# GA4 article view counts (build time, optional)
# Property ID defaults to 523773273 if not set.
GA4_PROPERTY_ID=523773273
# Base64-encoded Google service account JSON key. Generate with:
#   base64 -i /path/to/service-account.json | tr -d '\n'
GA4_SERVICE_ACCOUNT_JSON=
# Alternative: absolute path to the service account JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=
