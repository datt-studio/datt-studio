---
// Layout.astro
import { ViewTransitions } from 'astro:transitions';
import CookieBanner from '../components/CookieBanner.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';


interface Props {
  title?: string;
  description?: string;
  isDark?: boolean;
  robots?: string;
}


const {
  title = "DATT STUDIO",
  description = "DATT STUDIO is a creative studio for brands built to last. Identity, systems, and digital work made to hold.",
  isDark = false,
  robots = "index, follow",
} = Astro.props;


const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

/* Per-line reveal. Now enabled on every page in every build: each hand-authored
   mask is split into its real rendered lines and the lines stagger, instead of
   the whole block arriving as one piece. The localStorage override in the
   script below still wins, so a single page can be turned off while comparing. */
const lineSplit = true;
const canonicalUrl = `https://dattstudio.com${canonicalPath}`;
const ogImage = "https://dattstudio.com/assets/video-poster-retina.jpg";


// === JSON-LD: ORGANIZATION SCHEMA ===
// Update these with your real profile URLs (one per line, quoted). Leave empty to omit sameAs.
const socialLinks = [
  "https://uk.linkedin.com/company/dattstudio",
  "https://find-and-update.company-information.service.gov.uk/company/16695845",
  "https://www.csswinner.com/details/datt-studio/19434",
  "https://www.cssdesignawards.com/sites/datt-studio/50228/",
  "https://thefwa.com/cases/datt-studio",
].filter(Boolean);

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://dattstudio.com/#organization",
  "name": "DATT STUDIO",
  "legalName": "DATT STUDIO LTD",
  "url": "https://dattstudio.com/",
  "logo": "https://dattstudio.com/assets/datt-logo-512.png",
  "description": "A creative studio for brands built to last. Identity, systems, and digital work made to hold.",
  "foundingDate": "2025-09-04",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "94 Repton Close",
    "addressLocality": "Luton",
    "postalCode": "LU3 3UP",
    "addressCountry": "GB",
  },
  "sameAs": socialLinks,
};

// === JSON-LD: WEBSITE SCHEMA ===
// Site-wide so Google can attach the site name ("DATT STUDIO") to the domain
// in search results. Linked to the Organization node by @id.
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://dattstudio.com/#website",
  "name": "DATT STUDIO",
  "url": "https://dattstudio.com/",
  "publisher": { "@id": "https://dattstudio.com/#organization" },
};

// === JSON-LD: VIDEO SCHEMA ===
// Homepage only: it is the sole page that embeds the reel, and the schema must
// describe the video on the page that plays it. width/height omitted rather than guessed.
const showVideoLd = Astro.url.pathname === '/';

const videoLd = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "DATT Studio — 2026 Showreel",
  "description": "Showreel from DATT STUDIO, a creative studio for brands built to last. Identity, systems, and digital work made to hold.",
  "thumbnailUrl": "https://dattstudio.com/assets/video-poster-retina.jpg",
  "uploadDate": "2026-09-22T17:11:08+00:00",
  "duration": "PT1M0S",
  "contentUrl": "https://dattstudio.com/assets/DATT_STUDIO_REEL_2026.mp4",
  "embedUrl": "https://dattstudio.com/",
  "width": 1280,
  "height": 720,
  "publisher": {
    "@type": "Organization",
    "name": "DATT STUDIO",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dattstudio.com/assets/datt-logo-512.png",
    },
  },
};
---
<!doctype html>
<html lang="en" class:list={[{ "page-dark": isDark }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#000000" />
    <meta name="author" content="DATT STUDIO" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />


    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DATT STUDIO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="DATT STUDIO" />


    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />


    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/inter-core.woff2" as="font" type="font/woff2" crossorigin />


    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {showVideoLd && <script type="application/ld+json" set:html={JSON.stringify(videoLd)} />}


    <GoogleAnalytics id="G-MC1VNLCG74" />
    <ViewTransitions />


    <!-- MOTION PREFERENCE -->
    <script is:inline>
      function applyMotionSettings() {
        const isReduced = localStorage.getItem('datt_studio_reduced_motion') === 'true';
        if (isReduced) {
          document.documentElement.classList.add('user-reduced-motion');
        } else {
          document.documentElement.classList.remove('user-reduced-motion');
        }
      }
      applyMotionSettings();
      document.addEventListener('astro:after-swap', applyMotionSettings);
    </script>


    <style is:global>
      /* SELF-HOSTED INTER (VARIABLE, GLYPH-SUBSET) */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-core.woff2') format('woff2');
        unicode-range: U+0020-007E, U+00A0-00AC, U+00AE-00FF, U+2013-2014, U+2018-201A,
          U+201C-201E, U+2022, U+2026, U+20AC, U+2122;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-ext.woff2') format('woff2');
        unicode-range: U+0110-0111, U+0300-0301, U+0303-0304, U+0308-0309, U+0323,
          U+1EA0-1EF9;
      }


      :root {
        --ease-mechanical: cubic-bezier(0.8, 0, 0.1, 1);
        --page-padding: clamp(16px, 5vw, 24px);
        --studio-grey: #B4B4B4;


        /* TYPE SYSTEM */
        --font-h1: clamp(38px, 9vw, 72px);
        --font-h2: clamp(36px, 6vw, 56px);
        --font-h3: clamp(24px, 4vw, 32px);
        --font-h4: clamp(18px, 3vw, 22px);
        --font-body: 16px;
        --font-label: clamp(12px, 2vw, 14px);


        --track-tighter: -0.03em;
        --track-tight: -0.015em;
        --track-wide: 0.08em;
        --lh-xtight: 1.05;
        --lh-tight: 1.2;
        --lh-body: 1.4;
      }

      /* TABLET TYPE SCALE (768-1023px)
         The display clamps are tuned for phones and large desktops. On a tablet
         the 9vw curve lands within a few pixels of the 72px desktop cap, which
         turns long statements into a wall of near-desktop type. A dedicated
         step for the tablet range keeps headlines readable without touching the
         phone scale (below 768) or the desktop scale (1024 and up). */
      @media (min-width: 768px) and (max-width: 1023px) {
        :root {
          --font-h1: clamp(46px, 6.6vw, 60px);
          --font-h2: clamp(34px, 4.8vw, 44px);
          --font-h3: clamp(24px, 3.4vw, 30px);
        }
      }


      /* --- GLOBAL SELECTION COLOURS --- */
      ::selection {
        background-color: #FAFAFA;
        color: #131313;
        -webkit-text-fill-color: #131313; /* Ensures override on some mobile browsers */
      }


      /* Firefox support */
      ::-moz-selection {
        background-color: var(--studio-grey);
        color: #131313;
      }


      /* --- ATOMIC MOTION KILL-SWITCH --- */
      html.user-reduced-motion,
      html.user-reduced-motion *,
      html.user-reduced-motion *::after,
      html.user-reduced-motion *::before {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }


      * { margin: 0; padding: 0; box-sizing: border-box; -webkit-font-smoothing: antialiased; }
      html { background: #FAFAFA; overflow-anchor: none; }
      body {
        background: #FAFAFA; color: #131313; font-family: 'Inter', sans-serif;
        font-feature-settings: 'ss01' on, 'ss02' on, 'cv01' on, 'cv11' on, 'calt' on;
        overflow-x: hidden;
      }
      html.page-dark, body.page-dark { background-color: #000000 !important; color-scheme: dark; }


      /* GLOBAL TYPOGRAPHY */
      h1, h2 { font-weight: 600; line-height: var(--lh-xtight); letter-spacing: var(--track-tighter); }
      h1 { font-size: var(--font-h1); } h2 { font-size: var(--font-h2); }
      h3, h4 { font-weight: 500; line-height: var(--lh-tight); letter-spacing: var(--track-tight); }
      p { font-size: clamp(18px, 3vw, 16px); font-weight: 400; line-height: var(--lh-body); letter-spacing: var(--track-tight); }
      .text-label { font-size: var(--font-label); font-weight: 600; text-transform: uppercase; letter-spacing: var(--track-wide); line-height: var(--lh-body); }

      /* SITE-WIDE COPY SETTING
         Body text takes a pretty final line, so a single word is never stranded
         on a line of its own and a paragraph does not end in a wide gap. No word
         is added or removed. `pretty` is progressive: a browser without it falls
         back to normal wrapping, so nothing regresses. */
      p, li, dd, dt, blockquote, figcaption { text-wrap: pretty; }
      h1, h2, h3, h4 { text-wrap: balance; }


      /* GLOBAL REVEAL ENGINE */
      .brands-line-mask {
        display: block; overflow: hidden; perspective: 1200px;
        padding-top: 0.2em; padding-bottom: 0.2em; margin-top: -0.2em; margin-bottom: -0.2em;
      }
      .brands-line-inner {
        display: block; transform: translateY(115%) rotateX(-60deg); transform-origin: top center; opacity: 0;
        transition: transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical);
        will-change: transform, opacity; backface-visibility: hidden;
      }
      .is-active .brands-line-inner, .is-active.brands-line-inner {
        transform: translateY(0) rotateX(0deg) !important; opacity: 1 !important;
      }


      /* PER-LINE SPLIT (opt-in: body[data-linesplit="on"])

         The engine above reveals one hand-authored mask per element, so a
         paragraph arrives as a single block. When this is enabled each mask is
         additionally split into its real rendered lines, one mask per line, and
         the masks are staggered. transform-box is set so the rotateX on a
         per-line mask pivots on that line rather than the whole paragraph.

         Line breaks are a function of font metrics and viewport width, so the
         split is measured at runtime and redone on resize and on font load.
         Without JS, or with reduced motion, nothing is split and the base
         engine above applies unchanged. */
      body[data-linesplit="on"] .ls-mask > .brands-line-inner {
        transform-box: fill-box;
        transform-origin: top center;
      }
      /* A mask produced by the split carries its own index for the stagger.
         The bleed padding gives the flip room so glyphs never clip, but that
         padding sits inside every mask and would otherwise add both paddings'
         worth of lead between stacked lines, so a split heading drifts from its
         authored line-height. The adjacent rule cancels the padding exactly:
         with a bottom margin of -bleed the next mask's top margin of -2 x bleed
         collapses to -2 x bleed, and padding + margin + padding sums to zero. */
      /* These are forced because a component styles `.brands-line-mask` with an
         id-scoped selector (`#philosophy-section .brands-line-mask`), and an id
         outranks this rule. Without the force the `+` cancel is dropped and
         every generated line keeps one bleed of extra lead, so a split heading
         on those pages drifts below its authored line-height. Forcing padding
         and margin together keeps the sum at zero whatever the component sets. */
      body[data-linesplit="on"] .ls-mask {
        display: block !important;
        padding-top: var(--ls-bleed, 0.2em) !important;
        padding-bottom: var(--ls-bleed, 0.2em) !important;
        margin-top: calc(-1 * var(--ls-bleed, 0.2em)) !important;
        margin-bottom: calc(-1 * var(--ls-bleed, 0.2em)) !important;
      }
      body[data-linesplit="on"] .ls-mask + .ls-mask {
        margin-top: calc(-2 * var(--ls-bleed, 0.2em)) !important;
      }

      /* Base delay for a block, so two headings in sequence cascade instead of
         starting together. Read by the splitter and added to each line's step. */
      .ls-base-03 { --ls-base: 0.3s; }

      /* The element that was split stops being animated itself.
         The generated per-line masks are nested inside it, so if the original
         inner kept its closed transform the whole block would travel 115% down
         while each line inside it did the same again, doubling the offset and
         the rotation. That reads as a slide with a flicker rather than a
         line-by-line flip. Neutralising the container leaves the per-line
         masks as the only animated units. Equal specificity to
         .is-active .brands-line-inner, but declared later, so it wins. */
      body[data-linesplit="on"] .brands-line-inner.ls-split-host {
        transform: none !important;
        opacity: 1 !important;
        transition: none !important;
        will-change: auto;
      }

      /* Measurement state. The closed mask is translateY + rotateX under a
         perspective, and getClientRects returns rects in that transformed
         space, so line tops are distorted non-uniformly and cannot be compared
         to find line boundaries. The splitter flips this on for the duration of
         the measure pass, then removes it. Deliberately display:inline-block and
         not a mask, so the box stays tight to the text and nothing shifts. */
      body[data-linesplit="on"] .ls-measuring {
        transform: none !important;
        opacity: 1 !important;
        transition: none !important;
      }

      /* The reduced-motion toggle on /accessibility/ zeroes transition-duration
         but leaves the closed mask's transform and opacity in place, which would
         hide the text outright. When motion is off, per-line masks are skipped
         entirely, so the base engine's own state applies and the copy stays
         visible. The !important on visibility is what outranks the closed
         transform, which is declared later in the cascade. */
      html.user-reduced-motion body[data-linesplit="on"] .brands-line-inner {
        transform: none !important;
        opacity: 1 !important;
        transition: none !important;
      }
      html.user-reduced-motion .ls-mask { display: contents !important; }
      @media (prefers-reduced-motion: reduce) {
        body[data-linesplit="on"] .brands-line-inner {
          transform: none !important; transition: none !important; opacity: 1 !important;
        }
      }


      /* GLOBAL CTA SYSTEM */
      .cta-link {
        display: inline-block; position: relative; text-decoration: none !important;
        color: currentColor; font-size: var(--font-label); font-weight: 600;
        text-transform: uppercase; letter-spacing: var(--track-wide); padding-bottom: 4px;
        transition: color 0.4s var(--ease-mechanical);
      }
      .cta-link::after {
        content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 1.5px;
        background: currentColor; transform: scaleX(1); transform-origin: left;
        transition: transform 0.6s var(--ease-mechanical);
      }
      .cta-link:hover::after { animation: global-underline-flow 0.8s var(--ease-mechanical) forwards; }


      @keyframes global-underline-flow {
        0% { transform: scaleX(1); transform-origin: right; }
        45% { transform: scaleX(0); transform-origin: right; }
        50% { transform: scaleX(0); transform-origin: left; }
        100% { transform: scaleX(1); transform-origin: left; }
      }


      /* Header Coloring Logic */
      body:not([data-page-type="immersive"]):not(.page-dark) #main-header .nav-logo,
      body:not([data-page-type="immersive"]):not(.page-dark) #main-header .desktop-nav-link,
      body:not([data-page-type="immersive"]):not(.page-dark) #main-header #menu-toggle { color: #000 !important; }

      /* LEGAL PAGES: the sidebar links start under the NEWS item in the top nav.
         The nav gaps are fluid, so the offset is measured in the script below. */
      @media (min-width: 1024px) {
        #main-content .legal-sidebar { padding-left: var(--legal-sidebar-left, 5rem); }
      }
    </style>
  </head>
  <body class:list={[{ "page-dark": isDark }]} data-linesplit={lineSplit ? 'on' : undefined}>
    <slot />
    <CookieBanner />


    <script is:inline>
      function initUniversalReveal() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-active');
              entry.target.querySelectorAll('.brands-line-mask').forEach(m => m.classList.add('is-active'));
            }
          });

          /* The trigger is anchored to the viewport, not to a fraction of the
             element.

             A threshold is a proportion of the *target*, so it silently couples
             when a block reveals to how tall that block happens to be. An
             element more than ten viewports tall can never satisfy a threshold
             of 0.1 — it needs a tenth of itself on screen at once — and so never
             reveals at all: the article hero is 8,768px on a phone, where a
             844px viewport is 9.6% of it, which is just short of the mark. The
             cover stayed frozen at rotateX(-60deg) for the whole page.

             Threshold zero with a bottom margin asks the question that was
             actually meant: has the top of this block reached the reader's line.
             And for the blocks that made up most of the site it lands in almost
             exactly the same place as before — a full-height section on a phone
             needed 84px of itself visible, which is the same moment its top
             passes 90% down the viewport, and that is what -10% asks for. Short
             blocks now reveal a few pixels earlier and tall ones no longer fail
             to reveal, which is the direction the inconsistency wanted to go. */
        }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
        document.querySelectorAll('section, footer, .reveal-trigger').forEach(el => observer.observe(el));
      }


      /* PER-LINE SPLIT

         Measures the real rendered line boxes of a heading or paragraph with
         Range.getClientRects(), then replaces the single hand-authored mask with
         one mask per line, each carrying its own stagger delay.

         Two details that matter. Measurement happens before any mutation, so
         reading client rects never interleaves with writes. And the source HTML
         is stashed on first pass, so a resize can un-split and re-measure from
         the original rather than compounding wrappers on wrappers.

         This is inert unless the body carries data-linesplit="on". */
      const LS_STEP = 0.1;

      /* Base delay comes from a custom property so a component can hold a block
         back without hardcoding a delay into every generated line. */
      function lsBase(el) {
        const raw = getComputedStyle(el).getPropertyValue('--ls-base').trim();
        if (!raw) return 0;
        const n = parseFloat(raw);
        return Number.isFinite(n) ? n : 0;
      }

      function lsShouldSkip(el) {
        // Anything that is not flowing text, or that already sits inside a
        // split, must be left exactly as the base engine authored it.
        if (el.closest('.ls-mask')) return true;
        if (el.querySelector('img, video, iframe, svg, canvas, table, .brands-line-mask, .clock-instance')) return true;

        // Article prose is split like the rest of the site. Its blocks reveal on
        // their own scroll trigger (.prose-in), not the section-wide .is-active,
        // and the article stylesheet keeps the generated line masks closed until
        // their block enters. See news/[...slug].astro.

        // The hero binds a mouseenter handler to .trigger-line on its own
        // "Made to hold." segment, and .has-trigger carries the underline and
        // hover rules this script wrote onto a specific element. That segment
        // must stay exactly as authored, so it is kept out of the split. The
        // other hero segments are plain single-line text and go through the
        // shared splitter like every other component on the site.
        if (el.closest('.headline-line.has-trigger')) return true;

        return false;
      }

      /* Collect the elements that actually hold text, in document order.
         A mask's inner is often a wrapper holding a heading and a paragraph, as
         on the legal pages, so requiring a single child would skip most of
         them. Instead every leaf that owns text is collected and split
         individually, and the line index runs continuously across the whole
         mask so the cascade reads top to bottom. */
      function lsTextHosts(el) {
        const hosts = [];
        const visit = (node) => {
          const kids = Array.from(node.children);
          const ownText = Array.from(node.childNodes).some(
            n => n.nodeType === 3 && n.nodeValue.trim()
          );
          if (ownText && kids.length === 0) { hosts.push(node); return; }
          if (ownText) { hosts.push(node); return; }
          kids.forEach(visit);
        };
        visit(el);
        return hosts;
      }

      function lsOriginal(el) {
        if (el.dataset.lsSource === undefined) {
          el.dataset.lsSource = el.innerHTML;
        }
        return el.dataset.lsSource;
      }

      function lsSplit(el) {
        if (el.dataset.ls === 'done' || el.dataset.ls === 'busy') return;
        if (lsShouldSkip(el)) return;

        const hosts = lsTextHosts(el);
        if (!hosts.length) {
          el.dataset.ls = 'done';
          return;
        }

        el.dataset.ls = 'busy';
        lsOriginal(el);

        /* Measure with the transform off. Reading client rects through a
           rotateX under a perspective returns distorted, non-uniformly scaled
           boxes, so the top offsets cannot be compared to find line breaks.
           Only the transform is neutralised. Display is left alone, because
           changing it would change the wrapping being measured. */
        hosts.forEach(h => h.classList.add('ls-measuring'));

        // Measure pass. Read-only: no DOM writes while collecting rects.
        const measured = [];
        let lastTop = null;

        hosts.forEach((host) => {
          const walker = document.createTreeWalker(host, NodeFilter.SHOW_TEXT);
          const nodes = [];
          while (walker.nextNode()) nodes.push(walker.currentNode);

          nodes.forEach((node) => {
            const value = node.nodeValue;
            let cursor = 0;
            // Whitespace stays attached to the token before it, so inter-word
            // spacing is not lost when the line is re-assembled.
            value.split(/(\s+)/).forEach((part) => {
              if (!part) return;
              const start = cursor;
              const end = cursor + part.length;
              cursor = end;

              const range = document.createRange();
              range.setStart(node, start);
              range.setEnd(node, end);
              const rects = Array.from(range.getClientRects()).filter(r => r.width > 0 || r.height > 0);
              if (!rects.length) return;

              const top = Math.round(rects[0].top);
              if (lastTop === null || Math.abs(top - lastTop) > 4) {
                measured.push({ host, parts: [] });
                lastTop = top;
              }
              measured[measured.length - 1].parts.push(part);
            });
          });
        });

        hosts.forEach(h => h.classList.remove('ls-measuring'));

        if (!measured.length) {
          /* Text was found but no client rect had any size, which means the
             subtree is not laid out. The closed mobile overlay is the case that
             matters: it is display:none at load, so every rect is zero. Marking
             it done here would freeze it on the block reveal forever, because
             the splitter never revisits a finished element. Leaving it unmarked
             lets a later call split it once it is visible. */
          delete el.dataset.ls;
          return;
        }

        /* Write pass. Each line becomes mask > inner, reusing the global classes
           so the base CSS drives the animation unchanged. The exact substrings
           were recorded during measurement, so no source node has to be spliced.
           The line index runs across every host in this mask, so a heading and
           the paragraph under it cascade as one sequence. */
        const base = lsBase(el);
        const byHost = new Map();
        measured.forEach((entry, i) => {
          const mask = document.createElement('span');
          mask.className = 'brands-line-mask ls-mask';
          const inner = document.createElement('span');
          inner.className = 'brands-line-inner';
          inner.style.transitionDelay = `${base + i * LS_STEP}s`;
          entry.parts.forEach(p => inner.appendChild(document.createTextNode(p)));
          mask.appendChild(inner);
          if (!byHost.has(entry.host)) byHost.set(entry.host, []);
          byHost.get(entry.host).push(mask);
        });

        byHost.forEach((masks, host) => host.replaceChildren(...masks));
        el.dataset.ls = 'done';
        // The split container no longer animates; its line masks do.
        el.classList.add('ls-split-host');

        // If the split lands after the section already revealed -- fonts and
        // resize both rebuild the masks after first paint -- creating them
        // already active would skip the transition entirely and the lines would
        // snap in as one block. Creating them closed and adding is-active on
        // the next frame lets the one transition this split exists to produce
        // actually play.
        if (el.classList.contains('is-active') || el.closest('.is-active')) {
          requestAnimationFrame(() => {
            el.querySelectorAll('.brands-line-mask').forEach(m => m.classList.add('is-active'));
          });
        }
      }

      /* Toggle for previewing without a rebuild. Set from the console:
           localStorage.setItem('linesplit', 'on'); location.reload()
           localStorage.setItem('linesplit', 'off'); location.reload()
           localStorage.removeItem('linesplit'); location.reload()
         'off' shows the block reveal this replaces, for comparison. The layout
         also sets the body attribute on in dev, so no setup is needed there. */
      function lsMotionOff() {
        return document.documentElement.classList.contains('user-reduced-motion') ||
          (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      }

      function lsOn() {
        // Never split when motion is off. The toggle on /accessibility/ exists
        // precisely so a visitor can remove transitions, and splitting would
        // add a hundred nested masks to do it.
        if (lsMotionOff()) return false;
        const stored = localStorage.getItem('linesplit');
        if (stored === 'on') return true;
        if (stored === 'off') return false;
        return document.body.getAttribute('data-linesplit') === 'on';
      }

      function lsFlag(on) {
        if (on) document.body.setAttribute('data-linesplit', 'on');
        else document.body.removeAttribute('data-linesplit');
      }

      function lsApply() {
        lsFlag(lsOn());
        if (!lsOn()) return;
        const targets = document.querySelectorAll(
          '.brands-line-mask > .brands-line-inner'
        );
        targets.forEach(lsSplit);
      }

      function lsReset() {
        document.querySelectorAll('[data-ls-source]').forEach(el => {
          el.innerHTML = el.dataset.lsSource;
          delete el.dataset.ls;
        });
      }

      let lsTimer;
      window.addEventListener('resize', () => {
        if (!lsOn()) return;
        clearTimeout(lsTimer);
        lsTimer = setTimeout(() => {
          lsReset();
          lsApply();
        }, 200);
      });

      // Fonts land after first paint and they change where lines break.
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          if (!lsOn()) return;
          lsReset();
          lsApply();
        });
      }


      /* Split a subtree that could not be measured while hidden.
         The mobile overlay is display:none until it opens, so at load time every
         rect inside it is zero, no lines are found and it is marked done. It
         then keeps the old block reveal forever. Exposing this lets the menu
         split itself on open, where the overlay is laid out and measurable. */
      window.dattSplitLines = function (root) {
        if (!lsOn() || !root) return;
        root.querySelectorAll(
          '.brands-line-mask > .brands-line-inner'
        ).forEach(lsSplit);
      };

      function initLayout() {
        if ('scrollRestoration' in history) { history.scrollRestoration = 'auto'; }
        document.body.classList.remove('video-active');
        initUniversalReveal();
        lsApply();
      }


      initLayout();
      document.addEventListener('astro:after-swap', initLayout);
    </script>

    <script is:inline>
      /* Legal pages: left-align the sidebar links to the NEWS item in the top nav,
         the same way the footer's Follow us column sits under News. The nav gaps
         are fluid, so the offset is measured. The link text runs at 13px uppercase,
         so the column must stay wide enough for the longest label. */
      function sizeLegalSidebar() {
        const aside = document.querySelector('#main-content .legal-sidebar');
        if (!aside) return;
        const news = document.querySelector('#main-header a[href="/news"]');
        if (!news || window.innerWidth < 1024) {
          aside.style.removeProperty('--legal-sidebar-left');
          return;
        }
        const a = aside.getBoundingClientRect();
        const n = news.getBoundingClientRect();
        const border = parseFloat(getComputedStyle(aside).borderLeftWidth) || 0;
        const links = [...aside.querySelectorAll('.sidebar-link')];
        const widest = links.reduce((m, l) => Math.max(m, l.getBoundingClientRect().width), 0);
        const maxLeft = Math.max(0, Math.round(a.width - widest - 8));
        let left = Math.round(n.left - a.left - border);
        if (left < 0) left = 0;
        if (left > maxLeft) left = maxLeft;
        aside.style.setProperty('--legal-sidebar-left', left + 'px');
      }
      if (!window.__dattLegalSidebar) {
        window.__dattLegalSidebar = true;
        window.addEventListener('resize', sizeLegalSidebar, { passive: true });
        window.addEventListener('load', sizeLegalSidebar);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(sizeLegalSidebar);
      }
      sizeLegalSidebar();
      document.addEventListener('astro:after-swap', sizeLegalSidebar);
    </script>
  </body>
</html>
