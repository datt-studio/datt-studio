---
// CookieBanner.astro
---
<div id="cookie-banner" class="fixed bottom-3 left-3 right-3 md:bottom-6 md:right-6 md:left-auto z-[100001] pointer-events-none">
  <div class="liquid-bar-container w-full md:w-fit border border-white/10 rounded-sm">
    <div class="px-5 py-4 md:px-6 md:py-5 flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-8">

      <!-- Weight 400 for refined editorial feel -->
      <p class="text-[13px] font-normal text-[#b4b4b4] tracking-tight m-0">
        We use cookies for site functionality and analytics.
      </p>

      <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-12">
        <!-- MOBILE ROW 1 / DESKTOP INLINE: policy link and motion toggle.
             md:contents removes this wrapper on desktop so both items sit in
             the main row and inherit its exact gap. -->
        <div class="flex items-center gap-8 md:contents">
          <!-- POLICY LINK: Styled like Legal Sidebar (Grey -> White, No Underline) -->
          <a href="/privacy-cookies-policy/" class="banner-policy-link">Privacy & Cookie Policy</a>

          <button id="motion-toggle-banner" type="button" class="banner-policy-link banner-policy-button">Turn off motion</button>
        </div>

        <div class="flex items-center gap-8">
            <!-- ACTION BUTTONS: Refined Underline Style -->
            <button id="reject-cookies" class="banner-action-link">Reject</button>
            <button id="accept-cookies" class="banner-action-link">Accept</button>
        </div>
      </div>

    </div>
  </div>
</div>

<style is:global>
  #cookie-banner {
    transform: translateY(100%);
    transition: transform 1.2s var(--ease-mechanical), opacity 0.15s ease;
    opacity: 0;
  }
  #cookie-banner.is-visible {
    transform: translateY(0) !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
  .liquid-bar-container {
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(40px) saturate(180%);
  }

  /* --- 1. POLICY LINK STYLE (Sidebar Style: Grey to White) --- */
  .banner-policy-link {
    text-decoration: none;
    text-transform: uppercase;
    color: #808080 !important;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    transition: color 0.4s var(--ease-mechanical);
  }
  .banner-policy-link:hover {
    color: #ffffff !important;
  }

  /* The banner motion toggle is a <button> wearing the policy-link style.
     Reset the native control so it renders exactly like the link. */
  .banner-policy-button {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font-family: inherit;
    line-height: inherit;
    text-align: left;
  }
  .banner-policy-button:focus-visible {
    color: #ffffff !important;
    outline: 1px solid currentColor;
    outline-offset: 3px;
  }

  /* --- 2. ACTION LINK STYLE (Refined Underline) --- */
  .banner-action-link {
    appearance: none;
    text-transform: uppercase;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    position: relative;
    display: inline-block;
    text-decoration: none;
    color: #ffffff !important;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    transition: color 0.4s var(--ease-mechanical);
  }

  .banner-action-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 0.6s var(--ease-mechanical);
  }

  .banner-action-link:hover {
    color: #808080 !important;
  }

  .banner-action-link:hover::after {
    animation: global-underline-flow 0.8s var(--ease-mechanical) forwards;
  }

  @keyframes global-underline-flow {
    0%   { transform: scaleX(1); transform-origin: right; }
    45%  { transform: scaleX(0); transform-origin: right; }
    50%  { transform: scaleX(0); transform-origin: left;  }
    100% { transform: scaleX(1); transform-origin: left;  }
  }
</style>

<script is:inline>
  (function() {
    const CONSENT_KEY = 'datt_studio_consent_v10';
    const MOTION_KEY = 'datt_studio_reduced_motion';

    function paintMotionButton() {
      const btn = document.getElementById('motion-toggle-banner');
      if (!btn) return;
      const reduced = document.documentElement.classList.contains('user-reduced-motion');
      btn.textContent = reduced ? 'Turn motion on' : 'Turn off motion';
    }

    function initMotionToggle() {
      const btn = document.getElementById('motion-toggle-banner');
      if (!btn) return;

      btn.onclick = (e) => {
        e.preventDefault();
        const active = document.documentElement.classList.toggle('user-reduced-motion');
        localStorage.setItem(MOTION_KEY, String(active));
        if (active) {
          document.querySelectorAll('video').forEach((v) => v.pause());
        }
        paintMotionButton();
        window.dispatchEvent(new CustomEvent('datt:motionchange'));
      };

      paintMotionButton();
    }

    function initCookieBanner() {
      const banner = document.getElementById('cookie-banner');
      const acceptBtn = document.getElementById('accept-cookies');
      const rejectBtn = document.getElementById('reject-cookies');
      if (!banner) return;

      const consentRaw = localStorage.getItem(CONSENT_KEY);
      if (!consentRaw) {
        setTimeout(() => {
          if (!localStorage.getItem(CONSENT_KEY)) banner.classList.add('is-visible');
        }, 2000);
      } else {
        banner.classList.remove('is-visible');
      }

      const handleDecision = (choice) => {
        const localId = choice === 'accepted' ? 'DATT-' + Math.random().toString(36).substr(2, 9).toUpperCase() : null;
        const storageData = { decision: choice, timestamp: new Date().toISOString(), localId: localId };

        localStorage.setItem(CONSENT_KEY, JSON.stringify(storageData));
        banner.classList.remove('is-visible');

        if (typeof gtag === 'function') {
          const status = choice === 'accepted' ? 'granted' : 'denied';
          gtag('consent', 'update', {
            'analytics_storage': status,
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied'
          });
        }
        window.dispatchEvent(new CustomEvent('datt-consent-updated'));
      };

      if (acceptBtn) acceptBtn.onclick = () => handleDecision('accepted');
      if (rejectBtn) rejectBtn.onclick = () => handleDecision('rejected');
    }

    // Keep every motion toggle in sync, wherever the change came from.
    window.addEventListener('datt:motionchange', paintMotionButton);

    // Another tab changed the preference: mirror the class locally too.
    window.addEventListener('storage', (ev) => {
      if (ev.key !== MOTION_KEY) return;
      const reduced = ev.newValue === 'true';
      document.documentElement.classList.toggle('user-reduced-motion', reduced);
      if (reduced) document.querySelectorAll('video').forEach((v) => v.pause());
      paintMotionButton();
    });

    initCookieBanner();
    initMotionToggle();
    document.addEventListener('astro:after-swap', () => {
      initCookieBanner();
      initMotionToggle();
    });
  })();
</script>
