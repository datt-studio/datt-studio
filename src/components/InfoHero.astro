---
// InfoSection.astro
const part1 = "DATT STUDIO is a creative studio designing brands, systems, and digital experiences.";
const part2 = "We build clear, distinctive identities through strategy, design, and implementation. Designed for clarity. Built to hold.";
---

<section class="info-section px-[var(--page-padding)] pt-[120px] pb-20 md:pb-40 bg-black">
  <div class="max-w-[1010px] w-full flex flex-col gap-y-12 md:gap-y-16">

    <!-- Block 1 -->
    <h1 class="hero-title">
      {part1.split('||').map((line, i) => (
        <span class="brands-line-mask block">
          <span class="brands-line-inner block" style={`transition-delay: ${i * 0.1}s`}>
            {line.trim()}
          </span>
        </span>
      ))}
    </h1>

    <!-- Block 2 -->
    <h1 class="hero-title">
      {part2.split('||').map((line, i) => (
        <span class="brands-line-mask block">
          <span class="brands-line-inner block" style={`transition-delay: ${0.3 + (i * 0.1)}s`}>
            {line.trim()}
          </span>
        </span>
      ))}
    </h1>

  </div>
</section>

<style is:global>
  .info-section .hero-title {
    font-size: var(--font-h1); /* Restored to H1 */
    font-weight: 600;
    line-height: var(--lh-xtight);
    letter-spacing: var(--track-tighter);
    color: #FFFFFF;
  }

  .info-section .brands-line-mask {
    display: block;
    overflow: hidden;
    perspective: 1200px;
    padding-top: 0.2em;
    padding-bottom: 0.2em;
    margin-top: -0.2em;
    margin-bottom: -0.2em;
  }

  .info-section .brands-line-inner {
    display: block;
    /* EXACT ORIGINAL TRANSITION: -60deg and 1.3s */
    transform: translateY(115%) rotateX(-60deg);
    transform-origin: top center;
    opacity: 0;
    transition: transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical);
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  /* Triggered by the IntersectionObserver in Layout.astro */
  .info-section.is-active .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }
</style>
