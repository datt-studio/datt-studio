---
// HomeIntro.astro
// Two sentences on two authored lines. "greatest leverage." and "it holds."
// are bound with non-breaking spaces so neither pair can split at the phone
// widths where the wrap otherwise strands the final word on its own line.
// "digital landscape," and "clarity is" are also wrapped in .intro-keep: on
// browsers without `text-wrap: balance` they are held unbreakable (see the
// @supports block below) so greedy wrapping cannot strand "your" alone.
const text = 'In a crowded <span class="intro-keep">digital landscape,</span> <span class="intro-keep">clarity is</span> your greatest&nbsp;leverage.<br />We define what matters early, then refine until it&nbsp;holds.';
---

<section class="home-intro reveal-trigger relative w-full min-h-[140svh] px-[var(--page-padding)] flex flex-col items-center justify-center text-center bg-black py-40 md:py-60">
  <div class="max-w-[850px] w-full">

    <!-- Headline: one mask, split and staggered per rendered line at runtime -->
    <h2 class="text-white">
      <span class="brands-line-mask">
        <span class="brands-line-inner" set:html={text}></span>
      </span>
    </h2>

    <!-- CTA Area: Now explicitly sized to 12px label -->
    <div class="mt-12">
      <div class="brands-line-mask inline-block">
        <div class="brands-line-inner" style="transition-delay: 0.5s">
          <a href="/info" class="cta-link inverted-cta">
            About the studio
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style is:global>
  /* 1. MECHANICAL TRANSITION SYNC */
  .home-intro .brands-line-mask {
    display: block;
    overflow: hidden;
    perspective: 1200px;
    padding-top: 0.2em;
    padding-bottom: 0.2em;
    margin-top: -0.2em;
    margin-bottom: -0.2em;
  }

  .home-intro .brands-line-inner {
    display: block;
    transform: translateY(115%) rotateX(-60deg);
    transform-origin: top center;
    opacity: 0;
    transition: transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical);
    will-change: transform, opacity;
  }

  /* 2. REVEAL TRIGGER */
  .home-intro.is-active .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }

  /* 3. TYPOGRAPHY SYNC */
  .home-intro h1 {
    font-size: var(--font-h1);
    font-weight: 600;
    line-height: 1.0 !important;
    letter-spacing: var(--track-tighter);
  }

  /* The headline is two sentences on two authored lines. The explicit <br>
     holds the sentence break; `balance` only evens the wrap inside each
     sentence, so the two sentences keep their own shape. */
  .home-intro h2 {
    text-wrap: balance;
  }

  /* Browsers without `text-wrap: balance` (older mobile Safari/Firefox and
     some in-app webviews) fall back to greedy wrapping, which strands "your"
     alone between "clarity is" and "greatest leverage." on phones. Holding
     those phrases unbreakable restores the clean breaks there only; browsers
     that honour `balance` are left exactly as tuned above. */
  @supports not (text-wrap: balance) {
    .home-intro .intro-keep {
      white-space: nowrap;
    }
  }

  /* 4. CTA CONSISTENCY FIX */
  .home-intro .cta-link.inverted-cta {
    color: #FFFFFF !important;
    /* This ensures it matches HomeStudio/HomeApproach exactly */
    font-size: var(--font-label) !important; /* Forces 12px */
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    display: inline-block;
  }

  .home-intro .cta-link.inverted-cta::after {
    background-color: #FFFFFF !important;
    height: 1.5px;
  }
</style>
