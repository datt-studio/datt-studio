---
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<script is:inline define:vars={{ id }}>
  // 1. CONFIGURATION
  const CONSENT_KEY = 'datt_studio_consent_v10'; // Keep this synced with CookieBanner.astro

  window.dataLayer = window.dataLayer || [];
  window.gtag = function() { dataLayer.push(arguments); };

  function getConsentStatus() {
    try {
      const rawData = localStorage.getItem(CONSENT_KEY);
      if (!rawData) return 'denied';
      const parsed = JSON.parse(rawData);
      return (parsed.decision === 'accepted') ? 'granted' : 'denied';
    } catch (e) {
      return 'denied';
    }
  }

  function initAnalytics() {
    const status = getConsentStatus();

    // 2. SET CONSENT DEFAULT (Important for Google Consent Mode v2)
    gtag('consent', 'default', {
      'analytics_storage': status,
      'ad_storage': status,
      'ad_user_data': status,
      'ad_personalization': status,
      'wait_for_update': 500
    });

    // 3. LOAD SCRIPT IF GRANTED (OR UPDATE IF ALREADY LOADED)
    if (status === 'granted') {
      if (!window.gtag_loaded) {
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
        document.head.appendChild(script);
        window.gtag_loaded = true;
      } else {
        gtag('consent', 'update', { 'analytics_storage': 'granted' });
      }
    }

    // 4. INITIALIZE TAG
    gtag('js', new Date());
    // send_page_view: false because we handle it manually for ViewTransitions below
    gtag('config', id, { send_page_view: false });
  }

  function trackPageView() {
    if (typeof gtag === 'function') {
      gtag('event', 'page_view', {
        page_title: document.title,
        page_location: window.location.href,
        page_path: window.location.pathname
      });
    }
  }

  // --- EXECUTION ---

  // Run on first load
  initAnalytics();
  trackPageView();

  // Listen for the "datt-consent-updated" event fired by CookieBanner.astro
  window.addEventListener('datt-consent-updated', () => {
    initAnalytics();
    trackPageView();
  });

  // Handle ViewTransitions
  document.addEventListener('astro:after-swap', trackPageView);
</script>
