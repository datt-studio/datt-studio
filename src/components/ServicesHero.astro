---
// InfoHero.astro
// The body of the intro is one flowing paragraph. Only the closing beat sits
// on a line of its own, so the copy wraps naturally instead of breaking into a
// stack of short fragments.
const intro = "Identity. Systems. Digital. A focused practice spanning brand identity, visual systems, and digital experiences. Work built with structure. Defined by precision.";
const closing = "Made to hold.";

const lines = [intro, closing];
---

<section class="info-hero-section reveal-trigger px-[var(--page-padding)] pt-[120px] pb-20 md:pb-40 bg-black">
  <div data-intro-container class="w-full">

    <!-- One mask around every line so the splitter indexes the whole intro as a
         single cascade and each line starts after the one above it, rather than
         one sequence per block all starting together. -->
    <div class="brands-line-mask">
      <div class="brands-line-inner flex flex-col gap-y-10 md:gap-y-12">
        {lines.map((line) => (
          <h1 class="hero-title m-0">{line}</h1>
        ))}
      </div>
    </div>

  </div>
</section>

<style is:global>
  /* 1. TYPE SYSTEM INTEGRATION */
  .info-hero-section .hero-title {
    font-size: var(--font-h1); /* clamp(38px, 9vw, 72px) */
    font-weight: 600;
    line-height: var(--lh-xtight); /* 1.05 */
    letter-spacing: var(--track-tighter);
    color: #FFFFFF;
    margin: 0;
    text-transform: none; /* Respects sentence case in variables */
    text-wrap: balance; /* keeps 'Defined by' off a line of its own */
  }

  /* 2. MECHANICAL REVEAL ENGINE */
  .info-hero-section .brands-line-mask {
    display: block;
    overflow: hidden;
    perspective: 1200px;
    /* Prevents clipping of the 3D rotation */
    padding-top: 0.15em;
    padding-bottom: 0.15em;
    margin-top: -0.15em;
    margin-bottom: -0.15em;
  }

  .info-hero-section .brands-line-inner {
    display: block;
    /* -60deg for the heavy mechanical 'flip' look */
    transform: translateY(115%) rotateX(-60deg);
    transform-origin: top center;
    opacity: 0;
    transition: transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical);
    will-change: transform, opacity;
  }

  /* Activation (Triggered by Intersection Observer in Layout or local script) */
  .info-hero-section.is-active .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }

  /* The intro takes the full content width. The top nav shares the same page
     padding, so this reaches the end of the Contact item with nothing measured
     at runtime, which keeps it from starting narrow and snapping wide. */
  .info-hero-section [data-intro-container] {
    width: 100%;
    max-width: none;
  }
</style>

<script is:inline>
  function initInfoHero() {
    const section = document.querySelector('.info-hero-section');
    if (section) {
      // Small delay to allow layout to settle before reveal
      requestAnimationFrame(() => {
        setTimeout(() => section.classList.add('is-active'), 100);
      });
    }
  }
  initInfoHero();
  document.addEventListener('astro:after-swap', initInfoHero);
</script>
