---
import SecureEmail from './SecureEmail.astro';
import TimeDisplay from './TimeDisplay.astro';
import { socialLinks } from '../data/social';
const currentYear = new Date().getFullYear();
const { isInverted = false } = Astro.props;
---

<footer
  id="site-footer"
  class:list={[
    "relative px-[var(--page-padding)] pb-0 overflow-hidden transition-colors duration-700 w-full",
    isInverted ? "bg-black text-white" : "bg-white text-black"
  ]}
>
  <div id="footer-reveal-trigger" class="flex flex-col min-h-[100svh] pt-[120px]">

    <!-- Headline: Safe-zone padding added to prevent clipping. -->
    <div class="mb-12 md:mb-12">
      <div class="flex items-baseline justify-between gap-x-6">
        <div class="brands-line-mask !py-[0.8em] !-my-[0.8em]">
          <h2 class="brands-line-inner max-w-[1100px]">
            Let’s talk.
          </h2>
        </div>
      </div>
    </div>

    <!-- Info Grid
         The clock sits at the top of the first column, with the enquiries and
         the legal / social columns on the row beneath it. Below lg this is a
         two-column grid: the two enquiries sit side by side on the first row and
         Legal / Follow us on the second. From lg it is split on the About,
         Services and News links in the top nav, so New business starts under
         About, Legal under Services and Follow us under News. Those offsets are
         measured in the footer script because the nav gaps are fluid. -->
    <div class="footer-info w-full mb-10 lg:mb-24">
      <div class="brands-line-mask footer-time">
        <div class="brands-line-inner" style="transition-delay: 0.15s;">
          <TimeDisplay isInverted={isInverted} />
        </div>
      </div>
      <div class="brands-line-mask footer-enquiries footer-general">
        <div class="brands-line-inner" style="transition-delay: 0.2s;">
          <p class="text-label mb-2">General enquiries</p>
          <SecureEmail email="hello@dattstudio.com" className="cta-link !text-[clamp(13px,3.9vw,18px)] !lowercase !tracking-tight" isInverted={isInverted} />
        </div>
      </div>
      <div class="brands-line-mask footer-enquiries footer-business">
        <div class="brands-line-inner" style="transition-delay: 0.25s;">
          <p class="text-label mb-2">New business</p>
          <SecureEmail email="info@dattstudio.com" className="cta-link !text-[clamp(13px,3.9vw,18px)] !lowercase !tracking-tight" isInverted={isInverted} />
        </div>
      </div>

      <div class="brands-line-mask footer-legal">
        <div class="brands-line-inner" style="transition-delay: 0.3s;">
          <p class="text-label text-transform: uppercase mb-2">Legal</p>
          <div class="flex flex-col gap-y-2">
            <a href="/privacy-cookies-policy" class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity">Privacy & cookies</a>
            <a href="/terms-of-use" class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity">Terms of use</a>
            <a href="/accessibility" class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity">Accessibility</a>
            <a href="/data-processing" class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity">Data processing</a>
          </div>
        </div>
      </div>

      <div class="brands-line-mask footer-follow">
        <div class="brands-line-inner" style="transition-delay: 0.35s;">
          <p class="text-label text-transform: uppercase mb-2">Follow us</p>
          <div class="flex flex-col gap-y-2">
            {socialLinks.map((social) => (
              <a href={social.href} class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity whitespace-nowrap">{social.label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="flex-grow"></div>

    <!-- Logo -->
    <div class="brands-line-mask w-full !py-4 !-my-4">
      <div
        class:list={["brands-line-inner logo-protection-container mb-6", isInverted ? "invert-logo" : ""]}
        style="transition-delay: 0.5s;"
        role="img"
        aria-label="DATT STUDIO LOGO"
      >
        <div class="logo-shield" aria-hidden="true"></div>
        <img src="/assets/datt_logo_l.svg" alt="DATT" width="2426" height="293" class="hidden md:block w-full h-auto select-none no-drag" />
        <img src="/assets/datt_logo_s.svg" alt="DATT" width="440" height="159" class="block md:hidden w-full h-auto select-none no-drag" />
      </div>
    </div>

    <!-- Copyright -->
    <div class="brands-line-mask">
      <div class="brands-line-inner pb-4" style="transition-delay: 0.7s;">
      <p class="text-label !text-[11px] opacity-50 !tracking-[0.05em]">
      © {currentYear} DATT STUDIO LTD.
      <br class="md:hidden" />
      Registered in England & Wales: 16695845.
      </p>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* Local Adjustments to fix clipping and logo protection */
  .logo-protection-container { position: relative; user-select: none; }
  .logo-shield { position: absolute; inset: 0; z-index: 10; background: transparent; }
  .no-drag { -webkit-user-drag: none; pointer-events: none; }
  .invert-logo img { filter: invert(1); }

  /* Ensure the headline and logo can rotate fully without hitting mask edges */
  #site-footer .brands-line-mask {
    padding-top: 0.2em;
    padding-bottom: 0.2em;
    margin-top: -0.2em;
    margin-bottom: -0.2em;
  }

  /* Corrected Axis state for Footer specifically */
  #footer-reveal-trigger.is-active .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }

  /* The email underlines arrive after the words. Each is held undrawn
     (scaleX(0)) while its address flips in, then draws itself one beat later,
     so the rule follows the copy instead of arriving with it. This is tied to
     the trigger's .is-active class rather than a transitionend event, so it
     cannot be left undrawn if that event never fires. */
  #footer-reveal-trigger .secure-email-copy.cta-link::after {
    transform: scaleX(0);
    transform-origin: left;
    transition: none;
  }
  #footer-reveal-trigger.is-active .secure-email-copy.cta-link::after {
    transform: scaleX(1);
    transition: transform 0.6s var(--ease-mechanical) 1.6s;
  }

  /* With motion off the line is simply drawn, as it is everywhere else. */
  html.user-reduced-motion #footer-reveal-trigger .secure-email-copy.cta-link::after {
    transform: scaleX(1) !important;
    transition: none !important;
  }

  /* Info grid. One column on mobile; two columns from 768px and four from
     1024px. At desktop it is split on the About, Services and News links in the
     top nav, so New business starts under About, Legal under Services and
     Follow us under News. The offsets are measured in the footer script because
     the nav gaps are fluid, with percentage throwbacks before it runs. */
  #site-footer .footer-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    row-gap: 3rem;
  }
  /* The clock spans the full width above the grid below lg. */
  #site-footer .footer-time { grid-column: 1 / -1; }

  /* --- TABLET: THE SECOND COLUMN HANGS OFF THE SERVICES ITEM ---
     Between 768px and 1023px the grid is in two columns and the second one
     holds New business and Follow us, with the first one holding General
     enquiries and Legal. Even columns split the footer down the middle of a
     tablet screen, which lines the second column up with nothing at all while
     the top nav has a SERVICES item much further right. The second column is
     hung off that item instead, so New business, the email under it, Follow us
     and the social links all start where the word SERVICES does. It is the same
     join the desktop grid makes with the same link, and the same one the
     services and info pages hang their copy off.

     The first column takes the measured distance less the 2rem gap, and the
     second takes what is left, so the gap survives and the join still lands
     exactly on the nav item. Making the second column a fixed width instead
     would have it overflow the narrower tablets. 50% stands in until the script
     has measured.

     Below 768px the nav has no SERVICES item to line up with and the grid is a
     single column, so nothing applies. */
  @media (min-width: 768px) and (max-width: 1023px) {
    #site-footer .footer-info {
      grid-template-columns: minmax(0, calc(var(--services-left, 50%) - 2rem)) 1fr;
    }
  }

  @media (min-width: 1024px) {
    #site-footer .footer-info {
      grid-template-columns:
        var(--about-left, 26%)
        calc(var(--legal-left, 48%) - var(--about-left, 26%))
        calc(var(--follow-left, 72%) - var(--legal-left, 48%))
        1fr;
      column-gap: 0;
      row-gap: 1.5rem;
      align-items: start;
    }
    /* Pull the clock up so it sits about 20px under the headline. A transform is
       used rather than a margin so the grid rows (and the columns below) stay
       exactly where they are. */
    #site-footer .footer-time { grid-column: 1; grid-row: 1; transform: translateY(-14px); }
    /* Each column anchors to a different top-nav link, so the headings all share
       the second row and line up across the footer. */
    #site-footer .footer-general { grid-column: 1; grid-row: 2; }
    #site-footer .footer-business { grid-column: 2; grid-row: 2; }
    #site-footer .footer-legal { grid-column: 3; grid-row: 2; }
    #site-footer .footer-follow { grid-column: 4; grid-row: 2; }
  }

  /* Mobile landscape: keep the wordmark at half width so a short viewport is
     not swallowed by it. `h-auto` on the images holds the aspect ratio. */
  @media (orientation: landscape) and (max-height: 520px) {
    #site-footer .logo-protection-container img { max-width: 50%; }
  }

  /* Below lg the Legal and Follow us links stack in a column. Match the mobile
     menu's secondary list exactly: 36px rows with a 2px gap (gap-y-0.5) and no
     vertical padding. Legal and Follow us share the same row rhythm, so their
     baselines line up across the two columns. The four-column desktop layout is
     untouched. */
  @media (max-width: 1023px) {
    #site-footer .footer-legal .flex.flex-col,
    #site-footer .footer-follow .flex.flex-col {
      row-gap: 0.125rem;
    }
    #site-footer .footer-legal a,
    #site-footer .footer-follow a {
      display: flex;
      align-items: center;
      min-height: 36px;
      padding-top: 0;
      padding-bottom: 0;
    }
  }
</style>

<script is:inline>
  function initFooterReveals() {
    const footer = document.getElementById('site-footer');
    if (!footer) return;

    /* --- ONE LIVE INSTANCE AT A TIME ---

       This script is inline, so the client router re-runs it on every
       navigation. Everything it attaches to `window` outlives the swap: the
       listeners stay bound and the observers stay pointed at nodes the router
       has already discarded. So a previous run is stopped before this one
       starts. The list is kept on `window` because an inline script gets a
       fresh scope on every navigation and nothing else survives the swap.
       `sizeFooterColumns` below guards its own resize listener the same way;
       this is the same guard, applied to everything here. */
    const KEY = '__dattFooterReveals';
    if (window[KEY]) window[KEY]();
    const stoppers = [];
    window[KEY] = () => {
      for (const stop of stoppers) {
        try { stop(); } catch (_) {}
      }
      stoppers.length = 0;
    };
    /* Every listener goes through this, so stopping is a matter of undoing what
       is in the list rather than remembering to undo each one by hand. */
    const on = (target, type, fn, opts) => {
      target.addEventListener(type, fn, opts);
      stoppers.push(() => target.removeEventListener(type, fn, opts));
    };

    /* The wordmark is not a thing to be dragged off the page or saved by
       accident, so the usual two gestures are refused on it. */
    document.querySelectorAll('.logo-protection-container').forEach(c => {
      on(c, 'contextmenu', e => e.preventDefault());
      on(c, 'dragstart', e => e.preventDefault());
    });

    const trigger = document.getElementById('footer-reveal-trigger');

    /* The footer's own arrival drives its reveal, which happens as soon as
       anything of the footer is on screen. Threshold zero because the trigger is
       a hairline: a one-pixel target reports a ratio of one the moment a sliver
       of it appears. */
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting || !trigger) return;
        trigger.classList.add('is-active');
      });
    }, { threshold: 0 });
    revealObserver.observe(footer);
    stoppers.push(() => revealObserver.disconnect());
  }

  initFooterReveals();
  document.addEventListener('astro:after-swap', initFooterReveals);

  // Split the footer's info grid on the About, Services and News links in the
  // top nav, so New business starts under About, Legal under Services and
  // Follow us under News. The nav gaps are fluid, so the offsets are measured
  // rather than hard-coded.
  //
  // The Services link is measured from 768px rather than from 1024px, because on
  // a tablet it is the link the second column of the two-column grid hangs off.
  // It is kept under its own name there and also serves as --legal-left at
  // desktop, so neither width has to read a variable named for the other.
  function sizeFooterColumns() {
    const grid = document.querySelector('#site-footer .footer-info');
    if (!grid) return;
    const services = document.querySelector('#main-header a[href="/services"]');
    if (!services || window.innerWidth < 768) {
      grid.style.removeProperty('--services-left');
      grid.style.removeProperty('--about-left');
      grid.style.removeProperty('--legal-left');
      grid.style.removeProperty('--follow-left');
      return;
    }
    const g = grid.getBoundingClientRect();
    const servicesLeft = Math.round(services.getBoundingClientRect().left - g.left);
    grid.style.setProperty('--services-left', servicesLeft + 'px');
    // The other two links only matter to the four-column grid at 1024px and up.
    const about = document.querySelector('#main-header a[href="/info"]');
    const news = document.querySelector('#main-header a[href="/news"]');
    if (!about || !news || window.innerWidth < 1024) {
      grid.style.removeProperty('--about-left');
      grid.style.removeProperty('--legal-left');
      grid.style.removeProperty('--follow-left');
      return;
    }
    grid.style.setProperty('--about-left', Math.round(about.getBoundingClientRect().left - g.left) + 'px');
    grid.style.setProperty('--legal-left', servicesLeft + 'px');
    grid.style.setProperty('--follow-left', Math.round(news.getBoundingClientRect().left - g.left) + 'px');
  }

  if (!window.__dattFooterCols) {
    window.__dattFooterCols = true;
    window.addEventListener('resize', sizeFooterColumns, { passive: true });
    window.addEventListener('load', sizeFooterColumns);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(sizeFooterColumns);
  }
  sizeFooterColumns();
  document.addEventListener('astro:after-swap', sizeFooterColumns);
</script>
