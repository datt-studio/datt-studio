---
import SecureEmail from './SecureEmail.astro';
import TimeDisplay from './TimeDisplay.astro';
import { socialLinks } from '../data/social';
const currentYear = new Date().getFullYear();
const { isInverted = false, disableMagnet = false } = Astro.props;
---

<footer
  id="site-footer"
  data-disable-magnet={disableMagnet.toString()}
  class:list={[
    "relative px-[var(--page-padding)] pb-0 overflow-hidden transition-colors duration-700 w-full",
    isInverted ? "bg-black text-white" : "bg-white text-black"
  ]}
>
  <div id="footer-magnet-trigger" class="absolute -top-40 left-0 w-full h-20 pointer-events-none"></div>

  <div id="footer-reveal-trigger" class="flex flex-col min-h-[100svh] pt-[120px]">

    <!-- Headline: Safe-zone padding added to prevent clipping. -->
    <div class="mb-12 md:mb-12">
      <div class="flex items-baseline justify-between gap-x-6">
        <div class="brands-line-mask !py-[0.8em] !-my-[0.8em]">
          <h2 class="brands-line-inner max-w-[1100px]">
            Let’s talk.
          </h2>
        </div>
      </div>
    </div>

    <!-- Info Grid
         The clock sits at the top of the first column, with the enquiries and
         the legal / social columns on the row beneath it. Below lg this is a
         two-column grid: the two enquiries sit side by side on the first row and
         Legal / Follow us on the second. From lg it is split on the About,
         Services and News links in the top nav, so New business starts under
         About, Legal under Services and Follow us under News. Those offsets are
         measured in the footer script because the nav gaps are fluid. -->
    <div class="footer-info w-full mb-10 lg:mb-24">
      <div class="brands-line-mask footer-time">
        <div class="brands-line-inner" style="transition-delay: 0.15s;">
          <TimeDisplay isInverted={isInverted} />
        </div>
      </div>
      <div class="brands-line-mask footer-enquiries footer-general">
        <div class="brands-line-inner" style="transition-delay: 0.2s;">
          <p class="text-label mb-2">General enquiries</p>
          <SecureEmail email="hello@dattstudio.com" className="cta-link !text-[clamp(13px,3.9vw,18px)] !lowercase !tracking-tight" isInverted={isInverted} />
        </div>
      </div>
      <div class="brands-line-mask footer-enquiries footer-business">
        <div class="brands-line-inner" style="transition-delay: 0.25s;">
          <p class="text-label mb-2">New business</p>
          <SecureEmail email="info@dattstudio.com" className="cta-link !text-[clamp(13px,3.9vw,18px)] !lowercase !tracking-tight" isInverted={isInverted} />
        </div>
      </div>

      <div class="brands-line-mask footer-legal">
        <div class="brands-line-inner" style="transition-delay: 0.3s;">
          <p class="text-label text-transform: uppercase mb-2">Legal</p>
          <div class="flex flex-col gap-y-2">
            <a href="/privacy-cookies-policy" class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity">Privacy & cookies</a>
            <a href="/terms-of-use" class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity">Terms of use</a>
            <a href="/accessibility" class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity">Accessibility</a>
            <a href="/data-processing" class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity">Data processing</a>
          </div>
        </div>
      </div>

      <div class="brands-line-mask footer-follow">
        <div class="brands-line-inner" style="transition-delay: 0.35s;">
          <p class="text-label text-transform: uppercase mb-2">Follow us</p>
          <div class="flex flex-col gap-y-2">
            {socialLinks.map((social) => (
              <a href={social.href} class="text-label !text-clamp(14px, 3vw, 12px) opacity-60 hover:opacity-100 transition-opacity whitespace-nowrap">{social.label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Where the magnet waits.
         A hairline at the bottom of the links above, which is the last thing a
         reader has to have seen before the pull is worth doing: after it the
         footer is only the wordmark and the copyright, so bringing the rest up
         means the logo and its line are read together rather than the page
         sliding a screen of nothing into view. -->
    <div id="footer-links-end" class="w-full h-px pointer-events-none" aria-hidden="true"></div>

    <div class="flex-grow"></div>

    <!-- Logo -->
    <div class="brands-line-mask w-full !py-4 !-my-4">
      <div
        class:list={["brands-line-inner logo-protection-container mb-6", isInverted ? "invert-logo" : ""]}
        style="transition-delay: 0.5s;"
        role="img"
        aria-label="DATT STUDIO LOGO"
      >
        <div class="logo-shield" aria-hidden="true"></div>
        <img src="/assets/datt_logo_l.svg" alt="DATT" width="2426" height="293" class="hidden md:block w-full h-auto select-none no-drag" />
        <img src="/assets/datt_logo_s.svg" alt="DATT" width="440" height="159" class="block md:hidden w-full h-auto select-none no-drag" />
      </div>
    </div>

    <!-- Copyright -->
    <div class="brands-line-mask">
      <div class="brands-line-inner pb-4" style="transition-delay: 0.7s;">
      <p class="text-label !text-[11px] opacity-50 !tracking-[0.05em]">
      © {currentYear} DATT STUDIO LTD.
      <br class="md:hidden" />
      Registered in England & Wales: 16695845.
      </p>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* Local Adjustments to fix clipping and logo protection */
  .logo-protection-container { position: relative; user-select: none; }
  .logo-shield { position: absolute; inset: 0; z-index: 10; background: transparent; }
  .no-drag { -webkit-user-drag: none; pointer-events: none; }
  .invert-logo img { filter: invert(1); }

  /* Ensure the headline and logo can rotate fully without hitting mask edges */
  #site-footer .brands-line-mask {
    padding-top: 0.2em;
    padding-bottom: 0.2em;
    margin-top: -0.2em;
    margin-bottom: -0.2em;
  }

  /* Corrected Axis state for Footer specifically */
  #footer-reveal-trigger.is-active .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }

  /* The email underlines arrive after the words. Each is held undrawn
     (scaleX(0)) while its address flips in, then draws itself one beat later,
     so the rule follows the copy instead of arriving with it. This is tied to
     the trigger's .is-active class rather than a transitionend event, so it
     cannot be left undrawn if that event never fires. */
  #footer-reveal-trigger .secure-email-copy.cta-link::after {
    transform: scaleX(0);
    transform-origin: left;
    transition: none;
  }
  #footer-reveal-trigger.is-active .secure-email-copy.cta-link::after {
    transform: scaleX(1);
    transition: transform 0.6s var(--ease-mechanical) 1.6s;
  }

  /* With motion off the line is simply drawn, as it is everywhere else. */
  html.user-reduced-motion #footer-reveal-trigger .secure-email-copy.cta-link::after {
    transform: scaleX(1) !important;
    transition: none !important;
  }

  /* Info grid. One column on mobile; two columns from 768px and four from
     1024px. At desktop it is split on the About, Services and News links in the
     top nav, so New business starts under About, Legal under Services and
     Follow us under News. The offsets are measured in the footer script because
     the nav gaps are fluid, with percentage throwbacks before it runs. */
  #site-footer .footer-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    row-gap: 3rem;
  }
  /* The clock spans the full width above the grid below lg. */
  #site-footer .footer-time { grid-column: 1 / -1; }

  /* --- TABLET: THE SECOND COLUMN HANGS OFF THE SERVICES ITEM ---
     Between 768px and 1023px the grid is in two columns and the second one
     holds New business and Follow us, with the first one holding General
     enquiries and Legal. Even columns split the footer down the middle of a
     tablet screen, which lines the second column up with nothing at all while
     the top nav has a SERVICES item much further right. The second column is
     hung off that item instead, so New business, the email under it, Follow us
     and the social links all start where the word SERVICES does. It is the same
     join the desktop grid makes with the same link, and the same one the
     services and info pages hang their copy off.

     The first column takes the measured distance less the 2rem gap, and the
     second takes what is left, so the gap survives and the join still lands
     exactly on the nav item. Making the second column a fixed width instead
     would have it overflow the narrower tablets. 50% stands in until the script
     has measured.

     Below 768px the nav has no SERVICES item to line up with and the grid is a
     single column, so nothing applies. */
  @media (min-width: 768px) and (max-width: 1023px) {
    #site-footer .footer-info {
      grid-template-columns: minmax(0, calc(var(--services-left, 50%) - 2rem)) 1fr;
    }
  }

  @media (min-width: 1024px) {
    #site-footer .footer-info {
      grid-template-columns:
        var(--about-left, 26%)
        calc(var(--legal-left, 48%) - var(--about-left, 26%))
        calc(var(--follow-left, 72%) - var(--legal-left, 48%))
        1fr;
      column-gap: 0;
      row-gap: 1.5rem;
      align-items: start;
    }
    /* Pull the clock up so it sits about 20px under the headline. A transform is
       used rather than a margin so the grid rows (and the columns below) stay
       exactly where they are. */
    #site-footer .footer-time { grid-column: 1; grid-row: 1; transform: translateY(-14px); }
    /* Each column anchors to a different top-nav link, so the headings all share
       the second row and line up across the footer. */
    #site-footer .footer-general { grid-column: 1; grid-row: 2; }
    #site-footer .footer-business { grid-column: 2; grid-row: 2; }
    #site-footer .footer-legal { grid-column: 3; grid-row: 2; }
    #site-footer .footer-follow { grid-column: 4; grid-row: 2; }
  }

  /* Mobile landscape: keep the wordmark at half width so a short viewport is
     not swallowed by it. `h-auto` on the images holds the aspect ratio. */
  @media (orientation: landscape) and (max-height: 520px) {
    #site-footer .logo-protection-container img { max-width: 50%; }
  }

  /* Below lg the Legal and Follow us links stack in a column. Match the mobile
     menu's secondary list exactly: 36px rows with a 2px gap (gap-y-0.5) and no
     vertical padding. Legal and Follow us share the same row rhythm, so their
     baselines line up across the two columns. The four-column desktop layout is
     untouched. */
  @media (max-width: 1023px) {
    #site-footer .footer-legal .flex.flex-col,
    #site-footer .footer-follow .flex.flex-col {
      row-gap: 0.125rem;
    }
    #site-footer .footer-legal a,
    #site-footer .footer-follow a {
      display: flex;
      align-items: center;
      min-height: 36px;
      padding-top: 0;
      padding-bottom: 0;
    }
  }
</style>

<script is:inline>
  function initFooterReveals() {
    const footer = document.getElementById('site-footer');
    if (!footer) return;

    /* --- ONE LIVE INSTANCE AT A TIME ---

       This script is inline, so the client router re-runs it on every
       navigation. Everything it attaches to `window` outlives the swap: the
       listeners stay bound and the observers stay pointed at nodes the router
       has already discarded, and they are then looking at a page the reader
       never scrolled. A leftover copy would arm the pull on the new page and
       carry it to the footer unbidden — which is what happened on the way from
       the homepage to any other page, and why scrolling back up dragged the
       page down again.

       So a previous run is stopped before this one starts. The list is kept on
       `window` because an inline script gets a fresh scope on every navigation
       and nothing else survives the swap. `sizeFooterColumns` below guards its
       own resize listener the same way; this is the same guard, extended to
       everything else here. */
    const KEY = '__dattFooterReveals';
    if (window[KEY]) window[KEY]();
    const stoppers = [];
    window[KEY] = () => {
      for (const stop of stoppers) {
        try { stop(); } catch (_) {}
      }
      stoppers.length = 0;
    };
    /* Every listener goes through this, so stopping is a matter of undoing what
       is in the list rather than remembering to undo each one by hand. */
    const on = (target, type, fn, opts) => {
      target.addEventListener(type, fn, opts);
      stoppers.push(() => target.removeEventListener(type, fn, opts));
    };

    let userScrolled = false;
    const unlockOnScroll = () => { userScrolled = true; };
    on(window, 'wheel', unlockOnScroll, { once: true, passive: true });
    on(window, 'touchmove', unlockOnScroll, { once: true, passive: true });
    on(window, 'keydown', (e) => {
        if (['ArrowDown', 'Space', 'PageDown'].includes(e.code)) userScrolled = true;
    }, { once: true, passive: true });

    const isMagnetDisabled = footer.getAttribute('data-disable-magnet') === 'true';

    document.querySelectorAll('.logo-protection-container').forEach(c => {
      on(c, 'contextmenu', e => e.preventDefault());
      on(c, 'dragstart', e => e.preventDefault());
    });

    const trigger = document.getElementById('footer-reveal-trigger');
    let isMagnetized = false;

    /* Motion off means the pull is off. The kill-switch in the layout only forces
       scroll-behavior to auto, which a scrollTo({behavior:'smooth'}) ignores, so
       this has to be asked about in script or a reader who has asked for less
       movement gets the largest movement on the page. */
    const motionOff = () =>
      document.documentElement.classList.contains('user-reduced-motion') ||
      (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

    /* The magnet holds the footer at the bottom of the screen once it has arrived.

       It fires when the bottom of the legal and social links reaches the screen,
       which is the last thing a reader has to have seen before the pull is worth
       doing. Everything left below that line is the wordmark and the copyright,
       so carrying it up means the logo is read with its line instead of the page
       sliding a screen of nothing into view.

       Waiting on that line rather than on the footer itself is what makes the
       guarantee real. Measured as a fraction of the footer it could only ever be
       an estimate, and the estimate is wrong in both directions: the footer is
       roughly a viewport tall, so a fraction of it is a fraction of the screen,
       but how much of it that is worth varies with the viewport and, more to the
       point, a fifth is early enough to fire while the enquiries are still the
       bottom of the screen and the links have not been seen at all. The line is
       a thing that either is or is not on screen, so the pull can never fire
       before the links are readable.

       Only on the way in. Reading the previous state and acting just as the line
       arrives means a reader who scrolls back up to reread the links is not
       dragged down again the moment the footer reappears, which is what would
       happen if this were simply a level to cross. */

    const linksEnd = document.getElementById('footer-links-end');
    let linksWereOnScreen = false;

    /* The wordmark is what the pull is for, so it is also what decides whether
       there is anything to do. If it is already on screen the reader has reached
       it themselves and moving the page would achieve nothing but motion — and
       the wordmark reveals itself in any case, being a line of its own. */
    const wordmark = footer.querySelector('.logo-protection-container');
    const wordmarkOnScreen = () =>
      !!wordmark && wordmark.isConnected &&
      wordmark.getBoundingClientRect().top < window.innerHeight &&
      wordmark.getBoundingClientRect().bottom > 0;

    /* Is the line on screen right now? The observer only reports when it enters
       or leaves, so this is how a pull that was held back during a gesture is
       checked before it is carried out.

       `isConnected` is not defensive noise. A node the router has already
       detached reports an all-zero rect, and zero is above minus nothing: a
       discarded line would read as sitting at the top of the screen, i.e. as
       plainly on screen, so anything still holding a reference to it would
       conclude the reader had reached the footer. Asking whether the node is
       still in the document is what makes that impossible. */
    const linksOnScreen = () =>
      !!linksEnd && linksEnd.isConnected && linksEnd.getBoundingClientRect().top <= window.innerHeight;

    const pullDown = () => {
      isMagnetized = true;
      window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
      setTimeout(() => { isMagnetized = false; }, 2000);
    };

    /* --- WAITING FOR THE PAGE TO BE STILL ---

       A finger being off the glass is not the same as the page having stopped.
       On a phone the list is thrown, not pushed, and it keeps coasting for a
       second or so after the finger lifts. The trigger line crosses the screen
       during that coast, so the pull used to begin while the browser was still
       decelerating the reader's own scroll: two things commanding the scroll
       position at once, and the page would creep, stall, then be carried the rest
       of the way. That reads as the scroll catching, which is the one thing a
       scroll must not do.

       So the pull waits for the page to be still rather than trusting the moment
       the line arrived. Every scroll restarts a short timer, and the pull runs
       when the timer is allowed to expire. A reader who is still coasting gets
       the footer once they have actually stopped; a reader who carries on past
       the line never gets it, which is the existing cancellation.

       The window is short on purpose: long enough that the tail of a throw has
       finished, short enough that the footer still feels attached to the scroll
       that arrived rather than answering to some later one. */

    const SETTLE_MS = 110;
    let settleTimer = 0;

    function pullWhenStill() {
      clearTimeout(settleTimer);
      settleTimer = setTimeout(() => {
        if (gestureActive) return;
        // Re-checked here rather than trusted from when the timer was set: the
        // line can have gone back off screen while the page was settling, and
        // pulling then would carry the reader somewhere they have just left.
        if (isMagnetDisabled || isMagnetized || motionOff() || !linksOnScreen()) return;
        // Nothing to reveal: the wordmark is already in view.
        if (wordmarkOnScreen()) return;
        pullDown();
      }, SETTLE_MS);
    }

    /* Only armed while the line is on screen and the magnet is idle, so an
       ordinary scroll through the rest of the page costs one comparison and no
       timer churn. */
    on(window, 'scroll', () => {
      if (isMagnetDisabled || isMagnetized) return;
      if (linksOnScreen()) pullWhenStill();
    }, { passive: true, capture: true });

    /* The pull moves the page under the reader's hand, so it must not run while a
       gesture is in progress.

       Dragging the carousel is the case that matters: the strip is read by the
       drag in finger-offset terms while a smooth scroll slides the whole page,
       so a pull landing mid-drag moves the strip out from under the finger and
       the drag settles on a position the reader never put it on. The tap of an
       arrow matters for the same reason, and a tap can also land on the same
       frame as the crossing.

       Two things are needed, not one. A pull must not start mid-gesture, and a
       pull already running must be abandoned the moment a gesture begins,
       because cancelling it late still means the page moved under the finger
       first. Asking for the position already reached stops a smooth scroll where
       it is; `behavior: auto` is the documented way to do that and is honoured
       even where the reduced-motion kill-switch has forced scroll-behavior. */

    let gestureActive = false;
    let pullPending = false;

    /* Held back rather than dropped. A drag is a pause in the pull, not a
       refusal of it: the footer arriving during a drag is still the footer
       arriving, so the pull is carried out once the finger lifts. */
    const onGestureStart = () => {
      gestureActive = true;
      if (isMagnetized) window.scrollTo({ top: window.scrollY, left: window.scrollX, behavior: 'auto' });
    };

    const onGestureEnd = () => {
      gestureActive = false;
      if (!pullPending) return;
      pullPending = false;
      /* The gesture may have carried the footer back out of view, in which case
         pulling would now be pushing the reader somewhere they just left. And a
         lifted finger on a phone does not mean the page has stopped, so this
         goes through the same wait rather than pulling under the remaining
         coast. */
      if (isMagnetDisabled || isMagnetized || motionOff() || !linksOnScreen()) return;
      pullWhenStill();
    };

    // Captured on window so a gesture is seen before the carousel's own handlers
    // act on it, whatever part of the page it starts on.
    on(window, 'pointerdown', onGestureStart, { passive: true, capture: true });
    on(window, 'pointerup', onGestureEnd, { passive: true, capture: true });
    on(window, 'pointercancel', onGestureEnd, { passive: true, capture: true });
    /* A pointer released off the window sends no pointerup, which would leave the
       pull held back for good. Only a leave with nowhere to point at counts,
       though: moving the page under a finger that has not lifted sends
       pointerleave for whatever was under it, and being read as the end of the
       gesture that would drop the hold and let the pull through a live drag. */
    on(window, 'pointerleave', (e) => {
      if (!e.relatedTarget) onGestureEnd();
    }, { passive: true, capture: true });
    on(window, 'blur', onGestureEnd);

    /* Two observers, because two different things are being watched. The
       footer's own arrival drives the reveal, which should happen as soon as
       anything of the footer is on screen. The line at the bottom of the links
       drives the pull, which must wait for that line and not for the footer.

       The line is a hairline, so it is watched with a threshold of zero and the
       decision is made from where it actually is rather than from a ratio: a
       one-pixel target reports a ratio of one the moment a sliver of it appears,
       which would fire while the links were still mostly below the fold. */
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting || !trigger) return;
        trigger.classList.add('is-active');
      });
    }, { threshold: 0 });
    revealObserver.observe(footer);
    stoppers.push(() => revealObserver.disconnect());

    const magnetObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const arriving = entry.isIntersecting && !linksWereOnScreen;
        linksWereOnScreen = entry.isIntersecting;

        // The line going back off screen cancels a pull that was waiting on a
        // gesture, so a scroll upward does not leave one armed.
        if (!entry.isIntersecting) { pullPending = false; return; }

        if (isMagnetDisabled || isMagnetized || !userScrolled || !arriving) return;
        if (motionOff()) return;

        if (gestureActive) { pullPending = true; return; }
        pullWhenStill();
      });
    }, { threshold: 0 });
    if (linksEnd) magnetObserver.observe(linksEnd);
    stoppers.push(() => {
      magnetObserver.disconnect();
      clearTimeout(settleTimer);
    });
  }

  initFooterReveals();
  document.addEventListener('astro:after-swap', initFooterReveals);

  // Split the footer's info grid on the About, Services and News links in the
  // top nav, so New business starts under About, Legal under Services and
  // Follow us under News. The nav gaps are fluid, so the offsets are measured
  // rather than hard-coded.
  //
  // The Services link is measured from 768px rather than from 1024px, because on
  // a tablet it is the link the second column of the two-column grid hangs off.
  // It is kept under its own name there and also serves as --legal-left at
  // desktop, so neither width has to read a variable named for the other.
  function sizeFooterColumns() {
    const grid = document.querySelector('#site-footer .footer-info');
    if (!grid) return;
    const services = document.querySelector('#main-header a[href="/services"]');
    if (!services || window.innerWidth < 768) {
      grid.style.removeProperty('--services-left');
      grid.style.removeProperty('--about-left');
      grid.style.removeProperty('--legal-left');
      grid.style.removeProperty('--follow-left');
      return;
    }
    const g = grid.getBoundingClientRect();
    const servicesLeft = Math.round(services.getBoundingClientRect().left - g.left);
    grid.style.setProperty('--services-left', servicesLeft + 'px');
    // The other two links only matter to the four-column grid at 1024px and up.
    const about = document.querySelector('#main-header a[href="/info"]');
    const news = document.querySelector('#main-header a[href="/news"]');
    if (!about || !news || window.innerWidth < 1024) {
      grid.style.removeProperty('--about-left');
      grid.style.removeProperty('--legal-left');
      grid.style.removeProperty('--follow-left');
      return;
    }
    grid.style.setProperty('--about-left', Math.round(about.getBoundingClientRect().left - g.left) + 'px');
    grid.style.setProperty('--legal-left', servicesLeft + 'px');
    grid.style.setProperty('--follow-left', Math.round(news.getBoundingClientRect().left - g.left) + 'px');
  }

  if (!window.__dattFooterCols) {
    window.__dattFooterCols = true;
    window.addEventListener('resize', sizeFooterColumns, { passive: true });
    window.addEventListener('load', sizeFooterColumns);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(sizeFooterColumns);
  }
  sizeFooterColumns();
  document.addEventListener('astro:after-swap', sizeFooterColumns);
</script>
