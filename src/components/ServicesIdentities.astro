---
// src/components/ServicesIdentities.astro
const items = ["Brand strategy", "Positioning", "Naming", "Visual identity", "Art direction", "Guidelines"];
---

<section id="services-identities" class="relative w-full bg-black px-[var(--page-padding)] py-24 md:py-40 flex items-center overflow-hidden">
  <div class="w-full max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-[38%_1fr] items-start">

    <!-- Section Label -->
    <div class="mb-12 md:mb-0">
      <div class="brands-line-mask">
        <span class="brands-line-inner text-label text-white">IDENTITIES</span>
      </div>
    </div>

    <!-- Right Column -->
    <div class="flex flex-col items-start w-full">

      <h2 class="identities-title text-white mb-12 max-w-[600px]">
        <span class="brands-line-mask block">
          <span class="brands-line-inner block">Brands are recognised before they’re known.</span>
        </span>
      </h2>

      <div class="max-w-[600px] mb-12">
        <div class="brands-line-mask">
          <p class="brands-line-inner text-white/80" style="transition-delay: 0.1s;">
            We create identity systems that define how a brand looks, speaks, and behaves. Built for clarity, recognition, and consistency across every touchpoint.
          </p>
        </div>
      </div>

      <div class="mb-8">
        <div class="brands-line-mask">
          <p class="brands-line-inner text-label text-white/40" style="transition-delay: 0.2s;">Areas of work</p>
        </div>
      </div>

      <div class="w-full max-w-[700px] flex flex-col gap-y-[1px] mb-20">
        {items.map((item, i) => (
          <div class="brands-line-mask w-full">
            <div class="brands-line-inner w-full service-tile group" style={`transition-delay: ${0.3 + (i * 0.05)}s`}>
              <div class="py-5 px-6 transition-colors duration-300">
                <span class="text-white font-semibold group-hover:text-black transition-colors duration-300 uppercase text-[11px] tracking-[0.08em]">
                  {item}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- INVERTED CTA BLOCK -->
      <div class="brands-line-mask">
        <div class="brands-line-inner" style="transition-delay: 0.8s;">
          <a href="/contact" class="cta-link inverted-cta">
            Tell us about your project
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style is:global>
  #services-identities .identities-title {
    font-size: var(--font-h2);
    font-weight: 600;
    line-height: var(--lh-xtight);
    letter-spacing: var(--track-tighter);
  }

  /* FORCING CTA TO WHITE */
  #services-identities .cta-link.inverted-cta {
    color: #FFFFFF !important;
  }

  /* Ensuring the animated underline is also white */
  #services-identities .cta-link.inverted-cta::after {
    background-color: #FFFFFF !important;
  }

  /* TRANSITIONS (-60deg, 1.3s) */
  #services-identities .brands-line-mask {
    display: block;
    overflow: hidden;
    perspective: 1200px;
    padding-top: 0.2em;
    padding-bottom: 0.2em;
    margin-top: -0.2em;
    margin-bottom: -0.2em;
  }

  #services-identities .brands-line-inner {
    display: block;
    transform: translateY(115%) rotateX(-60deg);
    transform-origin: top center;
    opacity: 0;
    transition:
      transform 1.3s var(--ease-mechanical),
      opacity 0.9s var(--ease-mechanical),
      background-color 0.4s var(--ease-mechanical) !important;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  #services-identities.is-active .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }

  /* SERVICE TILE HOVER */
  #services-identities .service-tile {
    background-color: rgba(255, 255, 255, 0.08);
  }
  #services-identities .service-tile:hover {
    background-color: #FFFFFF !important;
    transform: none !important;
  }
</style>
