---
// HomeHero.astro
const headlineText = "We make brands || impossible to ignore. || Made to hold.";
const cleanHeadline = headlineText.split('||').map(t => t.trim()).join(' ');

const videoSrc = "/assets/DATT_STUDIO_REEL_2026.mp4";
const posterSrc = "/assets/video-poster-retina.webp";
---

<!-- 1. BACKGROUND HOVER VIDEO -->
<div id="hero-bg-video-container" class="fixed inset-0 z-0 opacity-0 pointer-events-none transition-opacity duration-1000 ease-[var(--ease-mechanical)]">
  <video
    id="hero-bg-video"
    muted
    loop
    playsinline
    preload="none"
    class="w-full h-full object-cover grayscale-[20%]"
  >
    <source src={videoSrc} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-black/10"></div>
</div>

<!-- 2. THE VIDEO PORTAL -->
<div id="hero-portal-node" role="dialog" aria-modal="true" aria-label="DATT STUDIO showreel" aria-hidden="true" inert class="fixed inset-0 z-[2000] opacity-0 pointer-events-none transition-opacity duration-700 ease-[var(--ease-mechanical)]">
    <!-- PORTAL CONTROLS -->
    <div id="hero-portal-controls" class="absolute inset-x-0 bottom-0 z-[200] opacity-0 pointer-events-none px-[var(--page-padding)] pb-12">
        <div class="flex items-end justify-between gap-4">
            <button id="hero-pause" type="button" class="portal-btn link-underline">PAUSE</button>
            <button id="hero-mute" type="button" class="portal-btn link-underline">UNMUTE</button>
            <button id="hero-close" type="button" class="portal-btn link-underline">CLOSE</button>
        </div>
    </div>

    <div id="hero-portal-flip" class="relative w-full h-full overflow-hidden bg-neutral-900 shadow-2xl z-[10] touch-none">
        <!-- CENTERED 16:9 FRAME -->
        <div id="portal-video-frame" class="portal-video-frame">
            <video id="portal-video" muted loop playsinline preload="none" class="portal-video-el" poster={posterSrc}>
                <source src={videoSrc} type="video/mp4" />
            </video>
        </div>
    </div>
</div>

<section id="hero-section" class="relative z-10 min-h-[100svh] flex flex-col justify-between px-[var(--page-padding)] pt-16 pb-[40px] bg-black transition-colors duration-1000 overflow-hidden">
  <div class="logo-area brands-line-mask w-full transition-all duration-800 ease-[var(--ease-mechanical)]">
    <div class="brands-line-inner w-full" role="img" aria-label="DATT STUDIO LOGO">
      <img src="/assets/datt_logo_l.svg" alt="DATT" width="2426" height="293" fetchpriority="high" class="hidden md:block w-full h-auto invert select-none pointer-events-none" />
      <img src="/assets/datt_logo_s.svg" alt="DATT" width="440" height="159" fetchpriority="high" class="block md:hidden w-full h-auto invert select-none pointer-events-none" />
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-[90%_1fr] items-start md:items-end">
    <div id="headline-wrapper" class="w-full">
      <h1 id="brands-text" class="hero-headline text-white" data-text={headlineText} aria-label={cleanHeadline}>
        {cleanHeadline}
      </h1>
    </div>
  </div>
</section>

<style is:global>
  :root { --ease-mechanical: cubic-bezier(0.19, 1, 0.22, 1); }

  .hero-headline {
    font-size: clamp(34px, 7.4vw, 64px);
    line-height: 1.05;
    letter-spacing: var(--track-tighter);
    font-weight: 600;
    display: flex;
    flex-direction: column;
  }

  .headline-line {
    display: block !important;
    width: fit-content;
    max-width: 100%;
    transition: opacity 0.8s var(--ease-mechanical), transform 0.8s var(--ease-mechanical);
  }

  /* --- SHARED UNDERLINE SYSTEM --- */
  .trigger-line, .link-underline {
    position: relative !important;
    display: inline-block !important;
    cursor: pointer;
    color: white !important;
  }

  .trigger-line::after, .link-underline::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: white;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.65s var(--ease-mechanical);
  }

  /* 1. Made to Hold: 4px weight, lifted a touch off the text so the rule does
     not sit flush against the descenders. */
  .trigger-line { padding-bottom: 9px; }
  .trigger-line::after { height: 4px; }

  /* "Made to hold." is a real button so it is reachable and operable from the
     keyboard. This reset keeps the headline typography and drops the native
     chrome, leaving the underline system untouched. */
  .trigger-button {
    appearance: none;
    -webkit-appearance: none;
    background: none;
    border: 0;
    margin: 0;
    padding: 0 0 9px;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-align: left;
    color: #fff !important;
  }

  /* 2. Video Control Buttons: 2px weight & Very Close */
  .link-underline { padding-bottom: 0.2px; }
  .link-underline::after { height: 0.2px; }

  /* --- REST STATE: underline present at rest, same as page CTAs --- */
  .trigger-line::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* --- ACTIVATION STATES --- */
  body.video-active .trigger-line::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* --- MADE TO HOLD CTA: same left-to-right underline flow as CTAs on hover --- */
  .trigger-line:hover::after {
    animation: global-underline-flow 0.8s var(--ease-mechanical) forwards;
  }

  /* --- MOBILE: always show the underline on "Made to hold." --- */
  @media (max-width: 767px) {
    .trigger-line::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .link-underline:hover::after {
    transform: scaleX(1) !important;
    transform-origin: left !important;
  }

  /* --- HOVER LAYOUT LOGIC --- */
  @media (hover: hover) and (pointer: fine) {
    body.video-active #hero-bg-video-container { opacity: 1 !important; }
    body.video-active #hero-section { background-color: transparent !important; }
    body.video-active .logo-area, body.video-active .headline-line:not(.has-trigger) {
      opacity: 0 !important;
      transform: translateY(-20px) rotateX(15deg);
    }
  }

  /* --- PORTAL LOGIC (FADE IN/OUT) --- */
  html.is-video-locked { overflow: hidden !important; height: 100% !important; touch-action: none; }

  #hero-portal-node {
    visibility: hidden;
    transition: opacity 0.7s var(--ease-mechanical), visibility 0s linear 0.7s;
  }
  #hero-portal-node.is-open {
    opacity: 1 !important;
    pointer-events: auto !important;
    visibility: visible;
    transition: opacity 0.7s var(--ease-mechanical), visibility 0s linear 0s;
  }
  #hero-portal-node.is-open #hero-portal-controls {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  /* --- PORTAL CONTROL BUTTONS (dedicated, no brand-line styling) --- */
  .portal-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.05em;
    line-height: 1.2;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px 0;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  #hero-portal-node .portal-btn {
    opacity: 0;
    transition: opacity 0.7s var(--ease-mechanical);
  }
  #hero-portal-node.is-open .portal-btn {
    opacity: 1 !important;
  }

  /* --- CENTERED 16:9 VIDEO FRAME (all screens) --- */
  .portal-video-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  /* Always span the full viewport width on any resize */
  width: 100vw;
  max-width: 100vw;
  height: auto;           /* height derived from width via the aspect ratio */
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #000;
  transform: translate(-50%, -50%) translateZ(0);
  will-change: transform;
  }

  .portal-video-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Force the media onto its own composited layer */
    transform: translateZ(0);
  }

  /* Mobile landscape: the short viewport makes a full-width wordmark dominate
     the screen, so it is held to half the width and `h-auto` keeps the ratio.

     That was not enough on its own. The headline is sized from the viewport
     *width*, and in landscape width is the long axis, so the clamp resolved from
     the long edge while the hero had to fit the short one. With `justify-between`
     there was no slack left to hand out: the gap between the wordmark and the H1
     collapsed to 0px on every phone-landscape size, and the hero overflowed the
     viewport.

     So on a short landscape screen both are sized from the short axis instead,
     and the gap is stated rather than left to the leftover. The `gap` is the
     floor: if the screen is shorter still, the words keep their distance from
     the logo instead of touching it. */
  @media (orientation: landscape) and (max-height: 520px) {
    /* The header is fixed and 80px tall. At 20px the wordmark started at y=17,
       sitting straight on top of the small nav logo. Match the portrait
       clearance so the wordmark arrives below the nav on the first frame. */
    #hero-section {
      padding-top: 64px;
      padding-bottom: 16px;
      gap: 12px;
    }
    .hero-headline { font-size: min(clamp(34px, 7.4vw, 64px), 11vh); }
    /* The full wordmark is far wider than the old compact mark, so cap it by
       height instead: at 34vh it collapsed to a 16px sliver in landscape. */
    .logo-area .brands-line-inner { max-width: min(50%, 100vh); }
  }
</style>

<script is:inline>
  function setupHomeHero() {
    const headline = document.getElementById('brands-text');
    const portal = document.getElementById('hero-portal-node');
    const portalVideo = document.getElementById('portal-video');
    const bgVideo = document.getElementById('hero-bg-video');

    if (!headline || !portal || !portalVideo || !bgVideo) return;

    // Autoplay policy: set muted via JS property, not just the attribute
    bgVideo.muted = true;
    portalVideo.muted = true;

    // Reduced motion, whether from the OS or the site's /accessibility/ toggle,
    // means the hero never starts a moving picture on its own - no warm-up, no
    // hover autoplay (the dim-away of the other lines is part of that motion).
    // Clicking "Made to hold." still opens the reel, because that is the reader
    // asking for it.
    const motionOff = () =>
      document.documentElement.classList.contains('user-reduced-motion') ||
      (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

    // Warm-start AFTER first paint (window load) so the video never
    // competes with the headline/fonts/poster for bandwidth
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !motionOff()) {
      const warmStart = () => {
        bgVideo.preload = 'auto';
        bgVideo.load();
        bgVideo.play().catch(() => {});
      };
      if (document.readyState === 'complete') { warmStart(); }
      else { window.addEventListener('load', warmStart, { once: true }); }
    }

    // 1. Split Text
    const parts = headline.getAttribute('data-text').split('||');
    headline.innerHTML = parts.map((t, i) => {
      const text = t.trim();
      const isTrigger = text.toLowerCase().includes("made to hold");
      const inner = isTrigger
        ? `<button type="button" class="brands-line-inner trigger-line trigger-button" style="transition-delay: ${i * 0.1}s">${text}</button>`
        : `<span class="brands-line-inner" style="transition-delay: ${i * 0.1}s; --ls-base: ${i * 0.1}s">${text}</span>`;
      return `<span class="brands-line-mask headline-line ${isTrigger ? 'has-trigger' : ''}">${inner}</span>`;
    }).join('');

    /* Route the hero through the same per-line splitter as every other
       component, so its plain segments reveal the same way the About hero
       does. The --ls-base on each non-trigger segment keeps the hero's own
       cascade (wordmark, then each line at 0.1s apart) once the splitter
       writes its per-line delays. dattSplitLines is idempotent, so the
       fonts-ready and resize replits later are safe. The .has-trigger
       segment never reaches the splitter (see lsShouldSkip), so its underline
       and this script's mouse bindings stay on the element they were written
       for. */
    const heroSection = document.getElementById('hero-section');
    if (window.dattSplitLines && heroSection) window.dattSplitLines(heroSection);

    const trigger = headline.querySelector('.trigger-line');
    let isFullscreen = false;

    // 2. Interaction
    if (trigger) {
        trigger.onmouseenter = () => {
            if (motionOff()) return;
            document.body.classList.add('video-active');
            bgVideo.play().catch(() => {});
        };
        trigger.onmouseleave = () => {
            if (motionOff()) return;
            if (!isFullscreen) {
                document.body.classList.remove('video-active');
                setTimeout(() => { if (!document.body.classList.contains('video-active')) bgVideo.pause(); }, 800);
            }
        };
        trigger.onclick = (e) => {
            e.preventDefault();
            isFullscreen = true;
            document.documentElement.classList.add('is-video-locked');

            portalVideo.muted = false;
            document.getElementById('hero-mute').innerText = "MUTE";
            portal.classList.add('is-open');
            portal.removeAttribute('inert');
            portal.removeAttribute('aria-hidden');

            if (portalVideo.readyState >= 1) {
                portalVideo.currentTime = bgVideo.currentTime;
            }
            portalVideo.play().catch(() => {});
            // The portal is a dialog, so focus follows it in. CLOSE is the
            // first control a keyboard user needs.
            document.getElementById('hero-close').focus();
        };
    }

    // 3. Control Actions
    document.getElementById('hero-close').onclick = () => {
      isFullscreen = false;
      document.documentElement.classList.remove('is-video-locked');
      document.body.classList.remove('video-active');
      portal.classList.remove('is-open');
      portal.setAttribute('aria-hidden', 'true');
      portal.setAttribute('inert', '');
      portalVideo.pause();
      bgVideo.pause();
      if (trigger) trigger.focus();
    };

    // Escape closes the reel from anywhere in the portal.
    if (!window.__dattHeroEscape) {
      window.__dattHeroEscape = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const p = document.getElementById('hero-portal-node');
        if (p && p.classList.contains('is-open')) {
          e.preventDefault();
          document.getElementById('hero-close')?.click();
        }
      });
    }

    // The portal is modal: keep Tab inside its three controls.
    if (!portal.__dattTrap) {
      portal.__dattTrap = true;
      portal.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        const items = Array.from(portal.querySelectorAll('button:not([disabled])'))
          .filter((el) => el.offsetWidth > 0 || el.offsetHeight > 0);
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }

    document.getElementById('hero-pause').onclick = (e) => {
        if (portalVideo.paused) { portalVideo.play().catch(() => {}); e.currentTarget.innerText = "PAUSE"; }
        else { portalVideo.pause(); e.currentTarget.innerText = "PLAY"; }
    };

    document.getElementById('hero-mute').onclick = (e) => {
        portalVideo.muted = !portalVideo.muted;
        e.currentTarget.innerText = portalVideo.muted ? "UNMUTE" : "MUTE";
    };
  }

  setupHomeHero();
  document.addEventListener('astro:after-swap', setupHomeHero);
</script>
