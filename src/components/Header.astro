---
// Header.astro
import { socialLinks } from '../data/social';
const { isInverted = false } = Astro.props;
---

<header id="main-header" class="fixed top-0 left-0 w-full z-[1000] px-[var(--page-padding)] pt-4 h-20">
  <!-- One nav row: the logo sits on the left margin, Contact hard against the
       right margin, and the rest spread with equal space between them. The equal
       gaps come from justify-between on this row, so the logo and the links are
       all direct children rather than split across two boxes. -->
  <nav aria-label="Primary" class:list={[
    "flex justify-between items-start w-full text-label",
    isInverted ? "text-white" : "text-black"
  ]}>
    <!-- LOGO: Uses Label weight/track but unique size -->
    <a href="/" class:list={[
      "nav-logo font-bold uppercase tracking-[0.05em] transition-colors duration-700 ease-in-out text-[18px] md:text-[14px]",
      isInverted ? "text-white" : "text-black"
    ]}>
      DATT STUDIO
    </a>

    <a href="/about/" class="desktop-nav-link hidden md:block">About</a>
    <a href="/services/" class="desktop-nav-link hidden md:block">Services</a>
    <a href="/news/" class="desktop-nav-link hidden md:block">News</a>
    <a href="/contact/" class="desktop-nav-link hidden md:block">Contact</a>

    <!-- MOBILE TOGGLE: Hooked into global .cta-link -->
    <button id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-overlay" class:list={[
      "md:hidden cta-link border-none bg-transparent cursor-pointer transition-colors duration-700 !text-[18px]",
      isInverted ? "text-white" : "text-black"
    ]}>
      MENU
    </button>
  </nav>
</header>

<!-- MOBILE OVERLAY -->
<div id="mobile-overlay" role="dialog" aria-modal="true" aria-label="Site menu" aria-hidden="true" class="fixed inset-0 z-[1100] hidden bg-black/95 backdrop-blur-[40px] flex-col px-[var(--page-padding)] pt-4 overflow-y-auto">
  <div class="flex justify-between items-start w-full text-white">
    <a href="/" class="font-bold uppercase text-[18px] md:text-[14px] tracking-[0.05em]">DATT STUDIO</a>
    <button id="menu-close" class="cta-link text-white border-none bg-transparent cursor-pointer !text-[18px]">CLOSE</button>
  </div>

  <nav aria-label="Mobile" class="flex flex-col items-stretch mt-9 gap-y-3">
    {[
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about/' },
      { label: 'Services', href: '/services/' },
      { label: 'News', href: '/news/' },
      { label: 'Contact', href: '/contact/' },
    ].map((link, i) => (
      <div class="brands-line-mask">
        <a
          href={link.href}
          class="brands-line-inner menu-link"
          style={`--ls-base: ${0.1 + (i * 0.1)}s; transition-delay: ${0.1 + (i * 0.1)}s`}
        >
          {link.label}
        </a>
      </div>
    ))}
  </nav>

  <!-- Social links: a secondary group pinned to the bottom of the screen. Kept
       tighter than the main menu (36px targets, 2px gaps) so it reads as one
       compact block rather than a second list. -->
  <div class="mt-auto pb-8 flex flex-col items-stretch gap-y-0.5">
    {socialLinks.map((social, i) => (
      <div class="brands-line-mask">
        <a
          href={social.href}
          class="brands-line-inner social-link"
          style={`--ls-base: ${0.7 + (i * 0.08)}s; transition-delay: ${0.7 + (i * 0.08)}s;`}
        >
          {social.label}
        </a>
      </div>
    ))}
  </div>
</div>

<style>
  /* Local color overrides only - transitions are handled by global classes */
  .desktop-nav-link { transition: color 0.4s var(--ease-mechanical); }
  .desktop-nav-link:hover { color: var(--studio-grey) !important; }

  /* TARGET SIZE: the nav labels are 20px tall. The padding extends the hit area
     to 28px without moving the text off the header baseline. */
  #main-header .nav-logo,
  #main-header .desktop-nav-link {
    padding-bottom: 8px;
  }
  #menu-toggle,
  #menu-close {
    min-height: 32px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    /* Same type treatment as the wordmark on the same line. Both were already
       18px, but the CTA defaults made them lighter and wider-tracked, so they
       read as a smaller control next to DATT STUDIO. */
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  /* MOBILE MENU TOUCH TARGETS
     Every row is a full-width 48px tap target with real space between rows, so
     a thumb cannot land on the neighbouring link. The label is set larger than
     the MENU toggle because the open menu is where the reading happens. */
  .menu-link {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 48px;
    font-size: 24px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    line-height: var(--lh-tight);
    letter-spacing: var(--track-tighter);
    transform-origin: center center;
    transition: color 0.4s var(--ease-mechanical);
  }
  .menu-link:hover { color: var(--studio-grey); }

  .social-link {
    display: flex;
    align-items: center;
    min-height: 36px;
    font-size: var(--font-label);
    font-weight: 600;
    text-decoration: none;
    color: var(--studio-grey);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    transform-origin: center center;
    transition: color 0.3s ease;
  }
  .social-link:hover { color: #ffffff !important; }

  /* OVERLAY FADE */
  #mobile-overlay {
    opacity: 0;
    transition: opacity 0.6s var(--ease-mechanical);
    pointer-events: none;
  }
  #mobile-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* INVERSION LOGIC */
  :global(body.video-active) .nav-logo,
  :global(body.page-dark) .nav-logo,
  :global(body.video-active) .desktop-nav-link,
  :global(body.page-dark) .desktop-nav-link,
  :global(body.video-active) #menu-toggle,
  :global(body.page-dark) #menu-toggle {
    color: #ffffff !important;
  }

  @media (min-width: 768px) { #menu-toggle { display: none !important; } }
</style>

<script is:inline>
  function initMobileMenu() {
    const overlay = document.getElementById('mobile-overlay');
    const toggle = document.getElementById('menu-toggle');
    const closeBtn = document.getElementById('menu-close');
    if (!overlay || !toggle || !closeBtn) return;

    function focusableItems() {
      return Array.from(
        overlay.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      ).filter((el) => el.offsetWidth > 0 || el.offsetHeight > 0);
    }

    function toggleMenu(show, restoreFocus = true) {
      if (show) {
        document.body.style.overflow = 'hidden';
        overlay.style.display = 'flex';
        overlay.removeAttribute('aria-hidden');
        toggle.setAttribute('aria-expanded', 'true');
        void overlay.offsetWidth; // Force reflow
        // Split now that the overlay is laid out and rects are measurable.
        // At load the overlay is display:none, so the splitter could not read
        // any line tops and left the menu on the block reveal.
        if (window.dattSplitLines) window.dattSplitLines(overlay);
        void overlay.offsetWidth; // Reflow the new masks before activating
        overlay.classList.add('is-active');

        // Trigger the global flip animation by adding .is-active to the children
        overlay.querySelectorAll('.brands-line-inner').forEach(el => {
          el.classList.add('is-active');
        });

        // The overlay is a dialog: keyboard focus goes to its first control.
        closeBtn.focus();
      } else {
        overlay.classList.remove('is-active');
        toggle.setAttribute('aria-expanded', 'false');
        // Reset the animation state for the next open
        overlay.querySelectorAll('.brands-line-inner').forEach(el => {
          el.classList.remove('is-active');
        });

        // Move focus out before hiding the dialog from assistive technology.
        if (restoreFocus) toggle.focus();
        overlay.setAttribute('aria-hidden', 'true');

        setTimeout(() => {
          if (!overlay.classList.contains('is-active')) {
            overlay.style.display = 'none';
            document.body.style.overflow = '';
          }
        }, 600);
      }
    }

    toggle.onclick = () => toggleMenu(true);
    closeBtn.onclick = () => toggleMenu(false);

    overlay.querySelectorAll('a').forEach(link => {
      // Let the navigation happen; do not pull focus back to the toggle first.
      link.onclick = () => toggleMenu(false, false);
    });

    if (!overlay.__dattMenuKeys) {
      overlay.__dattMenuKeys = true;
      overlay.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          toggleMenu(false);
          return;
        }
        if (e.key !== 'Tab') return;

        const items = focusableItems();
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }
  }

  // Initialize
  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
