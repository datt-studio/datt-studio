---
// HomeStudio.astro
const title = "A creative studio for brands built to last.";
const body = "Work shaped through clarity, restraint, and careful execution. Built to be recognised. Designed to endure.";

// Awards listed verbatim. No dates, scores or vote counts here: this block is a
// short list of what was recognised, and the articles under /news/ carry the
// detail. Each row carries its own image, so the row and its picture can never
// fall out of step.
const recognition = [
  // { label: "X1 Awwwards — Honorable Mention", image: "/news/awwwards.webp" },
  { label: "X1 CSSDA Special Kudos — Voted by Public Best UI, UX & Innovation", image: "/news/cssda-awards.webp" },
  { label: "X1 CSS Winner — Site Of The Day", image: "/news/csswinner-sotd.webp" },
];
---

<section class="home-studio reveal-trigger relative w-full min-h-[100svh] px-[var(--page-padding)] flex flex-col items-start justify-center text-left bg-black py-24">
  <div class="home-studio-grid w-full grid grid-cols-1 lg:justify-between gap-y-20 lg:gap-y-0">

    <div class="w-full">

      <!-- 1. Headline -->
      <div class="brands-line-mask mb-12">
        <h2 class="brands-line-inner text-white" style="transition-delay: 0.1s;">
          {title}
        </h2>
      </div>

      <!-- 2. Body -->
      <div class="max-w-[500px] mb-10">
          <div class="brands-line-mask">
              <p class="brands-line-inner text-white/80" style="transition-delay: 0.4s;">
                {body}
              </p>
          </div>
      </div>

      <!-- 3. CTA -->
      <div class="brands-line-mask inline-block">
          <div class="brands-line-inner" style="transition-delay: 0.6s">
            <a href="/about/" class="cta-link inverted-cta">
              About the studio
            </a>
          </div>
      </div>

    </div>

    <!-- 4. Recognition: right of the copy on desktop, below it on mobile.
         Each cell holds a .recognition-card. On desktop the card collapses to
         display: contents, so the row is a plain label with a rule under it and
         the image follows the cursor. Below 1024px, or on touch, the card
         becomes a stacked image card.

         Only ONE element owns the divider at any width:
           desktop  .recognition-row        (border-bottom)
           mobile   .recognition-card-label (border-bottom), with the inner
                    .recognition-row stripped of its own border and padding. -->
    <div class="brands-line-mask recognition-reveal w-full">
      <div class="brands-line-inner" style="transition-delay: 0.2s;">
        <table class="home-studio-table">
          <thead>
            <tr>
              <th scope="col">Recognition</th>
            </tr>
          </thead>
          <tbody>
            {recognition.map((item, idx) => (
              <tr data-recognition-index={idx}>
                <td>
                  <div class="recognition-card">
                    <div class="recognition-card-label">
                      <div class="recognition-row">
                        <span class="recognition-row-label">{item.label}</span>
                      </div>
                    </div>
                    <div class="recognition-card-media" aria-hidden="true">
                      <div class="recognition-card-flip">
                        <img src={item.image} alt="" loading="lazy" decoding="async" />
                      </div>
                      <div class="recognition-card-curtain"></div>
                    </div>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- The recognition preview, desktop with a pointer only. One fixed,
       pointer-events-none node follows the cursor. Layers crossfade so the image
       changes without cutting. -->
  <div id="recognition-image-node" class="pointer-events-none fixed top-0 left-0 z-[1200] w-[320px] aspect-video opacity-0 transition-opacity duration-500">
    <div id="recognition-image-flip" class="relative w-full h-full overflow-hidden bg-neutral-900 shadow-2xl">
      {recognition.map((item, i) => (
        <div class="recognition-image-layer absolute inset-0 opacity-0 transition-opacity duration-500" data-index={i}>
          <img src={item.image} alt="" loading="eager" decoding="async" class="h-full w-full object-cover" />
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* --- TYPOGRAPHY SYSTEM SYNC --- */

  .home-studio h1 {
    font-size: var(--font-h1);
    font-weight: 600;
    line-height: 1.0 !important;
    letter-spacing: var(--track-tighter) !important;
    margin: 0;
    text-transform: none;
  }

  .home-studio p {
    font-size: clamp(18px, 3vw, 16px);
    font-weight: 400;
    line-height: 1.5 !important;
    letter-spacing: var(--track-tight);
    margin: 0;
  }

  /* --- REVEAL ENGINE SYNC --- */

  .home-studio .brands-line-mask {
    display: block;
    overflow: hidden;
    perspective: 1200px;
    padding-top: 0.1em;
    padding-bottom: 0.15em;
  }

  .home-studio .brands-line-inner {
    display: block;
    transform: translateY(115%) rotateX(-60deg);
    transform-origin: top center;
    opacity: 0;
    transition: transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical);
    will-change: transform, opacity;
  }

  .home-studio.is-active .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }

  /* The divider. Desktop owner: this element and nothing else. */
  .recognition-row {
    display: block;
    padding: 0.9em 1em 0.9em 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .home-studio-table tbody tr:last-child .recognition-row {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .recognition-row-label {
    display: inline-block;
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--font-label);
    line-height: 1.4;
    letter-spacing: var(--track-tight);
  }

  /* --- CTA SYSTEM SYNC --- */

  .home-studio .cta-link.inverted-cta {
    color: #FFFFFF !important;
    font-size: var(--font-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    padding-bottom: 6px;
  }

  .home-studio .cta-link.inverted-cta::after {
    background-color: #FFFFFF !important;
    height: 1.5px;
  }

  /* --- RECOGNITION LAYOUT ---
     Desktop with a real pointer: two columns, the table's left edge anchored
     to the Services link in the nav. --recognition-width is measured at
     runtime, with a 400px fallback. Gated on hover as well as width so the
     grid and the mobile card stack never disagree. */
  @media (min-width: 1024px) and (hover: hover) {
    .home-studio .home-studio-grid {
      grid-template-columns: minmax(0, 580px) minmax(0, var(--recognition-width, 400px));
    }
    .home-studio .home-studio-grid > .brands-line-mask {
      width: var(--recognition-width, 400px);
    }
  }

  /* --- RECOGNITION TABLE --- */

  .home-studio-table {
    width: 100%;
    border-collapse: collapse;
    color: #ffffff;
    margin: 0;
    font-size: var(--font-label);
    letter-spacing: var(--track-tight);
  }

  .home-studio-table th,
  .home-studio-table td {
    text-align: left;
    padding: 0;
    border-bottom: none;
    vertical-align: top;
  }

  .home-studio-table th {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    font-size: var(--font-label);
    color: rgba(255, 255, 255, 0.62);
  }

  .home-studio-table th:last-child,
  .home-studio-table td:last-child { padding-right: 0; }

  .home-studio-table tbody tr td {
    border-bottom: none !important;
    padding: 0;
  }

  .home-studio-table tbody tr {
    border-bottom: none;
  }

  .home-studio-table tbody tr:last-child {
    border-bottom: 0;
  }

  .home-studio-table tbody tr:last-child td {
    border-bottom: 0 !important;
    padding-bottom: 0;
  }

  /* The splitter wraps each cell's text in a mask. Inside a table cell the
     descender padding would push the row borders apart unevenly. */
  .home-studio-table .brands-line-mask {
    padding-top: 0;
    padding-bottom: 0;
    overflow: visible;
  }

  /* --- RECOGNITION HOVER PREVIEW (desktop) ---
     The clip-free version of the same flip-and-follow behaviour. The image
     flips up on the first hover; layers crossfade, so sliding from one award
     row to the next changes the image smoothly rather than cutting. */
  #recognition-image-node { perspective: 900px; }
  #recognition-image-flip {
    transform: translateY(40%) rotateX(-60deg);
    transform-origin: bottom center;
    transition: transform 1.1s var(--ease-mechanical), opacity 0.5s ease;
  }
  #recognition-image-node.is-visible #recognition-image-flip {
    transform: translateY(0) rotateX(0deg);
  }
  .recognition-image-layer.is-active { opacity: 1 !important; z-index: 10; }

  /* --- RECOGNITION CARD ---
     Desktop: the card and its label collapse to nothing, so the row reads as a
     plain label with a rule under it. The card's image is never shown, and being
     lazy and display: none it is never fetched. */
  .recognition-card { display: contents; }
  .recognition-card-label { display: contents; }
  .recognition-card-media { display: none; }

  /* --- RECOGNITION ON TOUCH / NARROW SCREENS ---
     The table stays a table. The card stack and its image flip were measured
     against a viewport whose short axis changes on rotation, and on a phone the
     sticky rows and the reveal transform fought each other. The media is now
     never shown or fetched here: the desktop pointer preview keeps the images,
     and a touch screen gets the labels and their rules only. */
  @media (max-width: 1023px), (hover: none) {
    .home-studio .recognition-reveal {
      overflow: clip;
      padding-top: 0;
    }

    .home-studio .home-studio-grid { row-gap: 5rem; }

    .home-studio-table { border-collapse: separate; border-spacing: 0; }
    .home-studio-table thead th {
      position: relative;
      z-index: 4;
      background: #000;
      padding: 0 0 0.75em 0;
    }
    .home-studio-table tbody td {
      padding: 0;
      border-bottom: 0;
      background: #000;
    }

    /* The row copy is the same size as the body copy beside it. The --font-label
       step is a caption size, which read as too small on a phone. */
    .recognition-row-label {
      font-size: clamp(18px, 3vw, 16px);
      line-height: var(--lh-body);
      letter-spacing: var(--track-tight);
    }
  }

  /* The cursor node is not used below 1024px or without a pointer. */
  @media (max-width: 1023px), (hover: none) {
    #recognition-image-flip {
      transition: transform 0.42s var(--ease-mechanical), opacity 0.3s ease;
    }
  }

  /* Reduced motion keeps the preview and drops the flip. */
  @media (prefers-reduced-motion: reduce) {
    #recognition-image-flip { transition: none !important; }
  }

  /* Spacing Helper */
  .mb-14 { margin-bottom: 60px; }
  .mb-12 { margin-bottom: 48px; }

  @media (max-width: 768px) {
    .mb-14 { margin-bottom: 40px; }
    .mb-12 { margin-bottom: 32px; }
  }
</style>

<script is:inline>
  // The hover node and the table rows are looked up on each event rather than
  // captured once, so the script survives the node being replaced and view swaps.
  function setupRecognitionPreview() {
    if (window.__dattRecognitionBound) return;
    window.__dattRecognitionBound = true;

    /* Only a desktop pointer gets the preview. Narrow windows and touch screens
       read the table as a table, so there is no scroll state to keep in sync. */
    const isDesktop = () =>
      window.innerWidth >= 1024 &&
      !(window.matchMedia && window.matchMedia('(hover: none)').matches);

    const node = () => document.getElementById('recognition-image-node');

    const motionOff = () =>
      document.documentElement.classList.contains('user-reduced-motion') ||
      (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

    // Declared up here so every handler below can reach them regardless of
    // declaration order.
    let tX = window.innerWidth / 2, tY = window.innerHeight / 2;
    let cX = tX, cY = tY;
    let followRaf = 0;
    let nodeW = 0, nodeH = 0;

    const show = () => {
      const n = node();
      if (!n) return;
      // First show: start at the cursor, not at the screen centre.
      if (!n.classList.contains('is-visible')) { cX = tX; cY = tY; }
      n.classList.add('is-visible');
      n.style.opacity = '1';
      nodeW = n.offsetWidth || 0;
      nodeH = n.offsetHeight || 0;
      // Place it immediately so there is no frame at the old position.
      n.style.transform = `translate3d(${cX - nodeW / 2}px, ${cY - nodeH / 2}px, 0)`;
      startFollow();
    };

    const hide = () => {
      const n = node();
      if (!n) return;
      n.classList.remove('is-visible');
      n.style.opacity = '0';
      stopFollow();
    };

    const setLayers = (index) => {
      const n = node();
      if (!n) return;
      n.querySelectorAll('.recognition-image-layer').forEach((layer, i) => {
        layer.classList.toggle('is-active', i === index);
      });
    };

    /* --- CURSOR: hover a row, the image follows the pointer --- */

    const open = (index) => {
      if (!isDesktop()) return;
      setLayers(index);
      show();
    };

    const close = () => {
      if (!isDesktop()) return;
      hide();
    };

    const rowOf = (target) =>
      target instanceof Element ? target.closest('.home-studio-table tbody tr') : null;

    // mouseover bubbles where mouseenter does not, so one document listener
    // covers the rows however many times the table is rewritten.
    document.addEventListener('mouseover', (e) => {
      const row = rowOf(e.target);
      if (!row) return;
      tX = e.clientX; tY = e.clientY;
      open(Number(row.dataset.recognitionIndex || 0));
    }, { passive: true });

    document.addEventListener('mouseout', (e) => {
      const row = rowOf(e.target);
      const to = e.relatedTarget;
      // Moving onto another row keeps the preview open (its mouseover swaps the
      // layer). Leaving the body, e.g. onto the column head, closes it.
      const stillInside = to instanceof Element && !!to.closest('.home-studio-table tbody');
      if (row && !stillInside) close();
    }, { passive: true });

    window.addEventListener('mousemove', (e) => { tX = e.clientX; tY = e.clientY; }, { passive: true });

    function follow() {
      followRaf = 0;
      const n = node();
      if (n && isDesktop() && !motionOff() && n.classList.contains('is-visible')) {
        cX += (tX - cX) * 0.15;
        cY += (tY - cY) * 0.15;
        n.style.transform = `translate3d(${cX - nodeW / 2}px, ${cY - nodeH / 2}px, 0)`;
        followRaf = requestAnimationFrame(follow);
      }
    }
    function startFollow() {
      if (followRaf) return;
      followRaf = requestAnimationFrame(follow);
    }
    function stopFollow() {
      if (followRaf) { cancelAnimationFrame(followRaf); followRaf = 0; }
    }

    /* A resize into a touch layout takes the preview away with it. */
    window.addEventListener('resize', () => { if (!isDesktop()) hide(); }, { passive: true });
  }

  setupRecognitionPreview();
  document.addEventListener('astro:after-swap', setupRecognitionPreview);

  // Keep the recognition table's left edge on the Services link in the top nav.
  function sizeRecognitionTable() {
    const grid = document.querySelector('.home-studio-grid');
    const copy = grid ? grid.firstElementChild : null;
    const link = document.querySelector('#main-header a[href="/services/"]');
    if (!grid || !copy || !link) return;
    const wide = window.innerWidth >= 1024 &&
      !(window.matchMedia && window.matchMedia('(hover: none)').matches);
    if (!wide) {
      grid.style.removeProperty('--recognition-width');
      return;
    }
    const g = grid.getBoundingClientRect();
    const c = copy.getBoundingClientRect();
    const s = link.getBoundingClientRect();
    // Never overlap the copy, even if the Services link sits further left.
    const left = Math.max(s.left - g.left, c.right - g.left);
    const width = Math.max(200, Math.round(g.width - left));
    grid.style.setProperty('--recognition-width', `${width}px`);
  }

  if (!window.__dattRecognitionSized) {
    window.__dattRecognitionSized = true;
    window.addEventListener('resize', sizeRecognitionTable, { passive: true });
    window.addEventListener('load', sizeRecognitionTable);
  }
  document.addEventListener('astro:after-swap', sizeRecognitionTable);
  sizeRecognitionTable();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(sizeRecognitionTable);

  /* Debug overlay: only runs with ?dbg=1. Draws the card state, curtain and flip
     positions, running transitions and fps over the page, for reading back off a
     real phone. */
  (function recognitionDebug() {
    if (!/(^|[?&])dbg(&|=|$)/.test(location.search)) return;

    const panel = document.createElement('pre');
    panel.style.cssText = 'position:fixed;top:0;left:0;z-index:2147483647;margin:0;' +
      'padding:6px 8px;background:rgba(0,0,0,.85);color:#7cfc00;' +
      'font:11px/1.4 ui-monospace,Menlo,monospace;white-space:pre-wrap;word-break:break-all;' +
      'pointer-events:none;max-width:100vw';
    const mount = () => { if (!panel.isConnected && document.body) document.body.appendChild(panel); };
    mount();
    window.addEventListener('DOMContentLoaded', mount);

    let frames = 0;
    let fps = 0;
    let marked = performance.now();
    (function count(now) {
      frames++;
      if (now - marked >= 1000) {
        fps = Math.round((frames * 1000) / (now - marked));
        frames = 0;
        marked = now;
      }
      requestAnimationFrame(count);
    })(marked);

    const supports = (v, x) => (window.CSS && CSS.supports ? (CSS.supports(v, x) ? 1 : 0) : '?');
    const floor = 'svh:' + supports('height', '100svh') +
      ' clip:' + supports('overflow', 'clip') +
      ' has:' + supports('selector(:has(*))');

    const moved = (el) => {
      if (!el) return '-';
      const t = getComputedStyle(el).transform;
      if (t === 'none') return 'id';
      const m3 = t.indexOf('matrix3d(') === 0;
      const p = (m3 ? t.slice(9, -1) : t.slice(7, -1)).split(',');
      const tx = Math.round(m3 ? +p[12] : +p[4]);
      const ty = Math.round(m3 ? +p[13] : +p[5]);
      return 't(' + tx + ',' + ty + ')';
    };

    const openPct = (el) => {
      if (!el || !el.offsetHeight) return '-';
      const t = getComputedStyle(el).transform;
      if (t === 'none') return '0%';
      const m3 = t.indexOf('matrix3d(') === 0;
      const p = (m3 ? t.slice(9, -1) : t.slice(7, -1)).split(',');
      const ty = m3 ? +p[13] : +p[5];
      return Math.round((ty / el.offsetHeight) * 100) + '%';
    };

    const rect = (el) => {
      if (!el) return '-';
      const r = el.getBoundingClientRect();
      return Math.round(r.top) + '/' + Math.round(r.height);
    };

    const update = () => {
      if (!panel.isConnected || !document.body) return;
      const first = document.querySelector('.home-studio-table tbody tr');
      const line = first ? Math.round(parseFloat(getComputedStyle(first).top) || 0) : '?';
      const reveal = document.querySelector('.recognition-reveal .brands-line-inner');
      let s = 'dpr ' + devicePixelRatio + ' vp ' + innerWidth + 'x' + innerHeight +
        ' [' + floor + ']\n';
      s += 'fps ' + fps + ' scroll ' + Math.round(scrollY) + ' line ' + line +
        ' reveal ' + (reveal ? moved(reveal) : '-') + '\n';
      document.querySelectorAll('.home-studio-table tbody tr').forEach((row, i) => {
        const card = row.querySelector('.recognition-card');
        if (!card) return;
        const img = card.querySelector('img');
        const flags = (card.classList.contains('is-active') ? 'A' : '-') +
          (card.classList.contains('is-hidden') ? 'H' : '-') +
          (card.classList.contains('is-instant') ? 'I' : '-');
        const top = Math.round(row.getBoundingClientRect().top);
        s += 'c' + i + ' ' + (top === line ? 'PIN' : 'row' + top) + ' [' + flags + ']' +
          ' cur ' + openPct(card.querySelector('.recognition-card-curtain')) +
          ' flip ' + moved(card.querySelector('.recognition-card-flip')) +
          ' med ' + rect(card.querySelector('.recognition-card-media')) +
          ' img ' + (img ? (img.complete && img.naturalWidth ? 'ok' : 'wait') : '-') + '\n';
      });
      panel.textContent = s;
    };
    update();
    setInterval(update, 200);
  })();
</script>
