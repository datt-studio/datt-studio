---
// HomeServices.astro
const items = [
  { title: "Identity", video: "/assets/DS_OFFERINGS_1.mp4", slug: "services-identities" },
  { title: "Systems", video: "/assets/DS_OFFERINGS_2.mp4", slug: "services-systems" },
  { title: "Digital", video: "/assets/DS_OFFERINGS_3.mp4", slug: "services-digital" }
];
---


<section id="services-interactive-node" class="relative min-h-[100svh] w-full bg-black flex flex-col justify-between px-[var(--page-padding)] py-12 md:py-20 overflow-hidden">
  <div class="h-12"></div>


  <!-- 1. Interaction Nav -->
  <div id="nav-container-node" class="relative z-20 flex-grow flex items-center justify-center transition-opacity duration-500">
    <nav class="flex flex-col items-center gap-y-0 w-full pb-24 md:pb-16">
      {items.map((item, index) => (
        <div class="hs-cube-reveal-mask pb-12 mb-[-3rem]">
          <button
            type="button"
            class="hs-cube-reveal-inner service-nav-item-node relative uppercase"
            data-index={index}
            data-slug={item.slug}
            style={`transition-delay: ${index * 0.1}s`}
          >
            {item.title}
          </button>
        </div>
      ))}
    </nav>
  </div>


  <!-- 2. THE VIDEO PORTAL -->
  <div id="cursor-video-node" aria-hidden="true" inert class="pointer-events-none fixed top-0 left-0 z-[1200] w-[600px] aspect-[16/9] opacity-0 transition-opacity duration-500">


    <!-- MOBILE CONTROLS (Top Layer) -->
    <button id="mobile-x-node" type="button" class="mobile-close-btn md:hidden" aria-label="Close video">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
        <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
      </svg>
    </button>

    <div id="mobile-video-controls" class="mobile-controls md:hidden absolute bottom-4 left-4 z-[200] opacity-0 pointer-events-none">
      <div class="mobile-controls-bar">
        <button id="mobile-pause-node" type="button" class="mobile-control-btn" aria-label="Pause video">
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true" focusable="false">
            <rect x="1" y="1" width="4" height="12"/>
            <rect x="9" y="1" width="4" height="12"/>
          </svg>
          <svg class="icon-play" width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true" focusable="false" style="display:none">
            <path d="M2 1.5L12 7L2 12.5V1.5Z"/>
          </svg>
        </button>
        <span id="mobile-timer-node" class="mobile-timer" aria-live="off">00:00 / 00:00</span>
        <button id="mobile-mute-node" type="button" class="mobile-control-btn" aria-label="Mute video">
          <svg class="icon-sound" width="16" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M1 4.5H4L8 1V13L4 9.5H1V4.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M11 4.5C11.8 5.3 12.2 6.1 12.2 7C12.2 7.9 11.8 8.7 11 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            <path d="M13.5 2.5C14.8 3.8 15.5 5.3 15.5 7C15.5 8.7 14.8 10.2 13.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          </svg>
          <svg class="icon-muted" width="16" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true" focusable="false" style="display:none">
            <path d="M1 4.5H4L8 1V13L4 9.5H1V4.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M12 5L16 9M16 5L12 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          </svg>
        </button>
      </div>
    </div>


    <!-- Draggable Video Wrapper -->
    <div id="video-flip-node" class="relative w-full h-full overflow-hidden bg-neutral-900 shadow-2xl z-[10] touch-none">
        {items.map((item, index) => (
          <div class="layer-node absolute inset-0 opacity-0 transition-opacity duration-500" data-index={index}>
            <video muted loop playsinline preload="none" class="h-full w-full object-cover">
                <source src={item.video} type="video/mp4" />
            </video>
          </div>
        ))}
    </div>
  </div>


  <!-- 3. BOTTOM CTA AREA -->
  <div id="cta-wrap-node" class="relative z-30 flex justify-center w-full pb-4 transition-opacity duration-500 mix-blend-difference">
    <div class="hs-cube-reveal-mask">
        <a href="/services/" class="cta-link inverted-cta hs-cube-reveal-inner text-white" style="transition-delay: 0.5s">
          View Services
        </a>
    </div>
  </div>
</section>


<style is:global>
  /* 1. TYPOGRAPHY & THICK UNDERLINES */
  .link-underline { position: relative; display: inline-block; }
  .link-underline::after {
    content: ''; position: absolute; bottom: -4px; left: 0; width: 100%; height: 3px;
    background-color: currentColor; transform: scaleX(1); transform-origin: left;
    transition: transform 0.6s var(--ease-mechanical);
  }
  .link-underline.animate-flow::after { animation: global-underline-flow 0.8s var(--ease-mechanical) forwards; }


  /* 2. REVEAL ENGINE
     The transition must stay non-important: the per-line splitter writes each
     generated line's stagger as an inline transition-delay, and an !important
     transition shorthand here would override every inline delay on the homepage
     and collapse the line-by-line cascade back into one block reveal. */
  .hs-cube-reveal-mask, .brands-line-mask { display: block; overflow: hidden; perspective: 1200px; }
  .hs-cube-reveal-inner, .brands-line-inner {
    display: block; opacity: 0 !important;
    transform: translateY(115%) rotateX(-60deg) !important;
    transform-origin: top center !important;
    transition: transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical);
  }
  #services-interactive-node.is-active .hs-cube-reveal-inner,
  #cursor-video-node.is-fullscreen .brands-line-inner {
    opacity: 1 !important; transform: translateY(0) rotateX(0deg) !important;
  }


  /* 3. NAV STYLING */
  .service-nav-item-node {
    font-size: clamp(72px, 12vw, 140px); font-weight: 600; line-height: 0.8 !important;
    letter-spacing: var(--track-tighter); color: rgba(255, 255, 255, 0.4);
    /* The reveal transition is repeated alongside the hover color, because this
       class is declared after .hs-cube-reveal-inner and its shorthand would
       otherwise swallow the transform/opacity reveal on these buttons. */
    transition: color 0.5s var(--ease-mechanical), transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical); background: transparent; border: none; cursor: pointer; padding: 0.1em 0; width: 100%;
  }
  .service-nav-item-node.is-active-hover { color: #fff !important; mix-blend-mode: difference; }


  /* 4. VIDEO & DRAG LOGIC */
  .layer-node.is-active { opacity: 1 !important; z-index: 10; }
  #video-flip-node {
    transform: translateY(40%) rotateX(-60deg); transform-origin: bottom center;
    transition: transform 1.3s var(--ease-mechanical), opacity 0.5s ease;
  }
  #video-flip-node.is-dragging { transition: none !important; }
  #cursor-video-node.is-visible #video-flip-node:not(.is-dragging) {
    transform: translateY(0) rotateX(0deg) !important;
  }


  /* 5. FULLSCREEN STATE (MOBILE) — 16:9 centered, controls pinned to viewport bottom */
  #services-interactive-node.is-video-open { z-index: 1200; perspective: none !important; }
  #cursor-video-node.is-fullscreen {
    pointer-events: auto !important;
    width: 100vw !important;
    height: 100svh !important;
    top: 0 !important;
    left: 0 !important;
    opacity: 1 !important;
    transform: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: #000 !important;
    z-index: 10010 !important;
  }
  #cursor-video-node.is-fullscreen #video-flip-node {
    width: 100vw !important;
    max-width: 100vw !important;
    height: auto !important;
    aspect-ratio: 16 / 9;
    flex: 0 0 auto;
  }
  /* MOBILE FULLSCREEN CONTROLS */
  .mobile-close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 220;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-mechanical), color 0.4s var(--ease-mechanical);
  }
  .mobile-close-btn::before {
    content: '';
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.45);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .mobile-close-btn svg { position: relative; z-index: 1; }
  .mobile-close-btn:hover { color: #808080; }
  .mobile-close-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  .mobile-controls { transition: opacity 0.4s var(--ease-mechanical); }
  .mobile-controls-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    background: rgba(10, 10, 10, 0.45);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
  }
  .mobile-control-btn {
    appearance: none;
    background: transparent;
    border: none;
    color: #fff;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    margin: -10px;
    transition: color 0.4s var(--ease-mechanical);
  }
  .mobile-control-btn:hover { color: #808080; }
  .mobile-control-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .mobile-timer {
    color: #b4b4b4;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    min-width: 90px;
    text-align: center;
  }
  #cursor-video-node.is-fullscreen .mobile-close-btn.controls-visible,
  #cursor-video-node.is-fullscreen .mobile-controls.controls-visible {
    opacity: 1 !important;
    pointer-events: auto !important;
  }


  #services-interactive-node.is-video-open #nav-container-node,
  #services-interactive-node.is-video-open #cta-wrap-node { opacity: 0 !important; }


  /* 6. CTA INVERTED STYLE */
  #services-interactive-node .cta-link.inverted-cta {
    color: #FFFFFF !important;
    /* Re-declared so the reveal transition survives: .cta-link's own shorthand
       (also non-important) would otherwise override the transform/opacity
       reveal on this element and make it snap in instead of turning up. */
    transition: color 0.4s var(--ease-mechanical), transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical);
  }
  #services-interactive-node .cta-link.inverted-cta::after { background-color: #FFFFFF !important; }


  html.is-video-locked { overflow: hidden !important; overscroll-behavior: none; }
</style>


<script is:inline>
  function setupInteractiveServices() {
    const section = document.getElementById('services-interactive-node');
    const cursorVideo = document.getElementById('cursor-video-node');
    const videoFlip = document.getElementById('video-flip-node');
    const navItems = document.querySelectorAll('.service-nav-item-node');
    const layers = document.querySelectorAll('.layer-node');
    const mobileX = document.getElementById('mobile-x-node');
    const mobilePause = document.getElementById('mobile-pause-node');
    const mobileMute = document.getElementById('mobile-mute-node');
    const mobileControls = document.getElementById('mobile-video-controls');
    const mobileTimer = document.getElementById('mobile-timer-node');


    if (!section || !cursorVideo) return;

    // Site-wide reduced motion, from the OS or the /accessibility/ toggle:
    // hovering a service no longer starts the clip preview. Clicking one still
    // opens the full model on mobile, because that is the reader asking for it.
    const motionOff = () =>
      document.documentElement.classList.contains('user-reduced-motion') ||
      (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);


    let isFullscreen = false;
    let opener = null;
    let dStartX = 0, dStartY = 0, isDragging = false;
    let mobileHideTimer;

    const fmtTime = (s) => {
      if (!Number.isFinite(s) || s < 0) s = 0;
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
    };
    const getActiveVideo = () => Array.from(layers).find(l => l.classList.contains('is-active'))?.querySelector('video');
    const updateMobileTimer = () => {
      const v = getActiveVideo();
      if (!mobileTimer) return;
      mobileTimer.textContent = fmtTime(v?.currentTime || 0) + ' / ' + fmtTime(v?.duration);
    };
    const syncMobilePauseIcon = () => {
      const v = getActiveVideo();
      if (!mobilePause) return;
      const paused = !v || v.paused;
      mobilePause.querySelector('.icon-pause').style.display = paused ? 'none' : '';
      mobilePause.querySelector('.icon-play').style.display = paused ? '' : 'none';
      mobilePause.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
    };
    const syncMobileMuteIcon = () => {
      const v = getActiveVideo();
      if (!mobileMute) return;
      const muted = !v || v.muted;
      mobileMute.querySelector('.icon-sound').style.display = muted ? 'none' : '';
      mobileMute.querySelector('.icon-muted').style.display = muted ? '' : 'none';
      mobileMute.setAttribute('aria-label', muted ? 'Unmute video' : 'Mute video');
    };
    const showMobileControls = () => {
      if (!isFullscreen) return;
      mobileControls?.classList.add('controls-visible');
      mobileX?.classList.add('controls-visible');
      clearTimeout(mobileHideTimer);
      mobileHideTimer = setTimeout(() => {
        if (!isFullscreen) return;
        const hovering = mobileControls?.matches(':hover') || mobileX?.matches(':hover');
        if (hovering) { showMobileControls(); return; }
        mobileControls?.classList.remove('controls-visible');
        mobileX?.classList.remove('controls-visible');
      }, 3000);
    };
    const hideMobileControls = () => {
      clearTimeout(mobileHideTimer);
      mobileControls?.classList.remove('controls-visible');
      mobileX?.classList.remove('controls-visible');
    };

    // --- VIDEO CONTROL FUNCTIONS ---
    const openVideo = (index) => {
      cursorVideo.classList.add('is-visible');
      cursorVideo.style.opacity = "1";


      navItems.forEach((n, i) => n.classList.toggle('is-active-hover', i === index));


      layers.forEach((l, i) => {
        const v = l.querySelector('video');
        if (i === index) {
            l.classList.add('is-active');
            v.muted = !isFullscreen; // Muted on desktop follow, unmuted on mobile fullscreen
            if (v.preload === 'none') { v.preload = 'auto'; v.load(); }
            v.play().catch(() => {});
        } else {
            l.classList.remove('is-active');
            v.pause();
        }
      });
      syncMobilePauseIcon();
      syncMobileMuteIcon();
      updateMobileTimer();
    };


    const closeVideo = (e) => {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      isFullscreen = false;
      hideMobileControls();
      document.documentElement.classList.remove('is-video-locked');
      section.classList.remove('is-video-open');
      cursorVideo.classList.remove('is-visible', 'is-fullscreen');
      cursorVideo.style.opacity = "0";
      videoFlip.style.transform = '';
      stopRender();
      navItems.forEach(n => n.classList.remove('is-active-hover'));
      layers.forEach(l => l.querySelector('video').pause());
      // Hide the dialog from assistive technology, then restore the focus ring
      // to the service the reader opened it from.
      cursorVideo.setAttribute('aria-hidden', 'true');
      cursorVideo.setAttribute('inert', '');
      if (opener) { opener.focus(); opener = null; }
    };


    // --- NAVIGATION EVENTS ---
    navItems.forEach((item, index) => {
      // 1. DESKTOP HOVER: This is what triggers the video to appear
      item.addEventListener('mouseenter', () => {
        if (motionOff()) return;
        if (!isFullscreen && window.innerWidth >= 768) {
          openVideo(index);
          startRender();
        }
      });


      // 2. CLICK: Mobile Fullscreen OR Desktop Anchor
      item.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();


        if (window.innerWidth < 768) {
          isFullscreen = true;
          opener = item;
          document.documentElement.classList.add('is-video-locked');
          section.classList.add('is-video-open');
          cursorVideo.classList.add('is-fullscreen');
          openVideo(index);
          // The fullscreen clip is a dialog on mobile: expose it and move focus
          // to CLOSE, then put focus back on the service when it closes.
          cursorVideo.removeAttribute('inert');
          cursorVideo.removeAttribute('aria-hidden');
          if (mobileX) mobileX.focus();
          showMobileControls();
        } else {
          // Desktop Navigation with Anchor
          window.location.href = `/services#${item.dataset.slug}`;
        }
      });
    });


    // Hide video when leaving the nav area on Desktop
    document.getElementById('nav-container-node').addEventListener('mouseleave', () => {
      if (!isFullscreen && window.innerWidth >= 768) {
        cursorVideo.classList.remove('is-visible');
        cursorVideo.style.opacity = "0";
        navItems.forEach(n => n.classList.remove('is-active-hover'));
        stopRender();
      }
    });


    // --- MOBILE DRAG & CONTROLS ---
    if (mobilePause) mobilePause.onclick = (e) => {
        e.stopPropagation();
        const v = getActiveVideo();
        if (!v) return;
        if (v.paused) { v.play().catch(() => {}); }
        else { v.pause(); }
        syncMobilePauseIcon();
        showMobileControls();
    };


    if (mobileMute) mobileMute.onclick = (e) => {
        e.stopPropagation();
        const v = getActiveVideo();
        if (!v) return;
        v.muted = !v.muted;
        syncMobileMuteIcon();
        showMobileControls();
    };


    if (mobileX) mobileX.onclick = (e) => closeVideo();

    layers.forEach((l) => {
      const v = l.querySelector('video');
      if (!v) return;
      v.addEventListener('timeupdate', updateMobileTimer);
      v.addEventListener('loadedmetadata', updateMobileTimer);
      v.addEventListener('durationchange', updateMobileTimer);
      v.addEventListener('play', syncMobilePauseIcon);
      v.addEventListener('pause', syncMobilePauseIcon);
      v.addEventListener('volumechange', syncMobileMuteIcon);
    });

    cursorVideo.addEventListener('mousemove', () => { if (isFullscreen) showMobileControls(); });
    cursorVideo.addEventListener('touchstart', () => { if (isFullscreen) showMobileControls(); }, { passive: true });

    mobileControls?.addEventListener('mouseenter', () => { clearTimeout(mobileHideTimer); mobileControls.classList.add('controls-visible'); mobileX?.classList.add('controls-visible'); });
    mobileControls?.addEventListener('mouseleave', () => { if (isFullscreen) showMobileControls(); });
    mobileControls?.addEventListener('focusin', () => { if (isFullscreen) showMobileControls(); });
    mobileControls?.addEventListener('focusout', (e) => {
      if (!mobileControls.contains(e.relatedTarget) && isFullscreen) showMobileControls();
    });
    mobileX?.addEventListener('mouseenter', () => { clearTimeout(mobileHideTimer); mobileControls?.classList.add('controls-visible'); mobileX.classList.add('controls-visible'); });
    mobileX?.addEventListener('mouseleave', () => { if (isFullscreen) showMobileControls(); });
    mobileX?.addEventListener('focusin', () => { if (isFullscreen) showMobileControls(); });
    mobileX?.addEventListener('focusout', () => { if (isFullscreen) showMobileControls(); });

    // Escape closes the fullscreen clip from the keyboard.
    if (!window.__dattServicesEscape) {
      window.__dattServicesEscape = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const node = document.getElementById('cursor-video-node');
        if (node && node.classList.contains('is-fullscreen')) {
          e.preventDefault();
          document.getElementById('mobile-x-node')?.click();
        }
      });
    }

    // The fullscreen clip is modal: keep Tab inside its controls.
    if (!cursorVideo.__dattTrap) {
      cursorVideo.__dattTrap = true;
      cursorVideo.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        const items = Array.from(cursorVideo.querySelectorAll('button:not([disabled])'))
          .filter((el) => el.offsetWidth > 0 || el.offsetHeight > 0);
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }


    videoFlip.addEventListener('touchstart', (e) => {
      if (!isFullscreen) return;
      isDragging = true;
      dStartX = e.touches[0].clientX; dStartY = e.touches[0].clientY;
      videoFlip.classList.add('is-dragging');
    }, { passive: true });


    videoFlip.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const dx = e.touches[0].clientX - dStartX;
      const dy = e.touches[0].clientY - dStartY;
      videoFlip.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
    }, { passive: false });


    videoFlip.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      videoFlip.classList.remove('is-dragging');
      const dy = e.changedTouches[0].clientY - dStartY;
      if (Math.abs(dy) > 80) closeVideo();
      else videoFlip.style.transform = '';
    });


    // --- RENDER ENGINE (Follow Cursor) ---
    let tX = window.innerWidth/2, tY = window.innerHeight/2, cX = tX, cY = tY;
    let renderRaf = 0, renderW = 600, renderH = 338;

    /* The loop only runs while it has work: on a desktop, with motion on, while
       the portal is not fullscreen. Without the gate an empty rAF chain ran
       every frame on every device — including the phones that never could draw
       it — taking part of the main thread on the devices that need it for
       scrolling instead. */
    function render() {
      renderRaf = 0;
      if (isFullscreen || motionOff() || window.innerWidth < 768) return;
      cX += (tX - cX) * 0.15; // Smoothness
      cY += (tY - cY) * 0.15;
      cursorVideo.style.transform = `translate3d(${cX - renderW / 2}px, ${cY - renderH / 2}px, 0)`;
      renderRaf = requestAnimationFrame(render);
    }
    function startRender() {
      if (renderRaf) return;
      renderW = cursorVideo.offsetWidth || 600;
      renderH = cursorVideo.offsetHeight || Math.round(renderW * 9 / 16);
      renderRaf = requestAnimationFrame(render);
    }
    function stopRender() {
      if (renderRaf) { cancelAnimationFrame(renderRaf); renderRaf = 0; }
    }
    window.addEventListener('mousemove', (e) => { if(!isFullscreen) { tX = e.clientX; tY = e.clientY; } });


    // --- REVEAL TRIGGER ---
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { section.classList.add('is-active'); observer.unobserve(entry.target); }
      });
    }, { threshold: 0.1 });
    observer.observe(section);
  }


  setupInteractiveServices();
  document.addEventListener('astro:after-swap', setupInteractiveServices);
</script>
