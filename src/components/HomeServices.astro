---
// HomeServices.astro
const items = [
  { title: "Identity", video: "/assets/DS_OFFERINGS_1.mp4", slug: "services-identities" },
  { title: "Systems", video: "/assets/DS_OFFERINGS_2.mp4", slug: "services-systems" },
  { title: "Digital", video: "/assets/DS_OFFERINGS_3.mp4", slug: "services-digital" }
];
---


<section id="services-interactive-node" class="relative min-h-[100dvh] w-full bg-black flex flex-col justify-between px-[var(--page-padding)] py-12 md:py-20 overflow-hidden">
  <div class="h-12"></div>


  <!-- 1. Interaction Nav -->
  <div id="nav-container-node" class="relative z-20 flex-grow flex items-center justify-center transition-opacity duration-500">
    <nav class="flex flex-col items-center gap-y-0 w-full pb-24 md:pb-16">
      {items.map((item, index) => (
        <div class="hs-cube-reveal-mask pb-12 mb-[-3rem]">
          <button
            class="hs-cube-reveal-inner service-nav-item-node relative uppercase"
            data-index={index}
            data-slug={item.slug}
            style={`transition-delay: ${index * 0.1}s`}
          >
            {item.title}
          </button>
        </div>
      ))}
    </nav>
  </div>


  <!-- 2. THE VIDEO PORTAL -->
  <div id="cursor-video-node" class="pointer-events-none fixed top-0 left-0 z-[1200] w-[600px] aspect-[16/9] opacity-0 transition-opacity duration-500">


    <!-- MOBILE CONTROLS (Top Layer) -->
    <div id="mobile-video-controls" class="md:hidden absolute inset-0 w-full px-[var(--page-padding)] pb-12 grid grid-cols-3 items-end z-[200] opacity-0 pointer-events-none mix-blend-difference">
        <div class="flex justify-start">
            <div class="brands-line-mask pointer-events-auto">
                <button id="mobile-pause-node" class="brands-line-inner link-underline text-white font-bold uppercase text-[14px] tracking-[0.02em] bg-transparent border-none cursor-pointer" style="transition-delay: 1.1s;">PAUSE</button>
            </div>
        </div>
        <div class="flex justify-center">
            <div class="brands-line-mask pointer-events-auto">
                <button id="mobile-mute-node" class="brands-line-inner link-underline text-white font-bold uppercase text-[14px] tracking-[0.02em] bg-transparent border-none cursor-pointer" style="transition-delay: 1.2s;">UNMUTE</button>
            </div>
        </div>
        <div class="flex justify-end">
            <div class="brands-line-mask pointer-events-auto">
                <button id="mobile-x-node" class="brands-line-inner link-underline text-white font-bold uppercase text-[14px] tracking-[0.02em] bg-transparent border-none cursor-pointer" style="transition-delay: 1.3s;">CLOSE</button>
            </div>
        </div>
    </div>


    <!-- Draggable Video Wrapper -->
    <div id="video-flip-node" class="relative w-full h-full overflow-hidden bg-neutral-900 shadow-2xl z-[10] touch-none">
        {items.map((item, index) => (
          <div class="layer-node absolute inset-0 opacity-0 transition-opacity duration-500" data-index={index}>
            <video muted loop playsinline class="h-full w-full object-cover">
                <source src={item.video} type="video/mp4" />
            </video>
          </div>
        ))}
    </div>
  </div>


  <!-- 3. BOTTOM CTA AREA -->
  <div id="cta-wrap-node" class="relative z-30 flex justify-center w-full pb-4 transition-opacity duration-500 mix-blend-difference">
    <div class="hs-cube-reveal-mask">
        <a href="/services" class="cta-link inverted-cta hs-cube-reveal-inner text-white" style="transition-delay: 0.5s">
          View Services
        </a>
    </div>
  </div>
</section>


<style is:global>
  /* 1. TYPOGRAPHY & THICK UNDERLINES */
  .link-underline { position: relative; display: inline-block; }
  .link-underline::after {
    content: ''; position: absolute; bottom: -4px; left: 0; width: 100%; height: 3px;
    background-color: currentColor; transform: scaleX(1); transform-origin: left;
    transition: transform 0.6s var(--ease-mechanical);
  }
  .link-underline.animate-flow::after { animation: global-underline-flow 0.8s var(--ease-mechanical) forwards; }


  /* 2. REVEAL ENGINE */
  .hs-cube-reveal-mask, .brands-line-mask { display: block; overflow: hidden; perspective: 1200px; }
  .hs-cube-reveal-inner, .brands-line-inner {
    display: block; opacity: 0 !important;
    transform: translateY(115%) rotateX(-60deg) !important;
    transform-origin: top center !important;
    transition: transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical) !important;
  }
  #services-interactive-node.is-active .hs-cube-reveal-inner,
  #cursor-video-node.is-fullscreen .brands-line-inner {
    opacity: 1 !important; transform: translateY(0) rotateX(0deg) !important;
  }


  /* 3. NAV STYLING */
  .service-nav-item-node {
    font-size: clamp(72px, 12vw, 140px); font-weight: 600; line-height: 0.8 !important;
    letter-spacing: var(--track-tighter); color: rgba(255, 255, 255, 0.2);
    transition: color 0.5s var(--ease-mechanical); background: transparent; border: none; cursor: pointer; padding: 0.1em 0; width: 100%;
  }
  .service-nav-item-node.is-active-hover { color: #fff !important; mix-blend-mode: difference; }


  /* 4. VIDEO & DRAG LOGIC */
  .layer-node.is-active { opacity: 1 !important; z-index: 10; }
  #video-flip-node {
    transform: translateY(40%) rotateX(-60deg); transform-origin: bottom center;
    transition: transform 1.3s var(--ease-mechanical), opacity 0.5s ease;
  }
  #video-flip-node.is-dragging { transition: none !important; }
  #cursor-video-node.is-visible #video-flip-node:not(.is-dragging) {
    transform: translateY(0) rotateX(0deg) !important;
  }


  /* 5. FULLSCREEN STATE (MOBILE) — 16:9 centered, controls pinned to viewport bottom */
  #services-interactive-node.is-video-open { z-index: 1200; perspective: none !important; }
  #cursor-video-node.is-fullscreen {
    pointer-events: auto !important;
    width: 100vw !important;
    height: 100dvh !important;
    top: 0 !important;
    left: 0 !important;
    opacity: 1 !important;
    transform: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  #cursor-video-node.is-fullscreen #video-flip-node {
    width: 100vw !important;
    max-width: 100vw !important;
    height: auto !important;
    aspect-ratio: 16 / 9;
    flex: 0 0 auto;
  }
  /* CRITICAL: Reveal buttons in fullscreen */
  #cursor-video-node.is-fullscreen #mobile-video-controls {
    opacity: 1 !important;
    pointer-events: auto !important;
    top: auto !important;
    bottom: 0 !important;
  }


  #services-interactive-node.is-video-open #nav-container-node,
  #services-interactive-node.is-video-open #cta-wrap-node { opacity: 0 !important; }


  /* 6. CTA INVERTED STYLE */
  #services-interactive-node .cta-link.inverted-cta { color: #FFFFFF !important; }
  #services-interactive-node .cta-link.inverted-cta::after { background-color: #FFFFFF !important; }


  html.is-video-locked { overflow: hidden !important; overscroll-behavior: none; }
</style>


<script is:inline>
  function setupInteractiveServices() {
    const section = document.getElementById('services-interactive-node');
    const cursorVideo = document.getElementById('cursor-video-node');
    const videoFlip = document.getElementById('video-flip-node');
    const navItems = document.querySelectorAll('.service-nav-item-node');
    const layers = document.querySelectorAll('.layer-node');
    const mobileX = document.getElementById('mobile-x-node');
    const mobilePause = document.getElementById('mobile-pause-node');
    const mobileMute = document.getElementById('mobile-mute-node');


    if (!section || !cursorVideo) return;


    let isFullscreen = false;
    let dStartX = 0, dStartY = 0, isDragging = false;


    // --- VIDEO CONTROL FUNCTIONS ---
    const openVideo = (index) => {
      cursorVideo.classList.add('is-visible');
      cursorVideo.style.opacity = "1";
      if (mobilePause) mobilePause.textContent = "PAUSE";


      navItems.forEach((n, i) => n.classList.toggle('is-active-hover', i === index));


      layers.forEach((l, i) => {
        const v = l.querySelector('video');
        if (i === index) {
            l.classList.add('is-active');
            v.muted = !isFullscreen; // Muted on desktop follow, unmuted on mobile fullscreen
            if (mobileMute) mobileMute.textContent = v.muted ? "UNMUTE" : "MUTE";
            v.play().catch(() => {});
        } else {
            l.classList.remove('is-active');
            v.pause();
        }
      });
    };


    const closeVideo = (e) => {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      isFullscreen = false;
      document.documentElement.classList.remove('is-video-locked');
      section.classList.remove('is-video-open');
      cursorVideo.classList.remove('is-visible', 'is-fullscreen');
      cursorVideo.style.opacity = "0";
      videoFlip.style.transform = '';
      navItems.forEach(n => n.classList.remove('is-active-hover'));
      layers.forEach(l => l.querySelector('video').pause());
    };


    // --- NAVIGATION EVENTS ---
    navItems.forEach((item, index) => {
      // 1. DESKTOP HOVER: This is what triggers the video to appear
      item.addEventListener('mouseenter', () => {
        if (!isFullscreen && window.innerWidth >= 768) {
          openVideo(index);
        }
      });


      // 2. CLICK: Mobile Fullscreen OR Desktop Anchor
      item.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();


        if (window.innerWidth < 768) {
          isFullscreen = true;
          document.documentElement.classList.add('is-video-locked');
          section.classList.add('is-video-open');
          cursorVideo.classList.add('is-fullscreen');
          openVideo(index);
        } else {
          // Desktop Navigation with Anchor
          window.location.href = `/services#${item.dataset.slug}`;
        }
      });
    });


    // Hide video when leaving the nav area on Desktop
    document.getElementById('nav-container-node').addEventListener('mouseleave', () => {
      if (!isFullscreen && window.innerWidth >= 768) {
        cursorVideo.classList.remove('is-visible');
        cursorVideo.style.opacity = "0";
        navItems.forEach(n => n.classList.remove('is-active-hover'));
      }
    });


    // --- MOBILE DRAG & CONTROLS ---
    if (mobilePause) mobilePause.onclick = (e) => {
        e.stopPropagation();
        const v = Array.from(layers).find(l => l.classList.contains('is-active'))?.querySelector('video');
        if (v?.paused) { v.play(); mobilePause.textContent = "PAUSE"; }
        else if (v) { v.pause(); mobilePause.textContent = "PLAY"; }
    };


    if (mobileMute) mobileMute.onclick = (e) => {
        e.stopPropagation();
        const v = Array.from(layers).find(l => l.classList.contains('is-active'))?.querySelector('video');
        if (v) { v.muted = !v.muted; mobileMute.textContent = v.muted ? "UNMUTE" : "MUTE"; }
    };


    if (mobileX) mobileX.onclick = (e) => closeVideo();


    videoFlip.addEventListener('touchstart', (e) => {
      if (!isFullscreen) return;
      isDragging = true;
      dStartX = e.touches[0].clientX; dStartY = e.touches[0].clientY;
      videoFlip.classList.add('is-dragging');
    }, { passive: true });


    videoFlip.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const dx = e.touches[0].clientX - dStartX;
      const dy = e.touches[0].clientY - dStartY;
      videoFlip.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
    }, { passive: false });


    videoFlip.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      videoFlip.classList.remove('is-dragging');
      const dy = e.changedTouches[0].clientY - dStartY;
      if (Math.abs(dy) > 80) closeVideo();
      else videoFlip.style.transform = '';
    });


    // --- RENDER ENGINE (Follow Cursor) ---
    let tX = window.innerWidth/2, tY = window.innerHeight/2, cX = tX, cY = tY;
    function render() {
      if (!isFullscreen && window.innerWidth >= 768) {
        cX += (tX - cX) * 0.15; // Smoothness
        cY += (tY - cY) * 0.15;
        cursorVideo.style.transform = `translate3d(${cX - cursorVideo.offsetWidth / 2}px, ${cY - cursorVideo.offsetHeight / 2}px, 0)`;
      }
      requestAnimationFrame(render);
    }
    render();
    window.addEventListener('mousemove', (e) => { if(!isFullscreen) { tX = e.clientX; tY = e.clientY; } });


    // --- REVEAL TRIGGER ---
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { section.classList.add('is-active'); observer.unobserve(entry.target); }
      });
    }, { threshold: 0.1 });
    observer.observe(section);
  }


  setupInteractiveServices();
  document.addEventListener('astro:after-swap', setupInteractiveServices);
</script>
