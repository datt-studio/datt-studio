---
// InfoSection.astro
const part1 = "DATT STUDIO is a design agency & creative studio designing brands, systems, and digital experiences.";
const part2 = "We build clear, distinctive identities through strategy, design, and implementation. Designed for clarity. Built to hold.";
---

<section class="info-section px-[var(--page-padding)] pt-[120px] pb-20 md:pb-40 bg-black">
  <div data-intro-container class="w-full">

    <!-- One mask around both headings so the splitter indexes the intro as a
         single cascade: the first line of the second heading starts after the
         last line of the first, rather than both beginning together. -->
    <div class="brands-line-mask">
      <div class="brands-line-inner flex flex-col gap-y-12 md:gap-y-16">
        <h1 class="hero-title">{part1}</h1>
        <h1 class="hero-title">{part2}</h1>
      </div>
    </div>

  </div>
</section>

<style is:global>
  .info-section .hero-title {
    font-size: var(--font-h1); /* Restored to H1 */
    font-weight: 600;
    line-height: var(--lh-xtight);
    letter-spacing: var(--track-tighter);
    color: #FFFFFF;
    text-wrap: balance; /* keeps 'Defined by' off a line of its own */
  }

  .info-section .brands-line-mask {
    display: block;
    overflow: hidden;
    perspective: 1200px;
    padding-top: 0.2em;
    padding-bottom: 0.2em;
    margin-top: -0.2em;
    margin-bottom: -0.2em;
  }

  .info-section .brands-line-inner {
    display: block;
    /* EXACT ORIGINAL TRANSITION: -60deg and 1.3s */
    transform: translateY(115%) rotateX(-60deg);
    transform-origin: top center;
    opacity: 0;
    transition: transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical);
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  /* Triggered by the IntersectionObserver in Layout.astro */
  .info-section.is-active .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }

  /* The intro takes the full content width. The top nav shares the same page
     padding, so this reaches the end of the Contact item with nothing measured
     at runtime, which keeps it from starting narrow and snapping wide. */
  .info-section [data-intro-container] {
    width: 100%;
    max-width: none;
  }
</style>
