---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import SecureEmail from '../components/SecureEmail.astro';

const { pathname } = Astro.url;
const normalizedPath = pathname.replace(/\/$/, "");
const isActive = (path: string) => normalizedPath === path;

const sidebarLinks = [
  { href: '/privacy-cookies-policy', label: 'Privacy & Cookie Policy' },
  { href: '/terms-of-use', label: 'Terms of Use' },
  { href: '/accessibility', label: 'Accessibility Statement' },
  { href: '/data-processing', label: 'Data Processing Agreement' },
];

const lastUpdated = "16 June 2026";
---

<Layout title="DATT STUDIO - Accessibility Statement" isDark={true}>
  <Header isInverted={true} />

  <style is:global>
    html, body { background-color: #000000 !important; }
  </style>

  <main id="main-content" class="reveal-trigger w-full max-w-[1440px] pt-[120px] px-[var(--page-padding)] pb-32 bg-black text-white">
    <div class="flex flex-col md:flex-row w-full gap-y-16 md:gap-x-24">

      <article class="w-full md:w-[65%] flex flex-col">
        <div class="mb-[120px]">
            <div class="brands-line-mask">
                <h1 class="brands-line-inner text-white">Accessibility Statement</h1>
            </div>
        </div>

        <div class="flex flex-col gap-y-32">
            <section id="accessibility-commitment" class="flex flex-col">

              <div class="mb-[48px]">
                <div class="brands-line-mask">
                    <p class="brands-line-inner text-label !text-[#727272]">Updated — {lastUpdated}</p>
                </div>
              </div>

              <div class="mb-[64px]">
                <div class="brands-line-mask">
                    <h2 class="brands-line-inner text-label !text-white">Legal Conformance</h2>
                </div>
              </div>

              <div class="flex flex-col gap-y-12">
                <!-- 1. Commitment -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">1. Legal Commitment</h4>
                    <div class="mt-4"><p>DATT STUDIO LTD is committed to providing a digital environment accessible to the widest possible audience. We acknowledge our legal obligations under the <strong>Equality Act 2010</strong> and strive to ensure our Site remains perceivable, operable, and understandable for all users, regardless of ability or assistive technology.</p></div>
                  </div>
                </div>

                <!-- 2. Motion Control -->
                <div class="brands-line-mask">
                    <div class="brands-line-inner flex flex-col">
                      <h4 class="text-white">2. Site-Wide Motion Control</h4>
                      <div class="mt-4">
                          <p>This Site utilizes high-performance motion, 3D rotations, and backdrop effects. We recognize that these can be problematic for users with vestibular disorders. You may instantly disable all site-wide animations, blurs, and background videos by toggling the control below.</p>
                          <div class="flex flex-col items-start pt-12">
                            <button id="reduced-motion-toggle" class="erase-btn">
                              REDUCED MOTION: <span id="motion-status">OFF</span>
                            </button>
                          </div>
                      </div>
                    </div>
                </div>

                <!-- 3. Technical Standards -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">3. Technical Standard</h4>
                    <div class="mt-4">
                      <p>We aim for conformance with <strong>WCAG 2.2 Level AA</strong>. We test our interface against modern screen readers and keyboard-only navigation paths to ensure critical functionality—such as enquiry forms and project navigation—is preserved for all users. While we strive for full accessibility, the highly visual nature of our studio portfolio may present challenges in specific edge cases; we are constantly refining our code to provide robust alternatives for visual-only elements.</p>
                    </div>
                  </div>
                </div>

                <!-- 4. Feedback -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">4. Feedback & Support</h4>
                    <div class="mt-4">
                        <p>If you experience difficulty accessing any part of this Site, please contact us for support. We aim to respond to all accessibility-related enquiries within 3 business days:
                          <SecureEmail email="hello@dattstudio.com" className="cta-link !lowercase !text-[16px] !tracking-tight" isInverted={true} />.</p>
                    </div>
                  </div>
                </div>

                <!-- 5. Enforcement -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">5. Enforcement Procedure</h4>
                    <div class="mt-4">
                        <p>If you are not satisfied with how we respond to your complaint, you have the right to contact the <strong>Equality Advisory and Support Service (EASS)</strong>.</p>
                    </div>
                  </div>
                </div>
              </div>
            </section>
        </div>
      </article>

      <aside class="w-full md:w-[35%] lg:sticky lg:top-[132px] h-fit md:pl-20 border-l border-white/5">
        <nav class="flex flex-col items-start gap-y-3">
          {sidebarLinks.map((link, i) => (
            <div class="brands-line-mask">
              <a href={link.href} class:list={['sidebar-link text-label !text-[13px]', { 'active': isActive(link.href) }]} style={`transition-delay: ${0.1 + (i * 0.05)}s`}>{link.label}</a>
            </div>
          ))}
        </nav>
      </aside>
    </div>
  </main>
  <Footer isInverted={true} />
</Layout>

<style is:global>
  #main-content h4 { font-size: var(--font-h4); font-weight: 600; }
  #main-content p { color: #b4b4b4; font-weight: 400; line-height: var(--lh-body); }
  .cta-link:hover { color: #727272 !important; }
  .sidebar-link { color: #727272 !important; text-decoration: none; transition: color 0.4s var(--ease-mechanical); }
  .sidebar-link:hover, .sidebar-link.active { color: #ffffff !important; }
  .erase-btn { appearance: none; border-radius: 2px; background: #FAFAFA; color: #000; padding: 14px 24px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; transition: all 0.5s var(--ease-mechanical); border: none; }
  .erase-btn:hover { background: #727272; color: #fff; }
</style>

<script is:inline>
  function initA11yPage() {
    const btn = document.getElementById('reduced-motion-toggle');
    const statusSpan = document.getElementById('motion-status');
    const key = 'datt_studio_reduced_motion';

    const updateUI = () => {
      const isReduced = document.documentElement.classList.contains('user-reduced-motion');
      if (statusSpan) statusSpan.textContent = isReduced ? 'ON' : 'OFF';
      if (btn) {
          btn.style.background = isReduced ? 'rgba(229, 229, 229, 0.2)' : '#FAFAFA';
          btn.style.color = isReduced ? '#b4b4b4' : '#000';
      }
    };

    if (btn) {
      btn.onclick = (e) => {
        e.preventDefault();
        const active = document.documentElement.classList.toggle('user-reduced-motion');
        localStorage.setItem(key, active);
        if (active) { document.querySelectorAll('video').forEach(v => v.pause()); }
        updateUI();
      };
    }
    updateUI();
  }
  initA11yPage();
  document.addEventListener('astro:after-swap', initA11yPage);
</script>
