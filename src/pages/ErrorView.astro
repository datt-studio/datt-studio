---
// src/components/ErrorView.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

interface Props {
  code: string; // e.g., "404"
  message: string; // e.g., "This page doesn't exist."
}

const { code, message } = Astro.props;
const digits = code.split('');
---

<Layout title={`${code} — ${message}`} isDark={true}>
  <div class="error-page-wrapper">
    <Header />

    <main class="error-content px-[var(--page-padding)]">

      <!-- Giant Mechanical Numbers -->
      <div class="error-code-container">
        <h1 class="error-code">
          {digits.map((digit, i) => (
            <span class="digit-mask">
              <span class="digit-inner" style={`animation-delay: ${i * 0.1}s;`}>{digit}</span>
            </span>
          ))}
        </h1>
      </div>

      <!-- Footer: Copy and CTA -->
      <footer id="error-footer" class="error-footer flex flex-col pb-32 md:pb-8 gap-10 md:gap-6">
        <div class="brands-line-mask">
          <p class="brands-line-inner text-white">
            {message}
          </p>
        </div>

        <div class="brands-line-mask inline-block">
          <div class="brands-line-inner" style="transition-delay: 0.2s">
            <a href="/" class="cta-link inverted-cta">
              Return Home
            </a>
          </div>
        </div>
      </footer>
    </main>
  </div>
</Layout>

<script is:inline>
  function triggerErrorReveal() {
    const footer = document.getElementById('error-footer');
    if (footer) {
      setTimeout(() => {
        footer.classList.add('is-active');
      }, 150);
    }
  }
  triggerErrorReveal();
  document.addEventListener('astro:after-swap', triggerErrorReveal);
</script>

<style is:global>
  .error-page-wrapper { display: flex; flex-direction: column; min-height: 100vh; background-color: #000; }
  .error-content { flex-grow: 1; display: flex; flex-direction: column; justify-content: flex-end; position: relative; overflow: hidden; }

  .error-code-container { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 1; }
  .error-code { display: flex; font-size: clamp(8rem, 32vw, 28rem); font-weight: 600; line-height: 0.8; letter-spacing: -0.02em; color: #FFFFFF; gap: 0.05em; }
  .digit-mask { display: block; overflow: hidden; perspective: 2000px; padding: 0.15em 0; }
  .digit-inner { display: block; opacity: 0; transform-origin: center center; animation: mechanicalPremiumLoop 6s var(--ease-mechanical) infinite; will-change: transform, opacity; }

  @keyframes mechanicalPremiumLoop {
    0% { transform: translateY(110%) rotateX(-115deg); opacity: 0; }
    15%, 80% { transform: translateY(0) rotateX(0deg); opacity: 1; }
    92% { transform: translateY(-110%) rotateX(115deg); opacity: 0; }
    100% { transform: translateY(110%) rotateX(-115deg); opacity: 0; }
  }

  .error-footer .brands-line-mask { display: block; overflow: hidden; perspective: 1200px; padding-top: 0.2em; padding-bottom: 0.2em; margin-top: -0.2em; margin-bottom: -0.2em; }
  .error-footer .brands-line-inner { display: block; transform: translateY(115%) rotateX(-60deg); transform-origin: top center; opacity: 0; transition: transform 1.3s var(--ease-mechanical), opacity 0.9s var(--ease-mechanical); will-change: transform, opacity; }
  .error-footer.is-active .brands-line-inner { transform: translateY(0) rotateX(0deg) !important; opacity: 1 !important; }

  .error-footer { position: relative; z-index: 10; }
  .error-footer p { font-size: var(--font-h3); font-weight: 600; letter-spacing: var(--track-tight); line-height: 1.1; max-width: 450px; }
  .error-page-wrapper .cta-link.inverted-cta { color: #FFFFFF !important; font-size: var(--font-label); font-weight: 600; text-transform: uppercase; letter-spacing: var(--track-wide); }
  .error-page-wrapper .cta-link.inverted-cta::after { background: #FFFFFF !important; }

  @media (max-width: 768px) {
    .error-code { font-size: clamp(6rem, 45vw, 14rem); letter-spacing: -0.01em; gap: 0.02em; }
    .error-footer p { font-size: 24px; }
    .error-footer { gap: 1.2rem; padding-bottom: 12vh; }
  }
</style>
