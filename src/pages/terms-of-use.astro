---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
/**
 * Terms of Use Page
 * Spacing and styling matched to index.astro and your reference snippet.
 */
---

<Layout title="Terms of Use | Datt Studio">
  <Header />

  <!-- Main container matching index.astro exactly -->
  <main class="bg-black text-white px-6 md:px-12 pb-10 flex flex-col min-h-screen">

    <!-- 1. Meta Info section (Matches Clock section spacing) -->
    <div class="mt-10 mb-32 md:mb-40">
      <div class="text-[#7C7C7D] text-[15px] flex flex-col gap-1 font-semibold tracking-[-0.02em]">
        <span>UK (GMT+1) 13:03</span>
        <span>Last updated: October 2025</span>
      </div>
    </div>

    <!-- 2. Main Content Grid -->
    <section class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-x-24 gap-y-20 mb-32 md:mb-64">

      <!-- COLUMN 1: Sidebar Navigation -->
      <aside class="flex flex-col gap-4 items-start h-fit md:sticky md:top-14">
        <a href="/privacy-cookies-policy" class="studio-link text-[18px] font-semibold text-white">
          Privacy & Cookies Policy
        </a>
        <a href="/terms-of-use" class="studio-link text-[18px] font-semibold text-white">
          Terms of Use
        </a>
      </aside>

      <!-- COLUMN 2: Policy Content -->
      <article class="flex flex-col gap-16 max-w-2xl">

        <div id="terms-of-use" class="flex flex-col gap-6">
          <h1 class="text-[24px] font-semibold text-white leading-none tracking-[-0.02em]">Terms Of Use</h1>

          <div class="flex flex-col gap-10 text-[18px] leading-[1.4] tracking-[-0.02em] font-semibold">

            <!-- Terms Header -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">Terms of Use for <br/>www.dattstudio.com</h2>
              <p class="opacity-90">
                These Terms of Use ("Terms") govern your access to and use of the website at <a href="https://www.dattstudio.com" class="studio-link underline">www.dattstudio.com</a> (the "Site") and any related services provided by Datt Studio Ltd, a company registered in England and Wales with company number 16695845 ("we", "us", or "our"). By accessing or using the Site, you agree to these Terms. If you do not agree, do not use the Site.
              </p>
              <p class="opacity-90">
                We may update these Terms at any time. Continued use after changes constitutes acceptance. We will notify you of material changes via email or a Site notice.
              </p>
            </div>

            <!-- 1. Acceptable Use -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">1. Acceptable Use</h2>
              <p class="opacity-90">You may use the Site only for lawful purposes and in accordance with these Terms. You agree not to:</p>
              <ul class="list-disc pl-5 flex flex-col gap-2 opacity-90">
                <li>Copy, modify, distribute, sell, or lease any Content (as defined below) without our prior written consent.</li>
                <li>Use the Site in any way that breaches any applicable local, national, or international law or regulation.</li>
                <li>Attempt to gain unauthorised access to our systems, interfere with the Site, or introduce malware.</li>
                <li>Use the Site for commercial purposes without a separate agreement.</li>
                <li>Resell, redistribute, or share digital products or licenses obtained from the Site.</li>
              </ul>
            </div>

            <!-- 2. Intellectual Property -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">2. Intellectual Property</h2>
              <p class="opacity-90">
                All Content on the Site—including text, images, graphics, logos, videos, software, designs, digital products, and branding elements ("Content")—is owned by Datt Studio Ltd or our licensors and protected by United Kingdom and international copyright, trademark, and other intellectual property laws.
              </p>
              <p class="opacity-90">
                The Datt Studio Ltd logo, along with all other trademarks, service marks, trade names, and branding elements displayed on this site (collectively, the "Trademarks"), are owned by Datt Studio Ltd. You acknowledge that these Trademarks are valid and protected under applicable law. Any use of the Trademarks, including reproduction, distribution, modification, or display, without our prior written permission is strictly prohibited.
              </p>
              <p class="opacity-90">You agree not to:</p>
              <ul class="list-disc pl-5 flex flex-col gap-2 opacity-90">
                <li>Copy, reproduce, transmit, or use any Content or Trademarks except as expressly permitted below.</li>
                <li>Use the Trademarks in any manner that suggests sponsorship, endorsement, or affiliation with Datt Studio Ltd.</li>
                <li>Attempt to register or claim ownership of any Trademarks or similar marks.</li>
              </ul>
              <p class="opacity-90">
                Personal, non-commercial use: You may view, download, and print Content for your personal, non-commercial use only, subject to these Terms.
              </p>
              <p class="opacity-90">
                Digital Product Licenses: Licenses for downloadable products are personal, non-exclusive, non-transferable, revocable, and non-sublicensable. You may not share, redistribute, or use commercially without permission. Attribution to Datt Studio Ltd is required where applicable. We reserve the right to revoke licenses for misuse.
              </p>
              <p class="opacity-90">
                If you believe your intellectual property rights have been infringed, please contact us at <a href="mailto:info@dattstudio.com" class="studio-link underline">info@dattstudio.com</a> with details for review. We reserve the right to take legal action against unauthorized use.
              </p>
            </div>

            <!-- 3. User Content -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">3. User Content</h2>
              <p class="opacity-90">
                Any content you submit (e.g., comments, feedback) is non-confidential. You grant us a perpetual, worldwide, royalty-free license to use, modify, and distribute it. You warrant you own all rights in User Content and it does not infringe third-party rights.
              </p>
            </div>

            <!-- 4. Disclaimers -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">4. Disclaimers</h2>
              <p class="opacity-90">
                The Site and Content are provided "as is" and "as available" without warranties of any kind, express or implied, including fitness for purpose, merchantability, or non-infringement. We do not guarantee the Site will be secure, uninterrupted, or error-free. Content is for general information only and not professional advice.
              </p>
            </div>

            <!-- 5. Limitation of Liability -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">5. Limitation of Liability</h2>
              <p class="opacity-90">
                To the fullest extent permitted by law, Datt Studio Ltd (including directors, employees, agents) shall not be liable for any indirect, incidental, special, consequential, or punitive damages, or loss of profits, data, or goodwill, arising from your use of the Site or Content, even if advised of the possibility.
              </p>
              <p class="opacity-90">
                Our total liability for direct losses shall not exceed £100 (or the price paid for any digital product, whichever is greater). Nothing excludes liability for death, personal injury from negligence, fraud, or liability that cannot be excluded under UK law.
              </p>
            </div>

            <!-- 6. Indemnity -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">6. Indemnity</h2>
              <p class="opacity-90">
                You agree to indemnify and hold us harmless from any claims, losses, liabilities, damages, costs, and expenses (including legal fees) arising from your use of the Site, breach of these Terms, or violation of third-party rights.
              </p>
            </div>

            <!-- 7. Third-Party Links and Services -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">7. Third-Party Links and Services</h2>
              <p class="opacity-90">
                The Site may link to third-party sites or services. We are not responsible for their content, privacy practices, or availability. Use at your own risk.
              </p>
            </div>

            <!-- 8. Termination -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">8. Termination</h2>
              <p class="opacity-90">
                We may suspend or terminate your access immediately for breach of these Terms without notice or liability.
              </p>
            </div>

            <!-- 9. Data Protection -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">9. Data Protection</h2>
              <p class="opacity-90">
                Your use of the Site is also governed by our <a href="/privacy-cookies-policy" class="studio-link underline">Privacy & Cookies Policy</a>, which is incorporated by reference.
              </p>
            </div>

            <!-- 10. Governing Law and Disputes -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">10. Governing Law and Disputes</h2>
              <p class="opacity-90">
                These Terms are governed by the laws of England and Wales. The courts of England have exclusive jurisdiction over disputes.
              </p>
            </div>

            <!-- 11. Contact Us -->
            <div class="flex flex-col gap-3">
              <h2 style="color: #7C7C7D;">11. Contact Us</h2>
              <p class="opacity-90">
                Questions about these Terms? Email: <a href="mailto:hello@dattstudio.com" class="studio-link underline">hello@dattstudio.com</a>.
              </p>
            </div>

            <div class="pt-10">
              <p style="color: #7C7C7D;">End Of Terms</p>
            </div>
          </div>
        </div>
      </article>

    </section>

    <!-- Footer component pushed to bottom by flex-col min-h-screen -->
    <Footer />

  </main>
</Layout>

<style is:global>
  /* Global brand styles */
  :root {
    --studio-grey: #7C7C7D;
  }

  body {
    background-color: black;
    color: white;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, p, a, li, span {
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  /* --- CUSTOM LINK ANIMATION --- */
  .studio-link {
    position: relative;
    display: inline-block;
    text-decoration: none;
    color: inherit;
    transition: color 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .studio-link:hover {
    color: var(--studio-grey);
  }

  .studio-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .studio-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
