---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import SecureEmail from '../components/SecureEmail.astro';

const { pathname } = Astro.url;
const normalizedPath = pathname.replace(/\/$/, "");
const isActive = (path: string) => normalizedPath === path;

const sidebarLinks = [
  { href: '/privacy-cookies-policy', label: 'Privacy & Cookie Policy' },
  { href: '/terms-of-use', label: 'Terms of Use' },
  { href: '/accessibility', label: 'Accessibility Statement' },
  { href: '/data-processing', label: 'Data Processing Agreement' },
];

const lastUpdated = "16 June 2026";
---

<Layout title="DATT STUDIO - Terms of Use" isDark={true}>
  <Header isInverted={true} />

  <style is:global>
    html, body { background-color: #000000 !important; }
  </style>

  <main id="main-content" class="reveal-trigger w-full max-w-[1440px] pt-[120px] px-[var(--page-padding)] pb-32 bg-black text-white">
    <div class="flex flex-col md:flex-row w-full gap-y-16 md:gap-x-24">

      <article class="w-full md:w-[65%] flex flex-col">
        <div class="mb-[120px]">
            <div class="brands-line-mask">
                <h1 class="brands-line-inner text-white">Terms of Use</h1>
            </div>
        </div>

        <div class="flex flex-col gap-y-32">
            <section id="terms-of-use" class="flex flex-col">
              <div class="mb-[48px]">
                <div class="brands-line-mask">
                    <p class="brands-line-inner text-label !text-[#727272]">Last Updated — {lastUpdated}</p>
                </div>
              </div>

              <div class="mb-[64px]">
                <div class="brands-line-mask">
                  <h2 class="brands-line-inner text-label !text-white">Legal Notice</h2>
                </div>
              </div>

              <div class="flex flex-col gap-y-12">
                <!-- 1. Acceptance -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">1. Acceptance of Terms</h4>
                    <div class="mt-4">
                      <p>This website (“Site”) is operated by DATT STUDIO LTD (No. 16695845). By accessing the Site, you acknowledge that you have read, understood, and agreed to be bound by these Terms. DATT STUDIO LTD reserves the right to modify these terms at any time; continued usage constitutes acceptance of updated terms.</p>
                    </div>
                  </div>
                </div>

                <!-- 2. IP -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">2. Intellectual Property & Copyright</h4>
                    <div class="mt-4">
                      <p>All content on this Site—including typography, visual identities, custom code, motion physics, animations, and curated case studies—is the exclusive property of DATT STUDIO LTD and is protected by UK and international copyright laws. DATT STUDIO LTD hereby asserts its moral rights under the <strong>Copyright, Designs and Patents Act 1988</strong> to be identified as the author of all original work.</p>
                    </div>
                  </div>
                </div>

                <!-- 3. AI -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">3. AI & Machine Learning Restriction</h4>
                    <div class="mt-4">
                      <p>DATT STUDIO LTD expressly prohibits the use of any content, data, or visual assets on this Site for the purpose of training or improving Artificial Intelligence (AI) technologies. Under the laws of England and Wales, we explicitly "opt-out" of any Text and Data Mining (TDM) exceptions. The use of automated "robots" or "scrapers" to extract data for these purposes is a material breach of these Terms.</p>
                    </div>
                  </div>
                </div>

                <!-- 4. Liability -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">4. Limitation of Liability</h4>
                    <div class="mt-4">
                      <p>The Site is provided on an "as-is" basis. To the maximum extent permitted by law, DATT STUDIO LTD shall not be liable for any direct or indirect loss or damage arising from your use of the Site, including but not limited to data loss, system interruption, or errors in content.</p>
                    </div>
                  </div>
                </div>

                <!-- 5. External -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">5. External Links</h4>
                    <div class="mt-4">
                      <p>This Site may contain links to external platforms (e.g., client websites, social media). DATT STUDIO LTD is not responsible for the content, security, or privacy practices of these third-party environments.</p>
                    </div>
                  </div>
                </div>

                <!-- 6. Prohibited -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">6. Prohibited Usage</h4>
                    <div class="mt-4">
                      <p>Users may not attempt to interfere with the Site’s security, reverse-engineer the custom code, or use the Site to transmit malicious software. Unauthorised use of this Site may give rise to a claim for damages and/or be a criminal offence.</p>
                    </div>
                  </div>
                </div>

                <!-- 7. Law -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">7. Governing Law</h4>
                    <div class="mt-4">
                      <p>These Terms are governed by the laws of England and Wales. Any disputes arising from the use of this Site shall be subject to the exclusive jurisdiction of the English courts.</p>
                    </div>
                  </div>
                </div>

                <!-- 8. Inquiries -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">8. Inquiries</h4>
                    <div class="mt-4">
                        <p>For inquiries regarding licensing or usage rights, contact:
                          <SecureEmail email="hello@dattstudio.com" className="cta-link !lowercase !text-[16px] !tracking-tight" isInverted={true} />.</p>
                    </div>
                  </div>
                </div>
              </div>
            </section>
        </div>
      </article>

      <aside class="w-full md:w-[35%] lg:sticky lg:top-[132px] h-fit md:pl-20 border-l border-white/5">
        <nav class="flex flex-col items-start gap-y-3">
          {sidebarLinks.map((link, i) => (
            <div class="brands-line-mask">
              <a href={link.href} class:list={['sidebar-link text-label !text-[13px]', { 'active': isActive(link.href) }]} style={`transition-delay: ${0.1 + (i * 0.05)}s`}>{link.label}</a>
            </div>
          ))}
        </nav>
      </aside>
    </div>
  </main>
  <Footer isInverted={true} />
</Layout>

<style is:global>
  #main-content h4 { font-size: var(--font-h4); font-weight: 600; }
  #main-content p { color: #b4b4b4; font-weight: 400; line-height: var(--lh-body); }
  .cta-link:hover { color: #727272 !important; }
  .sidebar-link { color: #727272 !important; text-decoration: none; transition: color 0.4s var(--ease-mechanical); }
  .sidebar-link:hover, .sidebar-link.active { color: #ffffff !important; }
</style>
