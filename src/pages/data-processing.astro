---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import SecureEmail from '../components/SecureEmail.astro';

const { pathname } = Astro.url;
const normalizedPath = pathname.replace(/\/$/, "");
const isActive = (path: string) => normalizedPath === path;

const sidebarLinks = [
  { href: '/privacy-cookies-policy/', label: 'Privacy & Cookie Policy' },
  { href: '/terms-of-use/', label: 'Terms of Use' },
  { href: '/accessibility/', label: 'Accessibility Statement' },
  { href: '/data-processing/', label: 'Data Processing Agreement' },
];

const lastUpdated = "20 November 2026";
---

<Layout title="DATT STUDIO - Data Processing Agreement" isDark={true}>
  <Header isInverted={true} />

  <style is:global>
    html, body { background-color: #000000 !important; }
  </style>

  <main id="main-content" tabindex="-1" class="reveal-trigger w-full max-w-[1440px] pt-[120px] px-[var(--page-padding)] pb-32 bg-black text-white">
    <div class="flex flex-col md:flex-row w-full gap-y-16 md:gap-x-24">

      <article class="w-full md:w-[65%] flex flex-col">
        <!-- SPACE BELOW H1: 120px -->
        <div class="mb-[120px]">
            <div class="brands-line-mask">
                <h1 class="brands-line-inner text-white">Data Processing Agreement</h1>
            </div>
        </div>

        <div class="flex flex-col gap-y-32">
            <section id="data-processing" class="flex flex-col">
              <!-- Metadata Space: 48px -->
              <div class="mb-[48px]">
                <div class="brands-line-mask">
                    <p class="brands-line-inner text-label !text-[#7e7e7e]">UPDATED · {lastUpdated}</p>
                </div>
              </div>

              <!-- Section Head Space: 64px -->
              <div class="mb-[64px]">
                <div class="brands-line-mask">
                  <h2 class="brands-line-inner text-label !text-white">DPA Terms</h2>
                </div>
              </div>

              <div class="flex flex-col gap-y-12">
                <!-- 1. Scope -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">1. Applicability & Scope</h3>
                    <div class="mt-4">
                      <p>This DPA applies where DATT STUDIO LTD (<strong>“Processor”</strong>) processes Personal Data on behalf of a client (<strong>“Controller”</strong>). This agreement ensures such processing meets the requirements of Article 28 of the UK GDPR for creative and digital services provided by the studio.</p>
                    </div>
                  </div>
                </div>

                <!-- 2. Instructions -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">2. Instructions & Confidentiality</h3>
                    <div class="mt-4">
                      <p>The Processor shall process data only on documented instructions from the Controller. DATT STUDIO LTD ensures that all persons authorised to process the Personal Data have committed themselves to <strong>confidentiality</strong> or are under an appropriate statutory obligation of&nbsp;confidentiality.</p>
                    </div>
                  </div>
                </div>

                <!-- 3. AI Safeguards -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">3. Security & AI Safeguards</h3>
                    <div class="mt-4">
                      <p>DATT STUDIO LTD expressly covenants that it will not subject Controller Personal Data to any form of Machine Learning analysis or Artificial Intelligence training without the Controller’s prior written authorization. We implement appropriate technical and organisational measures to ensure security appropriate to the risk.</p>
                    </div>
                  </div>
                </div>

                <!-- 4. Sub-processors -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">4. Sub-Processors</h3>
                    <div class="mt-4">
                      <p>The Controller provides general authorisation for DATT STUDIO LTD to engage sub-processors (e.g. AWS, Vercel). The Processor shall inform the Controller of any intended changes concerning the addition or replacement of sub-processors, giving the Controller the opportunity to object. We remain fully liable for the data protection performance of any sub-processor&nbsp;engaged.</p>
                    </div>
                  </div>
                </div>

                <!-- 5. Assistance -->
                <div class="brands-line-mask">
                    <div class="brands-line-inner flex flex-col">
                      <h3 class="text-white legal-subhead">5. Assistance & Data Rights</h3>
                      <div class="mt-4">
                        <p>The Processor shall assist the Controller by appropriate technical and organisational measures for the fulfilment of the Controller's obligation to respond to requests for exercising <strong>Data Subject rights</strong> (e.g. access, rectification, erasure) and ensuring compliance with UK GDPR security obligations.</p>
                      </div>
                    </div>
                  </div>

                <!-- 6. Breach -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">6. Breach Notification</h3>
                    <div class="mt-4">
                      <p>In the event of a personal data breach, the Processor shall notify the Controller without undue delay (and no later than 72 hours) after becoming aware of the breach, providing necessary info to allow the Controller to meet its own reporting obligations.</p>
                    </div>
                  </div>
                </div>

                <!-- 7. Deletion -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">7. Deletion & Audit</h3>
                    <div class="mt-4">
                      <p>Upon completion of the services, the Processor shall, at the choice of the Controller, delete or return all personal data. We shall make available all information necessary to demonstrate compliance and allow for/contribute to audits or inspections.</p>
                    </div>
                  </div>
                </div>

                <!-- 8. Inquiries -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">8. Inquiries</h3>
                    <div class="mt-4">
                        <p>Legal inquiries regarding data processing should be directed to:</p>
                        <div class="mt-4">
                          <SecureEmail email="hello@dattstudio.com" className="cta-link !lowercase !text-[16px] !tracking-tight" isInverted={true} />
                        </div>
                    </div>
                  </div>
                </div>

                <!-- 9. International transfers -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">9. International Transfers</h3>
                    <div class="mt-4">
                      <p>Where personal data is transferred outside the United Kingdom, we rely on an adequacy decision, the UK International Data Transfer Agreement or the EU Standard Contractual Clauses, as appropriate. We apply supplementary measures where a transfer needs them.</p>
                    </div>
                  </div>
                </div>

                <!-- 10. Records and security -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">10. Records and Security</h3>
                    <div class="mt-4">
                      <p>We keep written records of processing carried out on behalf of the Controller. We restrict access to those who need it and apply technical and organisational measures appropriate to the risk.</p>
                    </div>
                  </div>
                </div>

                <!-- 11. Term -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">11. Term and Termination</h3>
                    <div class="mt-4">
                      <p>This agreement runs for the duration of the services. On termination, clauses covering confidentiality, security, deletion and liability continue where they need to.</p>
                    </div>
                  </div>
                </div>

                <!-- 12. Liability -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h3 class="text-white legal-subhead">12. Liability</h3>
                    <div class="mt-4">
                      <p>Our liability under this agreement is limited to the extent set out in the client agreement. We do not exclude liability where UK law does not allow it.</p>
                    </div>
                  </div>
                </div>
              </div>
            </section>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="legal-sidebar w-full md:w-[35%] lg:sticky lg:top-[132px] h-fit md:pl-20 border-l border-white/5">
        <nav aria-label="Legal pages" class="flex flex-col items-start gap-y-3">
          {sidebarLinks.map((link, i) => (
            <div class="brands-line-mask">
              <a href={link.href} class:list={['sidebar-link text-label !text-[13px]', { 'active': isActive(link.href) }]} style={`transition-delay: ${0.1 + (i * 0.05)}s`}>{link.label}</a>
            </div>
          ))}
        </nav>
      </aside>
    </div>
  </main>
  <Footer isInverted={true} />
</Layout>

<style is:global>
  #main-content h4 { font-size: var(--font-h4); font-weight: 600; }
  #main-content h3.legal-subhead { font-size: var(--font-h4); font-weight: 600; }
  #main-content p { color: #b4b4b4; font-weight: 400; line-height: var(--lh-body); text-wrap: pretty; }
  #main-content p + p { margin-top: 1.4em; }
  #main-content h1, #main-content h2, #main-content h3, #main-content h4 { text-wrap: pretty; }
  .cta-link:hover { color: #7e7e7e !important; }
  .sidebar-link { color: #7e7e7e !important; text-decoration: none; transition: color 0.4s var(--ease-mechanical); display: inline-flex; align-items: center; min-height: 24px; }
  .sidebar-link:hover, .sidebar-link.active { color: #ffffff !important; }
</style>
