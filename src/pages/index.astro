---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const capabilities = [
  "Art direction", "Creative direction", "Digital design", "Visual identity",
  "Strategy", "Motion", "Campaigns", "Narrative", "Tone of voice", "Naming"
];

const data = {
  tagline: "Shaping powerful identities and unforgettable digital experiences that deliver clarity, purpose, and connection."
};
---

<Layout title="Datt Studio">
  <Header />

  <main class="bg-black text-white px-6 md:px-12 pb-10 flex flex-col min-h-screen">

    <!-- 1. Clock section -->
    <div class="mt-10 mb-32 md:mb-40">
      <div class="text-[#7C7C7D] text-[16px] flex gap-2 font-mono font-normal uppercase">
        <span>UK (GMT+1)</span>
        <span id="live-clock">00:00:00</span>
      </div>
    </div>

    <!-- 2. Tagline section -->
    <section class="w-[80vw] md:w-[50vw] mb-48 md:mb-64">
      <h1 class="text-[24px] leading-[1.2]">
        {data.tagline}
      </h1>
    </section>

    <!-- 3. Information grid (2-column split for Desktop) -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-y-20 mb-24 text-[20px]">

      <!-- COLUMN 1: Capabilities -->
      <div class="flex flex-col gap-6">
        <h3 class="text-[#7C7C7D]">Capabilities</h3>
        <ul class="flex flex-col gap-1">
          {capabilities.map(item => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <!-- COLUMN 2: Contact Info Stack -->
      <div class="flex flex-col gap-12 md:gap-16">

        <!-- New business -->
        <div class="flex flex-col gap-6">
          <h3 class="text-[#7C7C7D]">New business</h3>
          <div class="flex flex-col gap-1 items-start">
            <a href="mailto:info@dattstudio.com" class="studio-link">info@dattstudio.com</a>
            <a href="tel:+44787143600" class="studio-link">+44 787143 600</a>

            <div class="mt-8 flex flex-col gap-1 items-start">
              <!-- Instagram - Open in New Tab -->
              <a
                href="https://www.instagram.com/datt__studio"
                target="_blank"
                rel="noopener noreferrer"
                class="studio-link"
              >Instagram</a>

              <!-- LinkedIn - Open in New Tab -->
              <a
                href="https://www.linkedin.com/company/dattstudio"
                target="_blank"
                rel="noopener noreferrer"
                class="studio-link"
              >LinkedIn</a>
            </div>
          </div>
        </div>

        <!-- General enquiries -->
        <div class="flex flex-col gap-6">
          <h3 class="text-[#7C7C7D]">General enquiries</h3>
          <div class="flex items-start">
              <a href="mailto:hello@dattstudio.com" class="studio-link">hello@dattstudio.com</a>
          </div>
        </div>

      </div>

    </section>

    <Footer />

  </main>
</Layout>

<script is:inline>
  function updateClock() {
    const clockEl = document.getElementById('live-clock');
    if (!clockEl) return;
    const now = new Date();
    clockEl.textContent = now.toLocaleTimeString('en-GB', {
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
    });
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>
