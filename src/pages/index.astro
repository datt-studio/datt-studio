---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeIntro from '../components/HomeIntro.astro';
import HomeServices from '../components/HomeServices.astro';
import HomePerspective from '../components/HomePerspective.astro';
import HomeApproach from '../components/HomeApproach.astro';
import HomeStudio from '../components/HomeStudio.astro';
import LatestNews from '../components/LatestNews.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Layout
  title="DATT STUDIO — Brand Identity & Digital Studio"
  description="DATT STUDIO is a creative studio for brands built to last — brand identity, visual systems, and digital experiences made to hold."
  isDark={true}
>
  <script is:inline>document.body.setAttribute('data-page-type', 'immersive');</script>

  <Header isInverted={true} />

  <main class="bg-black">
    <HomeHero />
    <HomeIntro />
    <HomeServices />
    <HomePerspective />
    <HomeApproach />
    <HomeStudio />
    <LatestNews posts={posts} />
  </main>

  <Footer isInverted={true} />
</Layout>

<style is:global>
  /* --- TABLET AND MOBILE: THE MIDDLE OF THE PAGE IS TIGHTER ---
     HomeIntro through HomeApproach are each at least a screen tall with a short
     block of copy centred in them, so on a narrow window the height is almost
     all empty: at 768x1024 there was 1045px of nothing between HomeIntro's words
     and the services nav, and 863px between Perspective and Approach. Read one
     after another it feels like a slideshow of statements rather than a page.

     The heights are what produce that space, not the padding. Each block is under
     300px tall, so trimming the padding would move the gap by tens of pixels
     while the section is still padded out to a screen. The height is what has to
     come down, which is what these rules change.

     HomeIntro goes furthest, from one and a third screens to under one, since it
     is a single statement with a CTA under it and it opens the run. The two
     statement sections come down to two thirds, which still leaves each of them
     comfortably more than their copy needs and reads as its own space. The
     services node keeps more of its height because it is a list to be read and
     scrolled rather than a statement, and its buttons are laid out against that
     height.

     Desktop is untouched, above and below. */
  @media (max-width: 1023px) {
    .home-intro {
      min-height: 90dvh;
    }
    #services-interactive-node {
      min-height: 75dvh;
    }
    .brand-statement {
      min-height: 65dvh;
    }
    .home-approach {
      min-height: 65dvh;
    }
  }
</style>
