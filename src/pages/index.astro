---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeIntro from '../components/HomeIntro.astro';
import HomeServices from '../components/HomeServices.astro';
import HomePerspective from '../components/HomePerspective.astro';
import HomeApproach from '../components/HomeApproach.astro';
import HomeStudio from '../components/HomeStudio.astro'; // New Import
import Footer from '../components/Footer.astro';
---

<Layout title="DATT STUDIO — Made to hold." isDark={true}>
  <script is:inline>document.body.setAttribute('data-page-type', 'immersive');</script>

  <Header isInverted={true} />

  <main class="bg-black">
    <HomeHero />
    <HomeIntro />
    <HomeServices />
    <HomePerspective />
    <HomeApproach />
    <HomeStudio /> <!-- Added below HomeApproach -->
  </main>

  <Footer isInverted={true} />
</Layout>
