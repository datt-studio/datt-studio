---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const description =
  'Notes from DATT STUDIO on naming, identity, systems, and building digital work made to hold.';
---

<Layout
  isDark={true}
  title="Notes — DATT STUDIO"
  description={description}
>
  <script is:inline>document.body.setAttribute('data-page-type', 'immersive');</script>

  <div class="flex flex-col bg-black">
    <Header isInverted={true} />

    <main class="flex-none w-full">
      <section class="news-hero reveal-trigger w-full px-[var(--page-padding)] pt-[120px] pb-20 md:pb-40 bg-black">
      <div class="max-w-[720px] w-full">
        <h1 class="text-white mb-16">
          <span class="brands-line-mask">
            <span class="brands-line-inner">Notes.</span>
          </span>
        </h1>

        {posts.length === 0 && (
          <p class="text-white/70">Nothing published yet.</p>
        )}

        <ul class="flex flex-col gap-16">
          {posts.map((post) => (
            <li>
              <a href={`/news/${post.id}/`} class="news-card block group">
                <p class="text-label text-white/50 mb-3">
                  <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                </p>
                {post.data.cover && (
                  <img
                    class="news-thumb mb-4"
                    src={post.data.cover}
                    alt={post.data.coverAlt ?? ''}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <h2 class="text-white mb-3 transition-opacity duration-300 group-hover:opacity-70">
                  {post.data.title}
                </h2>
                <p class="text-white/70">{post.data.summary}</p>
                <span class="cta-link text-white mt-4 inline-block">Read note</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      </section>
    </main>

    <Footer isInverted={true} disableMagnet={true} />
  </div>
</Layout>

<style>
  .news-card {
    text-decoration: none;
    color: inherit;
  }
  .news-thumb {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
</style>
