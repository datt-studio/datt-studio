---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsCover from '../../components/NewsCover.astro';
import { existsSync } from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

/* Absolute, canonical form of this article, used by the share row. Matches the
   URL the layout puts in <link rel="canonical">, trailing slash and all. */
const shareUrl = `https://dattstudio.com${Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`}`;
const shareTitle = post.data.title;

const shareLinks = [
  {
    label: 'IG',
    name: 'Instagram',
    href: null,
  },
  {
    label: 'IN',
    name: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`,
  },
  {
    label: 'TH',
    name: 'Threads',
    href: `https://www.threads.net/intent/post?text=${encodeURIComponent(`${shareTitle} ${shareUrl}`)}`,
  },
  {
    label: 'X (TW)',
    name: 'X',
    href: `https://x.com/intent/post?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(shareUrl)}`,
  },
];

/* Link previews use a JPEG twin of the cover rather than the cover itself.
   LinkedIn is the reason: its crawler will not render a WebP og:image, so a
   WebP cover shows as a bare link there while X and Threads would have shown
   the image. The JPEG is built from the same file the article displays by
   `npm run news:og`, so the two cannot drift while the cover is unchanged.
   If one is ever missing the cover is used instead and the build says so. */
const shareCardPath = post.data.cover ? `/news/og/${post.id}.jpg` : undefined;
const hasShareCard =
  shareCardPath && existsSync(path.join(process.cwd(), 'public', shareCardPath.replace(/^\//, '')));

if (shareCardPath && !hasShareCard) {
  console.warn(`[news] No JPEG share card for ${post.id}. Run: npm run news:og`);
}

const shareImage = hasShareCard ? shareCardPath : post.data.cover;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  inLanguage: 'en-GB',
  isPartOf: { '@type': 'WebSite', name: 'DATT STUDIO', url: 'https://dattstudio.com/' },
  author: { '@type': 'Organization', name: 'DATT STUDIO' },
  publisher: {
    '@type': 'Organization',
    name: 'DATT STUDIO',
    logo: { '@type': 'ImageObject', url: 'https://dattstudio.com/assets/datt-logo-512.png' },
  },
  ...(post.data.cover ? { image: `https://dattstudio.com${post.data.cover}` } : {}),
};
---

<Layout
  isDark={true}
  title={`${post.data.title} — DATT STUDIO`}
  description={post.data.summary}
  image={shareImage}
  imageAlt={post.data.coverAlt ?? 'DATT STUDIO'}
>
  <div class="flex flex-col bg-black">
    <Header isInverted={true} />

    <main class="flex-none w-full">
      <section class="news-hero reveal-trigger relative w-full px-[var(--page-padding)] pt-[120px] pb-20 md:pb-40 bg-black">
      <article class="max-w-[720px] w-full">
        <div class="brands-line-mask block">
          <div class="brands-line-inner block" style="transition-delay: 0s">
            <a href="/news/" class="cta-link inverted-cta inline-block mb-12">&larr; All news</a>
          </div>
        </div>

        <div class="brands-line-mask block">
          <div class="brands-line-inner block" style="transition-delay: 0.1s">
            <p class="text-label text-white/50 mb-4">
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            </p>
          </div>
        </div>

        <div class="brands-line-mask block">
          <h1 class="brands-line-inner block text-white mb-10" style="transition-delay: 0.2s">
            {post.data.title}
          </h1>
        </div>

        <div class="brands-line-mask block">
          <div class="brands-line-inner block" style="transition-delay: 0.3s">
            <p class="text-white/70 mb-14 text-[20px] md:text-[22px]">{post.data.summary}</p>
          </div>
        </div>

        <div class="brands-line-mask block">
          <div class="brands-line-inner block" style="transition-delay: 0.35s">
            <NewsCover src={post.data.cover} alt={post.data.coverAlt ?? ''} />
          </div>
        </div>

        <div class="news-prose" data-prose>
          <Content />
        </div>
      </article>

      <!-- SHARE
           On desktop this becomes a sticky rail on the News column line, so it
           stays with the reader through the article, as the legal pages do with
           their section links. On mobile and tablet it ends the article, left
           aligned. The horizontal offset is measured from the News link in the
           script below; without it the rail falls back to the page margin. -->
      <div
        class="article-share"
        data-share-row
        data-share-url={shareUrl}
      >
        <div class="article-share-inner">
          <div class="article-share-row">
            <span class="text-label article-share-label">Share</span>
            {shareLinks.map((link) =>
              link.href ? (
                <a
                  class="text-label article-share-item"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Share on ${link.name}`}
                >{link.label}</a>
              ) : (
                <button
                  type="button"
                  class="text-label article-share-item"
                  data-share-instagram
                  aria-label="Share on Instagram"
                >{link.label}</button>
              )
            )}
          </div>
          <p class="article-share-status" data-share-status role="status" aria-live="polite"></p>
        </div>
      </div>
      </section>
    </main>

    <Footer isInverted={true} />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
</Layout>

<style is:global>
  .news-prose p {
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1.4em;
  }
  .news-prose h2 {
    color: #ffffff;
    margin: 2.2em 0 0.8em;
  }
  .news-prose h3 {
    color: #ffffff;
    margin: 1.8em 0 0.7em;
  }
  .news-prose a {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .news-prose strong {
    color: #ffffff;
    font-weight: 600;
  }
  .news-prose ul,
  .news-prose ol {
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 1.4em 1.2em;
  }
  .news-prose li {
    margin-bottom: 0.5em;
  }
  .news-prose blockquote {
    border-left: 2px solid rgba(255, 255, 255, 0.3);
    padding-left: 1.2em;
    margin: 1.6em 0;
    color: rgba(255, 255, 255, 0.65);
  }
  .news-prose code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    color: rgba(255, 255, 255, 0.9);
  }
  .news-prose hr {
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    margin: 2.4em 0;
  }

  /* Each top-level block reveals on its own as it scrolls in, line by line,
     through the same split engine as the rest of the site. The engine turns a
     block into one mask per rendered line, but it is triggered by .is-active,
     which the section-wide observer in Layout.astro applies all at once: the
     article body sits in one tall section, so .is-active would open the whole
     piece on load. These rules keep the generated line masks closed until their
     own block scrolls in (.prose-in), then flip them with the stagger the engine
     already set on each line. The first two selectors are the unsplit fallback
     when motion is off and no line masks exist. */
  .news-prose .prose-block > .brands-line-inner {
    transform: translateY(115%) rotateX(-60deg) !important;
    opacity: 0 !important;
  }
  .news-prose .prose-block.prose-in > .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }
  .news-prose .prose-block .ls-mask > .brands-line-inner {
    transform: translateY(115%) rotateX(-60deg) !important;
    opacity: 0 !important;
  }
  .news-prose .prose-block.prose-in .ls-mask > .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }

  .news-prose table {
    color: #ffffff;
    width: 100%;
    border-collapse: collapse;
    margin: 2.4em 0;
    font-size: 0.95em;
  }
  .news-prose th,
  .news-prose td {
    text-align: left;
    padding: 0.85em 1em 0.85em 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    vertical-align: top;
  }
  .news-prose th {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78em;
    color: rgba(255, 255, 255, 0.62);
  }
  /* The label down the left of a comparison table heads its row rather than the
     table, so it is marked up as a header for that row, which is what lets a
     screen reader announce it as the reader moves across the numbers. It keeps
     the appearance of the cells it replaces: only the column headings above
     should read as headings, and the row labels should not shout over the
     figures they name. */
  .news-prose th[scope='row'] {
    font-weight: 400;
    text-transform: none;
    letter-spacing: inherit;
    font-size: inherit;
    color: inherit;
  }

  .news-prose td:last-child,
  .news-prose th:last-child { padding-right: 0; }
  .news-prose .prose-block-table { margin-bottom: 2.4em; }

  /* Video is excluded from the mask system. A mask is overflow: hidden with only a
     0.2em bleed, which clips the native control bar, and rotateX on a fixed-ratio
     element looks wrong. These fade in as one piece instead. */
  .news-prose video {
    display: block;
    width: 100%;
    height: auto;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  /* Article videos autoplay muted and loop. They only start once scrolled into
     view, so nothing is fetched or played before the reader reaches them. */
  .news-prose video.is-playing { border-color: rgba(255, 255, 255, 0.2); }
  .news-prose figure { margin: 0; }
  .news-prose figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .news-prose figcaption {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9em;
    margin-top: 0.8em;
  }
  .news-prose .prose-media {
    margin: 2.4em 0;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s var(--ease-mechanical), transform 0.9s var(--ease-mechanical);
  }
  .news-prose .prose-media.prose-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* Spacing lives on the mask, not inside it: the mask clips its top edge, so a
     top margin on the inner would offset the text as it slides in. */
  .news-prose .prose-block > .brands-line-inner > * { margin-top: 0; margin-bottom: 0; }
  .news-prose .prose-block-h2 { margin-top: 2.6em; }
  .news-prose .prose-block-h3 { margin-top: 2.2em; }
  .news-prose .prose-block-p,
  .news-prose .prose-block-ul,
  .news-prose .prose-block-ol { margin-bottom: 1.4em; }
  .news-prose .prose-block-hr { margin-top: 2.4em; margin-bottom: 2.4em; }

  /* .cta-link sets color: currentColor and sits after .text-white in the cascade,
     so at equal specificity it wins and the CTA falls back to the body's #131313
     on this black page. .inverted-cta needs !important to beat it. The underline
     needs no rule of its own: .cta-link::after is background: currentColor. */
  .inverted-cta {
    color: #ffffff !important;
  }

  /* SHARE
     Mobile and tablet: the links end the article, left aligned to the page
     margin. Desktop: they become a vertical rail on the News column line and
     stay in view through the piece, the way the legal pages hold their section
     links. --share-align is measured from that link in the script below, and
     it is the distance from the section's right edge to the News right edge.
     Without JS the rail sits at the page margin, which is where the row is on
     mobile, so the layout still holds. */
  .article-share {
    margin-top: clamp(4.5rem, 9vw, 9rem);
  }
  .article-share-inner {
    position: relative;
  }
  .article-share-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .article-share-label {
    color: rgba(255, 255, 255, 0.35);
    margin-right: 0.25rem;
  }
  .article-share-item {
    color: rgba(255, 255, 255, 0.62);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.4s var(--ease-mechanical);
  }
  .article-share-item:hover {
    color: #ffffff;
  }
  .article-share-item:focus-visible {
    outline: 1px solid rgba(255, 255, 255, 0.6);
    outline-offset: 4px;
  }
  .article-share-status {
    position: absolute;
    right: 0;
    top: calc(100% + 0.7rem);
    margin: 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-mechanical);
    white-space: nowrap;
  }
  .article-share-status.is-visible {
    opacity: 1;
  }
  /* 1100px is where the gap between the article column and the News column is
     wide enough for the rail, with clearance, at every width above it. */
  @media (min-width: 1100px) {
    .article-share {
      position: absolute;
      top: 0;
      bottom: 0;
      right: calc(var(--page-padding) + var(--share-align, 0px));
      margin-top: 0;
    }
    .article-share-inner {
      position: sticky;
      top: 132px;
    }
    .article-share-row {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.75rem;
    }
    .article-share-label {
      margin-right: 0;
      margin-bottom: 0.5rem;
    }
    /* The rail is narrow, so a long fallback message wraps down the News
       column line instead of running back across the article text. */
    .article-share-status {
      max-width: 100%;
      white-space: normal;
      text-align: right;
      line-height: 1.5;
    }
  }
</style>

<script is:inline>
  // Wrap every top-level block of the article body in the global mask/inner pair so
  // each one reveals on its own as it scrolls in. Two reasons this cannot reuse the
  // global observer: it is wired up at parse time before these nodes exist, and it
  // opens every .brands-line-mask inside the section in one pass.
  //
  // Blocks holding video are skipped and given .prose-media instead: a mask is
  // overflow: hidden with a 0.2em bleed, which clips the native controls.
  const MEDIA_TAGS = ['VIDEO', 'FIGURE', 'IFRAME', 'AUDIO'];

  function maskProse() {
    document.querySelectorAll('[data-prose]').forEach((prose) => {
      if (prose.dataset.masked === 'true') return;
      const blocks = Array.from(prose.children);
      if (!blocks.length) return;
      prose.dataset.masked = 'true';

      const fade = [];

      blocks.forEach((el, i) => {
        const holdsMedia =
          MEDIA_TAGS.includes(el.tagName) || el.querySelector('video, iframe, audio');

        if (holdsMedia) {
          el.classList.add('prose-media');
          el.style.transitionDelay = `${Math.min(i, 6) * 0.05}s`;
          fade.push(el);
          return;
        }

        const mask = document.createElement('span');
        mask.className = 'brands-line-mask prose-block prose-block-' + el.tagName.toLowerCase();
        el.replaceWith(mask);

        const inner = document.createElement('span');
        inner.className = 'brands-line-inner';
        inner.style.transitionDelay = `${Math.min(i, 6) * 0.05}s`;
        mask.appendChild(inner);
        inner.appendChild(el);
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('prose-in');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

      prose.querySelectorAll('.prose-block, .prose-media').forEach((el) => observer.observe(el));

      // On client-side navigations the global splitter already exists; on the
      // first load it is defined just after this runs and splits these in turn.
      if (window.dattSplitLines) window.dattSplitLines(prose);
    });
  }

  maskProse();
  document.addEventListener('astro:after-swap', maskProse);

  // Article videos play muted and loop, and they start when they scroll into view
  // rather than on page load. The native autoplay attribute is deliberately absent:
  // it would pull 2.8 MB of video the moment the page opens, before the reader has
  // reached the paragraph that introduces it. The controls are present from the
  // start, so the reader can pause, scrub or unmute at any point.
  //
  // Autoplay is muted-only in every current browser, and a later un-mute by the
  // reader is preserved: once they have touched the controls we stop managing
  // playback, so scrolling past a video never yanks it out mid-watch.
  function wireVideo(v) {
    if (v.dataset.wired === 'true') return;
    v.dataset.wired = 'true';
    v.muted = true;
    v.defaultMuted = true;
    v.loop = true;

    // preload="none" in the markup, upgraded only at the point we intend to play.
    // Safari in particular will not start fetching a preload="none" source on
    // play() alone.
    v.addEventListener('pointerdown', () => { v.dataset.touched = 'true'; });
    v.addEventListener('keydown', () => { v.dataset.touched = 'true'; });

    // Removes the download control where the browser honours it. The file is still
    // reachable, so this is a discouragement and not protection.
    if (v.hasAttribute('controls')) {
      v.setAttribute('controlslist', 'nodownload');
    }

    // Scoped to the video itself rather than the page, so right-click still works
    // for selecting and copying the surrounding text.
    v.addEventListener('contextmenu', (e) => e.preventDefault());

    v.preload = 'none';

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const inView = entry.isIntersecting;
        if (inView) {
          v.preload = 'auto';
          v.play().then(() => {
            v.classList.add('is-playing');
          }).catch(() => {
            // Autoplay refused. The poster and the control bar are still there.
          });
        } else if (v.dataset.touched !== 'true') {
          v.pause();
          v.classList.remove('is-playing');
        }
      });
    }, { threshold: 0.6 });

    io.observe(v);
  }

  function wireVideos() {
    document.querySelectorAll('[data-prose] video').forEach(wireVideo);
  }

  wireVideos();
  document.addEventListener('astro:after-swap', wireVideos);

  /* SHARE
     Ends the article on mobile and tablet, left aligned to the page margin.
     From 1100px up the links leave the flow and become a sticky rail on the
     News column line. Nothing in CSS can know where that link lands, because
     the nav is spaced by its own labels, so the distance is measured: the rail
     is laid out at the margin first, and the offset is the gap between the two
     right edges. Clearing the property before reading keeps a resize from
     measuring the offset it is about to replace. */
  function alignShareRow() {
    const row = document.querySelector('[data-share-row]');
    if (!row) return;
    const news = document.querySelector('#main-header a[href="/news/"]');
    if (!news) return;

    row.style.removeProperty('--share-align');
    if (!window.matchMedia('(min-width: 1100px)').matches) return;

    const offset = Math.round(
      row.getBoundingClientRect().right - news.getBoundingClientRect().right
    );
    if (offset > 0) row.style.setProperty('--share-align', `${offset}px`);
  }

  /* Instagram has no web share intent and no way to prefill a post with a
     link, so clicking it copies the article URL and opens Instagram, ready for
     the reader to paste. Every other network has a real composer. */
  function legacyCopy(text) {
    const field = document.createElement('textarea');
    field.value = text;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.top = '-1000px';
    document.body.appendChild(field);
    field.select();
    let copied = false;
    try {
      copied = document.execCommand('copy');
    } catch (error) {
      copied = false;
    }
    field.remove();
    return copied;
  }

  function wireShare() {
    document.querySelectorAll('[data-share-row]').forEach((row) => {
      if (row.dataset.shareWired === 'true') return;
      row.dataset.shareWired = 'true';

      const url = row.dataset.shareUrl;
      const status = row.querySelector('[data-share-status]');
      const instagram = row.querySelector('[data-share-instagram]');
      let statusTimer = 0;

      function say(message) {
        if (!status) return;
        status.textContent = message;
        status.classList.add('is-visible');
        clearTimeout(statusTimer);
        statusTimer = setTimeout(() => status.classList.remove('is-visible'), 6000);
      }

      if (!instagram) return;

      instagram.addEventListener('click', () => {
        const openInstagram = () =>
          window.open('https://www.instagram.com/', '_blank', 'noopener');

        // Copy first and open second. Opening the tab moves focus, and a
        // clipboard write from an unfocused document is rejected, which is why
        // this used to fall through to the address bar message. The synchronous
        // copy also stays inside the click's user gesture, where it belongs.
        if (legacyCopy(url)) {
          openInstagram();
          say('Link copied');
          return;
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(
            () => {
              openInstagram();
              say('Link copied');
            },
            () => {
              openInstagram();
              say('Copy the link from the address bar.');
            }
          );
          return;
        }

        openInstagram();
        say('Copy the link from the address bar.');
      });
    });
  }

  alignShareRow();
  wireShare();

  if (!window.dattShareBound) {
    window.dattShareBound = true;
    document.addEventListener('astro:after-swap', () => {
      alignShareRow();
      wireShare();
    });
    document.addEventListener('astro:page-load', alignShareRow);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(alignShareRow);
    }
    let shareFrame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(shareFrame);
      shareFrame = requestAnimationFrame(alignShareRow);
    });
  }
</script>
