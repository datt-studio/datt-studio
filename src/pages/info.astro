---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InfoHero from '../components/InfoHero.astro';
import InfoNaming from '../components/InfoNaming.astro';
import InfoPerspective from '../components/InfoPerspective.astro';
import InfoThinking from '../components/InfoThinking.astro';
import InfoPhilosophy from '../components/InfoPhilosophy.astro';
---

<Layout
  title="About the Studio — DATT STUDIO"
  description="Everything about DATT STUDIO — the studio, the approach, and the work made to hold."
  isDark={true}
>
  <Header isInverted={true} />

  <main class="bg-black">
    <InfoHero />
    <InfoNaming />
    <InfoPerspective />
    <InfoThinking />
    <InfoPhilosophy />
  </main>

  <Footer isInverted={true} />
</Layout>

<style is:global>
  /* --- GLOBAL STABILITY --- */
  html, body {
    background-color: #000 !important;
    scroll-restoration: auto;
    -webkit-font-smoothing: antialiased;
  }

  /* --- THE MECHANICAL REVEAL ENGINE --- */
  .brands-line-mask {
    display: block;
    overflow: hidden;
    perspective: 1200px;
    padding-bottom: 0.15em;
    margin-bottom: -0.15em;
  }

  .brands-line-inner {
    display: block;
    transform: translateY(115%) rotateX(-25deg);
    transform-origin: top;
    opacity: 0;
    transition:
      transform 1.2s cubic-bezier(0.8, 0, 0.1, 1),
      opacity 0.9s cubic-bezier(0.8, 0, 0.1, 1);
    will-change: transform, opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Trigger state: Locked once activated */
  .is-active .brands-line-inner {
    transform: translateY(0) rotateX(0deg) !important;
    opacity: 1 !important;
  }

  /* --- MECHANICAL UNDERLINE CTA --- */
  .info-cta {
    display: inline-block;
    position: relative;
    text-decoration: none;
    color: #FFF !important;
    font-size: 16px;
    font-weight: 900;
    padding-bottom: 4px;
    letter-spacing: -0.01em;
  }

  .info-cta::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.8, 0, 0.1, 1);
  }

  .info-cta:hover::after {
    animation: underline-flow 0.8s cubic-bezier(0.8, 0, 0.1, 1) forwards;
  }

  @keyframes underline-flow {
    0% { transform: scaleX(1); transform-origin: right; }
    45% { transform: scaleX(0); transform-origin: right; }
    50% { transform: scaleX(0); transform-origin: left; }
    100% { transform: scaleX(1); transform-origin: left; }
  }

  /* --- THE COPY HANGS OFF THE SERVICES ITEM IN THE NAV ---
     Every width where the top nav shows a SERVICES item (768px and up) has the
     same split: a label on the left, copy in the rest of the row. The copy ends
     up in the right half of a tablet screen with only the page margin to its
     left, while the top nav has a SERVICES item sitting much further right. The
     copy is hung off that item instead, so the reading column starts where the
     word SERVICES does. It is the same join the homepage's recognition table
     makes with the same link.

     The label column takes the measured distance and the copy takes what is
     left, rather than the copy being shoved across with a margin: a margin
     would come out of the copy's own width and leave it a sliver, which is the
     thing this is meant to fix. The distance is capped at 55% of the container
     so a wide nav on a narrow screen cannot do that either, and 45% stands in
     until the script has measured it.

     Philosophy is deliberately left out. It is a single closing statement rather
     than a section in the split, and it stays on the page margin, which also
     keeps the last thing on the page from stopping short of the right margin the
     way the sections above it do.

     Below 768px the nav has no SERVICES item to line up with and the copy
     already runs the full width. */
  @media (min-width: 768px) {
    #naming-section > div,
    #perspective-section > div,
    #thinking-section > div {
      grid-template-columns: minmax(0, var(--services-copy-left, 45%)) 1fr;
    }
  }

  /* --- TABLET AND MOBILE: THE MIDDLE OF THE PAGE IS TIGHTER ---
     The same change as the homepage's own sections, and for the same reason.
     Each of these is a screen tall with a label and a short block of copy in the
     middle, so on a narrow window the height is nearly all empty: at 768x1024
     there was 717px of nothing between Perspective's words and Thinking's, and
     818px between Thinking and Philosophy. Read one after another it feels like a
     slideshow of statements rather than a page.

     The height is what produces that space, not the padding. The tallest of these
     is under 350px of copy, so trimming the padding would move the gap by tens of
     pixels while the section is still padded out to a screen. The height is what
     has to come down, which is what this changes.

     65svh is the value the homepage's statement sections use, which is the point:
     these pages should feel like one site. It is a floor, not a height, so a
     section with more to say than fits simply grows to hold it — Thinking on a
     phone is the one that does.

     `svh`, the small viewport height, and not the `screen` these are written in,
     so on a phone the height is measured against what is actually visible rather
     than against a viewport that includes the browser chrome. And not `dvh`, the
     dynamic one, which looks equivalent and is not: `dvh` re-resolves every time
     the phone's URL bar slides away, so these sections grew by the height of that
     bar part-way through a scroll and pushed the copy the reader was already
     looking at down the page under their thumb. `svh` is fixed for the life of
     the page, so the space here is the space they saw when they arrived.

     Desktop is untouched, above and below — where every viewport unit is the same
     number anyway. */
  @media (max-width: 1023px) {
    #naming-section,
    #perspective-section,
    #thinking-section,
    #philosophy-section {
      min-height: 65svh;
    }
  }
</style>

<script is:inline>
  /* Where the SERVICES item sits in the top nav, so the copy below the hero can
     be hung off it. The nav gaps are fluid, so the offset is measured rather
     than hard-coded. Set at every width and read from 768px up, which means the
     value is already right if the window is dragged across either edge. */
  function sizeNavAlignedCopy() {
    const main = document.querySelector('main');
    const link = document.querySelector('#main-header a[href="/services"]');
    const anchor = document.getElementById('naming-section');
    if (!main || !link || !anchor) return;
    const container = anchor.firstElementChild.getBoundingClientRect();
    const wanted = link.getBoundingClientRect().left - container.left;
    const left = Math.min(Math.max(0, wanted), container.width * 0.55);
    main.style.setProperty('--services-copy-left', `${Math.round(left)}px`);
  }

  if (!window.__dattNavCopy) {
    window.__dattNavCopy = true;
    window.addEventListener('resize', sizeNavAlignedCopy, { passive: true });
    window.addEventListener('load', sizeNavAlignedCopy);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(sizeNavAlignedCopy);
  }
  sizeNavAlignedCopy();
  document.addEventListener('astro:after-swap', sizeNavAlignedCopy);

  (function() {
    function initInfo() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('is-active');
            // Unobserve ensures headlines stay visible on scroll up
            observer.unobserve(e.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px"
      });

      document.querySelectorAll('section, .info-section').forEach(s => observer.observe(s));
    }

    initInfo();
    document.addEventListener('astro:after-swap', initInfo);
  })();
</script>
