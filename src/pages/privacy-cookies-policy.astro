---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import SecureEmail from '../components/SecureEmail.astro';


const { pathname } = Astro.url;
const normalizedPath = pathname.replace(/\/$/, "");
const isActive = (path: string) => normalizedPath === path;


const sidebarLinks = [
  { href: '/privacy-cookies-policy', label: 'Privacy & Cookie Policy' },
  { href: '/terms-of-use', label: 'Terms of Use' },
  { href: '/accessibility', label: 'Accessibility Statement' },
  { href: '/data-processing', label: 'Data Processing Agreement' },
];


const lastUpdated = "16 June 2026";
---


<Layout
  title="Data Processing — DATT STUDIO"
  description="How DATT STUDIO processes personal data — the data processing agreement, sub-processors, security, and your rights."
  isDark={true}
>
  <Header isInverted={true} />


  <style is:global>
    html, body { background-color: #000000 !important; }
  </style>


  <main id="main-content" class="reveal-trigger w-full max-w-[1440px] pt-[120px] px-[var(--page-padding)] pb-32 bg-black text-white">
    <div class="flex flex-col md:flex-row w-full gap-y-16 md:gap-x-24">


      <article class="w-full md:w-[65%] flex flex-col">
        <!-- SPACE BELOW H1: 120px -->
        <div class="mb-[120px]">
            <div class="brands-line-mask">
                <h1 class="brands-line-inner text-white">Data Processing Agreement</h1>
            </div>
        </div>


        <div class="flex flex-col gap-y-32">
            <section id="data-processing" class="flex flex-col">
              <!-- Metadata Space: 48px -->
              <div class="mb-[48px]">
                <div class="brands-line-mask">
                    <p class="brands-line-inner text-label !text-[#727272]">Last Updated — {lastUpdated}</p>
                </div>
              </div>


              <!-- Section Head Space: 64px -->
              <div class="mb-[64px]">
                <div class="brands-line-mask">
                  <h2 class="brands-line-inner text-label !text-white">DPA Terms</h2>
                </div>
              </div>


              <div class="flex flex-col gap-y-12">
                <!-- 1. Scope -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">1. Applicability & Scope</h4>
                    <div class="mt-4">
                      <p>This DPA applies where DATT STUDIO LTD (<strong>“Processor”</strong>) processes Personal Data on behalf of a client (<strong>“Controller”</strong>). This agreement ensures such processing meets the requirements of Article 28 of the UK GDPR for creative and digital services provided by the studio.</p>
                    </div>
                  </div>
                </div>


                <!-- 2. Instructions -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">2. Instructions & Confidentiality</h4>
                    <div class="mt-4">
                      <p>The Processor shall process data only on documented instructions from the Controller. DATT STUDIO LTD ensures that all persons authorised to process the Personal Data have committed themselves to <strong>confidentiality</strong> or are under an appropriate statutory obligation of confidentiality.</p>
                    </div>
                  </div>
                </div>


                <!-- 3. AI Safeguards -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">3. Security & AI Safeguards</h4>
                    <div class="mt-4">
                      <p>DATT STUDIO LTD expressly covenants that it will not subject Controller Personal Data to any form of Machine Learning analysis or Artificial Intelligence training without the Controller’s prior written authorization. We implement appropriate technical and organisational measures to ensure security appropriate to the risk.</p>
                    </div>
                  </div>
                </div>


                <!-- 4. Sub-processors -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">4. Sub-Processors</h4>
                    <div class="mt-4">
                      <p>The Controller provides general authorisation for DATT STUDIO LTD to engage sub-processors (e.g. AWS, Vercel). The Processor shall inform the Controller of any intended changes concerning the addition or replacement of sub-processors, giving the Controller the opportunity to object. We remain fully liable for the data protection performance of any sub-processor engaged.</p>
                    </div>
                  </div>
                </div>


                <!-- 5. Assistance -->
                <div class="brands-line-mask">
                    <div class="brands-line-inner flex flex-col">
                      <h4 class="text-white">5. Assistance & Data Rights</h4>
                      <div class="mt-4">
                        <p>The Processor shall assist the Controller by appropriate technical and organisational measures for the fulfilment of the Controller's obligation to respond to requests for exercising <strong>Data Subject rights</strong> (e.g. access, rectification, erasure) and ensuring compliance with UK GDPR security obligations.</p>
                      </div>
                    </div>
                  </div>


                <!-- 6. Breach -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">6. Breach Notification</h4>
                    <div class="mt-4">
                      <p>In the event of a personal data breach, the Processor shall notify the Controller without undue delay (and no later than 72 hours) after becoming aware of the breach, providing necessary info to allow the Controller to meet its own reporting obligations.</p>
                    </div>
                  </div>
                </div>


                <!-- 7. Deletion -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">7. Deletion & Audit</h4>
                    <div class="mt-4">
                      <p>Upon completion of the services, the Processor shall, at the choice of the Controller, delete or return all personal data. We shall make available all information necessary to demonstrate compliance and allow for/contribute to audits or inspections.</p>
                    </div>
                  </div>
                </div>


                <!-- 8. Inquiries -->
                <div class="brands-line-mask">
                  <div class="brands-line-inner flex flex-col">
                    <h4 class="text-white">8. Inquiries</h4>
                    <div class="mt-4">
                        <p>Legal inquiries regarding data processing should be directed to:
                          <SecureEmail email="hello@dattstudio.com" className="cta-link !lowercase !text-[16px] !tracking-tight" isInverted={true} />.</p>
                    </div>
                  </div>
                </div>
              </div>
            </section>
        </div>
      </article>


      <!-- Sidebar -->
      <aside class="w-full md:w-[35%] lg:sticky lg:top-[132px] h-fit md:pl-20 border-l border-white/5">
        <nav class="flex flex-col items-start gap-y-3">
          {sidebarLinks.map((link, i) => (
            <div class="brands-line-mask">
              <a href={link.href} class:list={['sidebar-link text-label !text-[13px]', { 'active': isActive(link.href) }]} style={`transition-delay: ${0.1 + (i * 0.05)}s`}>{link.label}</a>
            </div>
          ))}
        </nav>
      </aside>
    </div>
  </main>
  <Footer isInverted={true} />
</Layout>


<style is:global>
  #main-content h4 { font-size: var(--font-h4); font-weight: 600; }
  #main-content p { color: #b4b4b4; font-weight: 400; line-height: var(--lh-body); }
  .cta-link:hover { color: #727272 !important; }
  .sidebar-link { color: #727272 !important; text-decoration: none; transition: color 0.4s var(--ease-mechanical); }
  .sidebar-link:hover, .sidebar-link.active { color: #ffffff !important; }
</style>
