---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 - Page Not Found">
  <Header />

  <main class="bg-black text-white px-6 md:px-12 pb-10 flex flex-col min-h-screen selection:bg-white selection:text-black">

    <!-- 1. Clock section (Matches Homepage Spacing) -->
    <div class="mt-10 mb-32 md:mb-40">
      <div class="text-[#7C7C7D] text-[16px] flex gap-2 font-mono font-normal uppercase">
        <span>UK (GMT+1)</span>
        <span id="live-clock">00:00:00</span>
      </div>
    </div>

    <!-- 2. 404 Content Area -->
    <section class="flex flex-col items-start mb-auto">

      <!-- Massive 404 Block -->
      <div class="bg-[#00FF00] text-black px-4 py-1 md:px-6 md:py-2 mb-4 w-fit">
        <h1 class="text-[80px] md:text-[180px] font-semibold leading-[0.9] tracking-tighter uppercase">
          404
        </h1>
      </div>

      <!-- Page Not Found Block -->
      <div class="bg-[#00FF00] text-black px-3 py-1 md:px-4 md:py-2 mb-10 w-fit">
        <h2 class="text-[24px] md:text-[40px] font-semibold leading-none tracking-tight">
          Page not found
        </h2>
      </div>

      <!-- Home Link with Sliding Underline Animation -->
      <a href="/" class="studio-link text-[18px] md:text-[20px] font-semibold">
        Back to home
      </a>
    </section>

    <!-- Footer component handles mobile reverse logic -->
    <Footer />

  </main>
</Layout>

<script is:inline>
  function updateClock() {
    const clockEl = document.getElementById('live-clock');
    if (!clockEl) return;
    const now = new Date();
    clockEl.textContent = now.toLocaleTimeString('en-GB', {
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
    });
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>

<style>
  /* Ensure consistent semibold appearance across high-res displays */
  h1, h2 {
    -webkit-font-smoothing: antialiased;
  }
</style>
